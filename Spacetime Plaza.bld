<Break>

#Connector to Miriam Tower
Cut External, -90 - 1, Floor(0).Base, -350, -89.5 + 1, Floor(2).Altitude + 12, -350 + 30, true, false
Cut landscape, -90 - 40, Floor(0).Base - 1, -350, -90, Floor(0).Base + 1, -350 + 30, false, true

<Floors 0 to 1>
	Set ACTT_ExtraOffset = 0
	if[%floor% = 1] Set ACTT_ExtraOffset = 12
	Set ACTT_ExtraOffset2 = 6

	#Floors
	if[%floor% = 0] Set 5Special = ACTT_Lobby
	if[%floor% = 1] Set 5Special = Shop

	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor ACTT_CTFloor, %5Special%Floor, 0.5, -90 - 40, -350, -90, -350 + 30, %interfloorheight%, %interfloorheight%, 0, 0, true

	#Ceilings
	Set ShowExt = false
	if[%floor% = 1] Set ShowExt = true
	FloorOrientation = bottom
	DrawWalls = true, %ShowExt%, false, false, %ShowExt%, %ShowExt%
	TextureOverride ACTT_LobbyCeiling, ACTT_ExtFacade, ACTT_ExtFacade, ACTT_ExtFacade, ACTT_ExtFacade, ACTT_ExtFacade
	AddFloor ACTT_CTCeiling, ACTT_LobbyCeiling, 2, -90 - 40, -350, -90, -350 + 30, %fullheight% + %ACTT_ExtraOffset%, %fullheight% + %ACTT_ExtraOffset%, 0, 0, true
	
	#Gap fillers in the mall area
	WallOrientation = right
	DrawWalls = false, true, false, false, false, false
	AddWall ACTT_CTFillerFront, ShopWall, 0.5, -90, -350, -90 + 0.5, -350, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true
	WallOrientation = left
	DrawWalls = true, false, false, false, false, false
	AddWall ACTT_CTFillerBack, ShopWall, 0.5, -90, -350 + 30, -90 + 0.5, -350 + 30, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true

	WallOrientation = left
	DrawWalls = true, true, false, false, false, false
	TextureOverride ACTT_LobbyWall, ShopWall, Blank, Blank, Blank, Blank
	if[%floor% = 1] AddWall ACTT_CTFillerMid, ShopWall, 0.5, -90, -350, -90, -350 + 30, %ACTT_ExtraOffset%, %ACTT_ExtraOffset%, %fullheight%, %fullheight%, 0, 0, true
	
	#Windows
	SetAutoSize = true, false
	Set MyIFloorType = 1
	if[%floor% = 0] Set MyIFloorType = 3
	Set WinTile = 1
	if[%floor% = 1] Set WinTile = 2

	AddCustomWindows(ACTT_CTFrontWin, ACTT_MainWindows, ACTT_MainWindowsInt, -90 - 40, -350, -90, -350, %height% + %ACTT_ExtraOffset%, 0, %WinTile%, %MyIFloorType%, ACTT_ExtFacade, ACTT_LobbyWall)
	AddCustomWindows(ACTT_CTBackWin, ACTT_MainWindowsInt, ACTT_MainWindows, -90 - 40, -350 + 30, -90, -350 + 30, %height% + %ACTT_ExtraOffset%, 0, %WinTile%, %MyIFloorType%, ACTT_LobbyWall, ACTT_ExtFacade)

	SetAutoSize = true, true
<EndFloors>

<Floor 1>
	#Set offsets for floors
	Set LL = %interfloorheight%
	Set ML = %interfloorheight% + 3
	Set UL = %interfloorheight% + 6

	#Set heights offsets for walls
	Set WallHeight = 3 + 0.5
	Set Wall_LL = %interfloorheight% - 0.5
	Set Wall_ML = %interfloorheight% - 0.5 + 3
	Set Wall_UL = %interfloorheight% - 0.5 + 6
	
		#Landing for stairs linking the mall and Miriam Tower
