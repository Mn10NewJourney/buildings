			if[%floor% ! 7 & %floor% ! 9] AddStdDoor DoorManager, STP_WFHallway_D2/4, , , false, %DTex%, %DSTex%, 0.2, front, back, 75, 75, %Door_MainX% + 1.5, %Door_MainZ%, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
