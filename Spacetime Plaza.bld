#****************************************#

#West Freight Elevator 1 (B2-8)
#Added on August 3, 2026 (to separate Elevators 14 and 15, and extend the former down to level B2)

	#Service hallway on 1 to 8
		#Wall cuts
		Cut external, -249, Floor(0).Base, -79.5 - 0.1, -90, Floor(10).Altitude, -79.5 + 0.1, true, false #1st-6th floors
	
	<Floors 0 to 9>
		TexPrefix() #Set texture prefixes

		#Hallway to freight elevators
		Set FELobbyWidth = 15
		if[%floor% = 0] Set FELobbyWidth = 30
		
			#Floors
			FloorOrientation = top
			DrawWalls = false, true, false, false, false, false
			if[%floor% ! 7 & %floor% ! 9] CreateFlr(SHallFloor1, SHallFloor, 0.5, -249, -80, -90, -61, 0, true)
			if[%floor% ! 7 & %floor% ! 9] CreateFlr(SHallFloor2A, SHallFloor2, 0.5, -227 - 0.66, -61, -227 + %FELobbyWidth%, -35, 0, true)
			if[%floor% ! 7 & %floor% ! 9] CreateFlr(SHallFloor2B, SHallFloor2, 0.5, -227 - 12, -35, -227 + %FELobbyWidth%, -31, 0, true)

			#Ceilings
			FloorOrientation = bottom
			DrawWalls = true, false, false, false, false, false
			if[%floor% ! 6 & %floor% ! 8] CreateFlr(SHallCeiling1, SHallCeiling, 0.5, -249, -80, -90, -61, %height%, true)
			if[%floor% ! 6 & %floor% ! 8] CreateFlr(SHallCeiling2, SHallCeiling, 0.5, -227, -61, -227 + %FELobbyWidth%, -31, %height%, true)

			#Walls
			if[%floor% < 6] Set WallHeight = %height% #Inner walls
			if[%floor% > 5] Set WallHeight = %height% + Floor(%floor% + 1).FullHeight
			Set WallOffset = %interfloorheight%

			if[%floor% < 7] Set WallHeight2 = %height% #Outer walls
			if[%floor% < 7] Set WallOffset2 = %interfloorheight%
			if[%floor% > 6] Set WallHeight2 = %fullheight% #Outer walls
			if[%floor% > 6] Set WallOffset2 = 0

				#Front walls
				WallOrientation = left
				DrawWalls = false, true, false, false, false, false
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Front, 2, SHallWall_Lower, SHallWall, Blank, 0.5, -249, -80, -90, -80, 4, %WallHeight% - 4, 0, %WallOffset%, true)

				#Back walls
				WallOrientation = left
				DrawWalls = true, false, false, false, false, false
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Back1, 2, SHallWall_Lower, SHallWall, Blank, 0.5, -227 - 22, -61, -227, -61, 4, %WallHeight% - 4, 0, %WallOffset%, true)
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Back2, 2, SHallWall_Lower, SHallWall, Blank, 0.5, -100, -61, -90, -61, 4, %WallHeight% - 4, 0, %WallOffset%, true)

				DrawWalls = true, false, false, false, false, false
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Back3_Inner, 2, SHallWall_Lower, SHallWall, Blank, 0.5, -227 + %FELobbyWidth% - 0.5, -61, -100, -61, 4, %WallHeight% - 4, 0, %WallOffset%, true)
				DrawWalls = false, true, false, false, false, false
				AddWall SHallway_Back3_Outer, %5%Wall, 0.5, -227 + %FELobbyWidth% - 0.5, -61, -100, -61, %WallHeight2%, %WallHeight2%, %WallOffset2%, %WallOffset2%, 0, 0, true

				WallOrientation = right
				DrawWalls = true, false, false, false, false, false
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Back4_Inner, 2, SHallWall_Lower, SHallWall, Blank, 0.5, -227, -31, -227 + %FELobbyWidth%, -31, 4, %WallHeight% - 4, 0, %WallOffset%, true)
				DrawWalls = false, true, false, false, false, false
				AddWall SHallway_Back4_Outer, %5%Wall, 0.5, -227, -31, -227 + %FELobbyWidth%, -31, %WallHeight2%, %WallHeight2%, %WallOffset2%, %WallOffset2%, 0, 0, true

				#Left and right walls
				WallOrientation = left
				DrawWalls = false, true, false, false, false, false
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Left1_Inner, 2, SHallWall_Lower, SHallWall, Blank, 0.5,  -249, -80, -249, -61, 4, %WallHeight% - 4, 0, %WallOffset%, true)
				DrawWalls = true, false, false, false, false, false
				AddWall SHallway_Left1_Outer, %5%Wall, 0.5, -249, -80, -249, -61, %WallHeight2%, %WallHeight2%, %WallOffset2%, %WallOffset2%, 0, 0, true

				WallOrientation = right
				DrawWalls = false, true, false, false, false, false
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Right1, 2, SHallWall_Lower, SHallWall, Blank, 0.5, -227, -61, -227, -31, 4, %WallHeight% - 4, 0, %WallOffset%, true)

				DrawWalls = true, false, false, false, false, false
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Right2_Inner, 2, SHallWall_Lower, SHallWall, Blank, 0.5, -227 + %FELobbyWidth%, -61, -227 + %FELobbyWidth%, -31, 4, %WallHeight% - 4, 0, %WallOffset%, true)
				if[%floor% ! 7 & %floor% ! 9] AddWall_CustomTex(SHallway_Right2_Inner, 2, SHallWall_Lower, SHallWall, Blank, 0.5, -90, -80, -90, -61, 4, %WallHeight% - 4, 0, %WallOffset%, true)

				DrawWalls = false, true, false, false, false, false
				AddWall SHallway_Right2_Outer, %5%Wall, 0.5, -227 + %FELobbyWidth%, -61, -227 + %FELobbyWidth%, -31, %WallHeight2%, %WallHeight2%, %WallOffset2%, %WallOffset2%, 0, 0, true
				AddWall SHallway_Right3_Outer, %5%Wall, 0.5, -90, -80, -90, -61, %WallHeight2%, %WallHeight2%, %WallOffset2%, %WallOffset2%, 0, 0, true

		#Set door textures
			Set DTex = Door8
			if[%floor% > 5] Set DTex = ServiceDoor3
			Set DSTex = %DTex%Side

			#Loading dock access doors (1st floor only)
