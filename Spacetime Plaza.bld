		AddWall ACTT_StairsMid_FRail, ACTT_LobbyRampWall, 0.5, -90 - 40 + 5 + 6, -260 - 80, -90 - 40 + 5 + 6 + 5, -260 - 80, %WallHeight%, %WallHeight%, %Wall_ML%, %Wall_ML%, 0, 0, true
		AddWall ACTT_LowerMid_FRail, ACTT_LobbyRampWall, 0.5, -90 - 40 + 5 + 6 + 5, -260 - 80, -90 - 40 + 5 + 6 + 5 + 6, -260 - 80, %WallHeight%, %WallHeight%, %Wall_ML%, %Wall_LL%, 0, 0, true

