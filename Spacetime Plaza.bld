		AddWall SABackRail-2-%floorid%F, %5%%Suffix%, 0.5, -8.5 + 16 - 4, -140, -8.5 + 16, -140, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
