############################################################

#Floor Assignments
<Floors -1 to -3>
	ID = B(0 - %floor%)
	Name = Basement Level (0 - %floor%)
	Type = Basement
	Height = 10
	InterfloorHeight = 2
	if[%floor% = -1] Altitude = -10
<EndFloors>

<Floors 0 to 5>
	ID = %floor% + 1
	Name = Mall Level %floorid%
	Type = Shopping
	Height = 16
	InterfloorHeight = 2
	if[%floor% = 0] Altitude = 2
<EndFloors>

<Floors 6 to 7>
	if[%floor% = 6] ID = 7
	if[%floor% = 7] ID = 7A
	Name = Mall Level %floorid%
	Type = Shopping
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 8 to 9>
	if[%floor% = 8] ID = 8
	if[%floor% = 9] ID = 8A
	Name = Mall Level %floorid%
	Type = Shopping
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 10 to 11>
	ID = %floor% - 1
	Name = Parking Level %floorid%
	Type = Parking
	Height = 10
	InterfloorHeight = 2
	if[%floor% = 10] Description = Mall roof level
<EndFloors>

<Floor 12>
	ID = %floor% - 1
	Name = Shaft Top
	Type = Roof
	Height = 4
	InterfloorHeight = 2
<EndFloor>

#Merge floors
<Floors -2 to 9>
	Group = -2 - 9
<EndFloors>

