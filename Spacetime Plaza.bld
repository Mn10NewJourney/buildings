<Floors 1 to 2>
	TexPrefix() #Wall textures
	Set RailingHeight = %interfloorheight% + 3.5
	Set RailingOffset = 0
	Set Suffix = Wall

	#South atrium railings (2nd-3rd floors)
	DrawWalls = true, true, true, true, true, false

		WallOrientation = right
		#Front rail
		if[%floor% ! 1] AddWall SAFrontRail-%floorid%F, %5%%Suffix%, 0.5, -30, -300, 30, -300, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
		if[%floor% = 1] AddWall SAFrontRail-%floorid%F, %5%%Suffix%, 0.5, -30, -300, -30 + 10, -300, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
		if[%floor% = 1] AddWall SAFrontRail-%floorid%F, %5%%Suffix%, 0.5, -30 + 10 + 8, -300, 30, -300, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

		#Left rail
		#if[%floor% ! 1] AddWall SALeftRail-%floorid%F, %5%%Suffix%, 0.5, -30, -300 - 0.5, -30, -180 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
		AddWall SALeftRail-%floorid%F_A, %5%%Suffix%, 0.5, -30, -300 - 0.5, -30, -260 - 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
		AddWall SALeftRail-%floorid%F_B, %5%%Suffix%, 0.5, -30, -260 + 15, -30, -180 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

		WallOrientation = left
		#Railings behind escalators (2nd floor)
		if[%floor% = 1] AddWall SALeftRail-BehindEsc, %5%%Suffix%, 0.5, -35, -260 + 15, -30.5, -260 + 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
		if[%floor% = 1] AddWall SARightRail-BehindEsc, %5%%Suffix%, 0.5, 30.5, -260 + 15, 35, -260 + 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

		WallOrientation = left
		#Right rail
		#if[%floor% ! 1] AddWall SARightRail-%floorid%F, %5%%Suffix%, 0.5, 30, -300 - 0.5, 30, -180 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
		AddWall SARightRail-%floorid%F_A, %5%%Suffix%, 0.5, 30, -300 - 0.5, 30, -260 - 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
		AddWall SARightRail-%floorid%F_B, %5%%Suffix%, 0.5, 30, -260 + 15, 30, -180 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

		#Back rail
		AddWall SABackRail-%floorid%F, %5%%Suffix%, 0.5, -30, -180, 30, -180, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	#Extra railings around escalators
	DrawWalls = true, true, true, true, true, false

	WallOrientation = right
	AddWall SALeftRail-EX1, %5%%Suffix%, 0.5, -34.5, -260 - 15, -34.5, -260 + 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 2] AddWall SALeftRail-EX2, %5%%Suffix%, 0.5, -35, -260 - 15, -30.5, -260 - 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = left
	AddWall SARightRail-EX1, %5%%Suffix%, 0.5, 34.5, -260 - 15, 34.5, -260 + 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = right
	if[%floor% = 2] AddWall SARightRail-EX2, %5%%Suffix%, 0.5, 30.5, -260 - 15, 35, -260 - 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
<EndFloor>

