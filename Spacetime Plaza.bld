		AddWall SALeftRail-%floorid%F, %5%%Suffix%, 0.5, -8.5, -140 - 24.14 - 0.5, -8.5, -140 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

