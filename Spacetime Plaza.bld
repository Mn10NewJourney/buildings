			OP_Escalator(MallSouthEsc_%floorid%F_1, up, %floor% + 1, 1.2, EG881Sounds2/Escalators/otisescalator1.wav, Escalator3Z_Unmarked, Escalator3ZB, front, -32.5, -180, 3, 2/3, 1, 27, 0, 0, 0, 0) #EG881
			OP_Escalator(MallSouthEsc_%floorid%F_2, down, %floor% + 1, 1.2, EG881Sounds2/Escalators/otisescalator1.wav, Escalator3Z_Unmarked, Escalator3ZB, front, 32.5, -180, 3, 2/3, 1, 27, 0, 0, 0, 0) #EG881
		<EndFloor>
		
