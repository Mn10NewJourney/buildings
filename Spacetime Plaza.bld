#LANDSCAPES
#Coordinate Set
Set MainX = 822
Set MainZ = 0
Set InSTP = true

#Tranquility City Landscape
<Include buildings/KW_Maps/Tranquility City.txt>

########################################

#Common values
Set 1 = 330 #Building Dimension X (Full width: 660 ft.)
Set 2 = 500 #Building Dimension Z (Full length: 1,000 ft.)

#Cut landscape for building
Cut Landscape, -%1%, -1, -%2%, %1%, 1, %2%, false, true
Cut Landscape, -416, -1, -%2% - 80, -%1%, 0.5, %2%, false, true #West parking area
Cut Landscape, %1%, -1, -%2%, %1% + 150, 0.5, %2%, false, true #East parking area

#Landscape
DrawWalls = false, true, false, false, false, false

	#Filler floors
	AddFloor landscape, FillerFloor1, Sidewalk, 0, -%1%, -%2%, -%1% + 240, %2% - 260 - 320, 4, 4, 0, 0
	AddFloor landscape, FillerFloor2, Sidewalk, 0, -%1% + 240, -%2%, -%1% + 420, -%2% + 260 - 120, 4, 4, 0, 0
	AddFloor landscape, FillerFloor3, Sidewalk, 0, -130, -580, %1% + 15, -%2%, 4, 4, 0, 0

	Set FO = Floor(0).Base #Floor Offset
	#Pathway from Monica Dept. Store's emergency exit stairwell
