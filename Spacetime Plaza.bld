	AddWall Shaft%12%PanelLeft, %GLEPanelTex%, 0, -14.34, 135.66, -14.34, 140, %WallHeight%, %WallHeight%, 0, 0, 1/1, %TileZ%, false
	AddWall Shaft%12%PanelRight, %GLEPanelTex%, 0, 24.34, 135.66, 24.34, 140, %WallHeight%, %WallHeight%, 0, 0, 1/1, %TileZ%, false
<EndFloor>

