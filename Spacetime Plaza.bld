	AddWall EA_LeftRail_2, EAWall2, 0.5, %1% + 12, -50, %1% + 12, -20 + 0.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	AddWall EA_FrontRail_1, EAWall2, 0.5, %1%, -60, %1% + 12, -60, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	AddWall EA_FrontRail_2, EAWall2, 0.5, %1% + 12, -60 - 10, 347, -60 - 10, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	DrawWalls = true, true, true, false, true, true
	AddWall EA_FrontRail_3, EAWall2, 0.5, 351, -60 - 10, %1% + 24, -60 - 10, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

	WallOrientation = left
	DrawWalls = true, true, true, true, true, true
	AddWall EA_BackRail_1, EAWall2, 0.5, %1%, -50, %1% + 12 - 0.5, -50, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	AddWall EA_BackRail_2, EAWall2, 0.5, %1% + 12, -20, 347, -20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	DrawWalls = true, true, true, false, true, true
	AddWall EA_BackRail_3, EAWall2, 0.5, 351, -20, %1% + 24, -20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

    #Doors
	Set Texture = Door88
	Set MainZ = -55.5
	WallOrientation = right
	TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
	AddExternalDoor , , false, %Texture%Int, 0.2, 3, 75, %1%, %MainZ% + 1.5, 3, 7, %interfloorheight%, 0, 0
	TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
	AddExternalDoor , , false, %Texture%Int, 0.2, 2, 75, %1%, %MainZ% - 1.5, 3, 7, %interfloorheight%, 0, 0

	AddFillerWalls %5%Wall, 0.5, %1%, %MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

	Set EntireHeight = 10
	Add3DWindows(4F_EntranceFromEA_WinTop, %1%, %MainZ%, right, 6, %EntireHeight% - 7.5, 7.25, MainWindowsIntB, MainWindowsIntB, %5%Wall, 0.5, 1/4, 1)
	Add3DWindows(4F_EntranceFromEA_WinSide1, %1%, %MainZ% - 3 - 0.75, right, 1, %EntireHeight% - 0.5, 0.25, MainWindowsIntB, MainWindowsIntB, %5%Wall, 0.5, 1/4, 1)
