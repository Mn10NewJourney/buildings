########################################

#Underground parking access roadways
Set DK = Floor(-2).Base #Level B2's floor elevation #Loading dock
Set DK2 = %DK% + 9 #Level B2's (lowered) ceiling elevation

Set LL = Floor(-1).Base #Level B1's floor elevation
Set LL2 = %LL% + 9 #Level B1's (lowered) ceiling elevation

Set SL = 0 #Street level
Set UL = Floor(0).Base #1st floor's floor elevation

	#--------------------#

	#South-Center Entrance/Exit (5th Street to level B1)
	#Removed on 5 June 2026 as it is not necessary (in this simulation) and is not really realistic to have
	#such a long road leading to the underground PG.
	
		#Additionally, having a four-way intersection immediately south of the mall's entrance may cause
		#a great traffic jam near the closing hours (this is something true in certain real cities).
	
	#This area was replaced with a new "underground chamber" containing additional shops on August 5, 2026.

	#As a compensation, there will be a parking garage created south of April Department Store in the future.
	#Let me wait until our computers get more advanced first.

	#--------------------#

	#Northwest Exit (Exit from mall and hotel parking, spanning levels B2 to 1)
		#Cut landscape and external meshes for ramps
		Cut landscape, -416, %UL% - 2, 140, -416 + 24, %UL% + 1, 140 + 120, false, true
		Cut external, -416, Floor(-2).Base + 5, 140, -416 + 24, %UL% + 2, 140 + 120, false, true

		<Floors -2 to -1>
			TexPrefix() #Set texture prefix
		
			#Parking ramp creation
			FloorOrientation = top
			DrawWalls = true, true, false, false, false, false
			TextureOverride ParkingCeiling, Road, Blank, Blank, Blank, Blank
			AddFloor Shop2_ParkingRamp, Road, 1, -416, 140, -416 + 24, 140 + 120, %fullheight% + Floor(%floor% + 1).InterfloorHeight, %interfloorheight%, 0, 0, true

			#Railings next to ramps
