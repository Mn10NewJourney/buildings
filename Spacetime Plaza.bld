			Set Door_MainZ = -70
		
			WallOrientation = left
			if[%floor% ! 7 & %floor% ! 9] AddStdDoor DoorManager, STP_WFHallway_D3/1, , , false, %DTex%, %DSTex%, 0.2, left, left, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
			if[%floor% ! 7 & %floor% ! 9] AddStdDoor DoorManager, STP_WFHallway_D3/2, , , false, %DTex%, %DSTex%, 0.2, right, left, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
			if[%floor% ! 7 & %floor% ! 9] AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

			#East access doors
			Set Door_MainX = -90
			Set Door_MainZ = -70
		
			WallOrientation = right
			if[%floor% < 7] AddStdDoor DoorManager, STP_WFHallway_D4/1, , , false, %DTex%, %DSTex%, 0.2, left, right, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
			if[%floor% < 7] AddStdDoor DoorManager, STP_WFHallway_D4/2, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
			if[%floor% < 7] AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true
	<EndFloors>

	#****************************************#

	<Floors -2 to -1>
		#Freight elevator lobby on B2 and B1
			#Exterior walls
			WallOrientation = left
			DrawWalls = true, true, false, true, false, false
			AddWall WFLobby_EX, ParkingWall, 12, -227, -61, -227 + 10, -61, %height% + 1, %height% + 1, %interfloorheight%, %interfloorheight%, 0, 0, true

			#Interior walls
			WallOrientation = left
			DrawWalls = true, true, true, true, true, false
			TextureOverride WFLobbyWall, WFLobbyWall, WFLobbyWall, WFLobbyWall, WFLobbyCeiling, Blank
			AddWall WFLobby_EX, ParkingWall, -11, -227, -49.5, -227 + 10 - 0.5, -49.5, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true

			#Interior floor - This needs to be created before the shaft itself.
			FloorOrientation = top
			DrawWalls = false, true, false, false, false, false
			CreateFlr(WZ_NorthwestUF, WFLobbyFloor, 0.5, -227 - 12, -61, -227 + 10, -61 + 12, 0, true)

			#DOORS
			Set DTex = ServiceDoor1
			Set DSTex = %DTex%Side

			Set Door_MainX = -222
			Set Door_MainZ = -61
		
			WallOrientation = left
			AddStdDoor DoorManager, STP_WFLobby_D1, , , false, %DTex%, %DSTex%, 0.2, back, front, 75, 75, %Door_MainX% - 1.5, %Door_MainZ%, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
			AddStdDoor DoorManager, STP_WFLobby_D2, , , false, %DTex%, %DSTex%, 0.2, front, front, 75, 75, %Door_MainX% + 1.5, %Door_MainZ%, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
			AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, true, 0, 0, true
	<EndFloors>

	#****************************************#

	#Shaft creation
	AddStdShaft(12, 1, -233, -55, 5.67, 5.67, -3, 10, ShaftIntWall2, 0.5, 0.33, 0, 2 + 5, %interfloorheight%)
	ShowFullShaft 12 = true

	<Floor 10>
		#Machine room doors

		#Shaft 12
		Set DTex = ServiceDoor1
		Set DSTex = %DTex%Side
		Set Door_MainX = -233 + 6
		Set Door_MainZ = -55
	
		WallOrientation = right
		AddStdDoor DoorManager, %floorid%_Shaft12MR_D1, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddStdDoor DoorManager, %floorid%_Shaft12MR_D2, , , false, %DTex%, %DSTex%, 0.2, left, right, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddFillerWalls ConnectionWall, 0.66 + 0.01, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true
	<EndFloor>

	<Floors -1 to 10>
		#Storage between Shafts 5 and 12
			#WALLS
			Set Suffix = 2
			if[%floor% = -1] Set Suffix = 3
			WallOrientation = left
			DrawWalls = true, true, true, true, true, false
			TextureOverride SHallWall%Suffix%, SHallWall%Suffix%, SHallWall%Suffix%, SHallWall%Suffix%, SLDropCeiling, Blank
			if[%floor% ! 7 & %floor% ! 9] AddWall StorageNexttoFEs, SHallWall2, -11, -227.5, -34.5, -227.5, -31.5, 8.5, 8.5, %interfloorheight%, %interfloorheight%, 0, 0, true
	
			#DOORS
			Set DTex = Door1
			if[%floor% > -1] Set DTex = ServiceDoor2
			if[%floor% = 10] Set DTex = ServiceDoor3
			Set DSTex = %DTex%Side

			Set Door_MainX = -227
			Set Door_MainZ = -33
		
			WallOrientation = right
			if[%floor% ! 7 & %floor% ! 9] AddStdDoor DoorManager, STP_WestStorage_%floorid%F, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ%, 2.75, 7, Floor(%floor%).Base, 0, 0, 0, 0
			if[%floor% ! 7 & %floor% ! 9] AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 2.75, 7, %interfloorheight%, false, 0, 0, true
	<EndFloors>
	
	<Floor -2>
		#Utility room south of Stairwell 6
			#WALLS
			WallOrientation = left
			DrawWalls = true, true, false, false, false, false
			AddWall B2F_WestCenterUtility_Left, ParkingWall, 0.5, -125, -80, -125, -60.5, %height% + 1, %height% + 1, %interfloorheight%, %interfloorheight%, 0, 0, true
			WallOrientation = right
			AddWall B2F_WestCenterUtility_Back, ParkingWall, 0.5, -125, -60.5, -100, -60.5, %height% + 1, %height% + 1, %interfloorheight%, %interfloorheight%, 0, 0, true
	
			#DOORS
			Set DTex = ServiceDoor3
			Set DSTex = %DTex%Side

			Set Door_MainX = -125 + 0.5
			Set Door_MainZ = -70

			WallOrientation = right
			AddStdDoor DoorManager, B2F_WCU_D1, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
			AddStdDoor DoorManager, B2F_WCU_D2, , , false, %DTex%, %DSTex%, 0.2, left, right, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
			AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true
	<EndFloor>

