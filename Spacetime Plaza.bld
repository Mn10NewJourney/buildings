#South Zone East Stairwell A
	#Wall cuts for stairwell walls
	<Floor -1>
		CutAll 89.5 - 0.1, 0, -284 - 14.5, 89.5 + 0.1, %fullheight%, -284 + 14.5, true, true #Left wall cuts
	<EndFloor>

	<Floor 3>
		CutAll 89.5 - 0.1, 0, -284 - 14.5, 89.5 + 0.1, %fullheight%, -284 + 14.5, true, false #Left wall cuts
	<EndFloor>

CreateStairwell 3, 85, -284, -1, 4
CutStairwell 3, -4.5, -14.5, 4.5, 14.5, 0, 5
ShowFullStairs 3 = always

<Floors -1 to 4>
	StairwellSets() #Determine stairs' size

	Set 21 = 85 #Center X
	Set 22 = -284 #Center Z
	Set 23 = 4.5 #Cut X
	Set 24 = 14.5 #Cut Z
	Set 25 = 3 #Stairwell Number
	Set 26 = 0.5 #Riser Size

	#Walls
