	LSFloorCreator(ACTT_WestEnt2, Sidewalk, -%1% - 20, -260 - 120, -%1%, -260 - 100, %FO%, false, false)
	LSFloorCreator(ACTT_WestEnt3, Sidewalk, -%1% - 20, -%2%, -%1%, -%2% + 20, %FO%, false, false)

