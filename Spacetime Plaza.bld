<Function EA1Railings>
	TexPrefix() #Wall textures
	Set RailingHeight = %interfloorheight% + 3.5
	Set RailingOffset = 0

	Set Suffix = Wall2

	#East atrium 1 (South) railings
	WallOrientation = right
	DrawWalls = true, true, true, true, true, false
	if[%floor% = 8] AddWall EA1FrontRail, %5%%Suffix%, 0.5, 180, -180 - 0.5, 240, -180 - 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% ! 8] AddWall EA1FrontRailA, %5%%Suffix%, 0.5, 180, -180 - 0.5, 210 - 15, -180 - 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% ! 8] AddWall EA1FrontRailB, %5%%Suffix%, 0.5, 210 + 15, -180 - 0.5, 240, -180 - 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% ! 8] AddWall EA1FrontRail_Mid, %5%%Suffix%, 0.5, 210 - 15, -180 - 0.5 - 8.5, 210 + 15, -180 - 0.5 - 8.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	if[%floor% = 6] AddWall EA1FrontRail_Left, %5%%Suffix%, 0.5, 210 - 15, -189 - 0.5, 210 - 15, -184.5 - 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = left
	if[%floor% = 6] AddWall EA1FrontRail_Right, %5%%Suffix%, 0.5, 210 + 15, -184.5 - 0.5, 210 + 15, -180.5 - 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	WallOrientation = right
	if[%floor% ! 6] AddWall EA1LeftRail, %5%%Suffix%, 0.5, 180, -180 - 0.5 - 0.5, 180, -60 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 6] AddWall EA1LeftRail_NearTop1, %5%%Suffix%, 0.5, 180, -180 - 0.5 - 0.5, 180, -120 - 4, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 6] AddWall EA1LeftRail_NearTop2, %5%%Suffix%, 0.5, 180, -120 + 4, 180, -60 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = left
	if[%floor% ! 8] AddWall EA1RightRail, %5%%Suffix%, 0.5, 240, -180 - 0.5 - 0.5, 240, -60 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 8] AddWall EA1RightRail, %5%%Suffix%, 0.5, 240, -180 - 0.5 - 0.5, 240, -120 - 4, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 8] AddWall EA1RightRail, %5%%Suffix%, 0.5, 240, -120 + 4, 240, -60 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	AddWall EA1BackRail, %5%%Suffix%, 0.5, 180, -60, 240, -60, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	#New railings to the 7F-8F escalators
	WallOrientation = left
	if[%floor% = 6] AddWall EA1LeftRail_7FEscLink_Front, %5%%Suffix%, 0.5, 180, -120 - 4.5, 234.14 - 36, -120 - 4.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = right
	if[%floor% = 6] AddWall EA1LeftRail_7FEscLink_Back, %5%%Suffix%, 0.5, 180, -120 + 4.5, 234.14 - 36, -120 + 4.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	WallOrientation = left
	if[%floor% = 8] AddWall EA1LeftRail_8FEscLink_Front, %5%%Suffix%, 0.5, 234.14, -120 - 4.5, 240, -120 - 4.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = right
	if[%floor% = 8] AddWall EA1LeftRail_8FEscLink_Back, %5%%Suffix%, 0.5, 234.14, -120 + 4.5, 240, -120 + 4.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
<EndFunction>

<Function EA3Railings>
	TexPrefix() #Wall textures
	Set RailingHeight = %interfloorheight% + 3.5
	Set RailingOffset = 0

	Set Suffix = Wall2

		#Sets to determine odd/even floors
		Set Mod_Temp = mod(%floor%, 2)
		Set Mod = abs(%Mod_Temp%)

	#East atrium 3 (North) railings
	WallOrientation = right
	DrawWalls = true, true, true, true, true, false
	if[%Mod% = 1 | %floor% = 8] AddWall EA3FrontRail, %5%%Suffix%, 0.5, 190, 210, 230, 210, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%Mod% = 0 & %floor% ! 8] AddWall EA3FrontRailA, %5%%Suffix%, 0.5, 190, 210, 202, 210, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%Mod% = 0 & %floor% ! 8] AddWall EA3FrontRailB, %5%%Suffix%, 0.5, 218, 210, 230, 210, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	AddWall EA3LeftRail, %5%%Suffix%, 0.5, 190, 210 - 0.5, 190, 240 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	WallOrientation = left
	AddWall EA3RightRail, %5%%Suffix%, 0.5, 230, 210 - 0.5, 230, 240 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = left
	if[%Mod% = 0 & %floor% ! 8] AddWall EA3BackRail, %5%%Suffix%, 0.5, 190, 240, 230, 240, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%Mod% = 1] AddWall EA3BackRailA, %5%%Suffix%, 0.5, 190, 240, 202, 240, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%Mod% = 1] AddWall EA3BackRailB, %5%%Suffix%, 0.5, 218, 240, 230, 240, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 8] AddWall EA3BackRailA, %5%%Suffix%, 0.5, 190, 240, 206, 240, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 8] AddWall EA3BackRailB, %5%%Suffix%, 0.5, 214, 240, 230, 240, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
<EndFunction>

<Floors 1 to 8>
	if[%floor% ! 7] EA1Railings()
	if[%floor% ! 7] EA3Railings()
<EndFloors>

####################

<Break>

#New floor connecting to the 7F-8F escalators
<Floor 6>
	FloorOrientation = top
	DrawWalls = true, true, false, false, false, false
	TextureOverride ShopCeiling, UpperShopFloor, Blank, Blank, Blank, Blank
	AddFloor 7FEscLink, UpperShopFloor, %interfloorheight%, 180, -120 - 4.5, 234.14 - 36, -120 + 4.5, %interfloorheight%, %interfloorheight%, 0, 0, true
<EndFloor>

<Floor 8>
	FloorOrientation = top
	DrawWalls = true, true, false, false, false, false
	TextureOverride UpperShopCeiling, UpperShopFloor, Blank, Blank, Blank, Blank
	AddFloor 8FEscLink, UpperShopFloor, %interfloorheight%, 234.14, -120 - 4.5, 240, -120 + 4.5, %interfloorheight%, %interfloorheight%, 0, 0, true
<EndFloor>

<Break>

