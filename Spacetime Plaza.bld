	AddWall CALeftRailB, %5%%Suffix%, 0.5, -90 + 40 - 0.5, 100 + 15, -90 + 40 - 0.5, 140 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	AddWall CALeftRail_Esc, %5%%Suffix%, 0.5, -90 + 40 - 4.5 - 0.5, 100 - 15, -90 + 40 - 4.5 - 0.5, 100 + 15, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
