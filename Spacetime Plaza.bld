<Floors -3 to -1>
	#Miriam Tower parking spaces
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	Set Offset = %interfloorheight% + 0.01

	Set ACTT_CX = -230
	Set ACTT_CZ = -260

		#South Parking Spaces
		AddFloor --ACTT_PS_S32, ParkingSpaceX, 0, %ACTT_CX% - 141, %ACTT_CZ% - 120 - (8.5 * 2), %ACTT_CX% - 141 + 18, %ACTT_CZ% - 120 + (8.5 * 2), %Offset%, %Offset%, 1, 4, true
		AddFloor --ACTT_PS_S33, ParkingSpaceX, 0, %ACTT_CX% - 141, %ACTT_CZ% - 160 - (8.5 * 2), %ACTT_CX% - 141 + 18, %ACTT_CZ% - 160 + (8.5 * 2), %Offset%, %Offset%, 1, 4, true
		AddFloor --ACTT_PS_S34, ParkingSpaceX, 0, %ACTT_CX% - 141, %ACTT_CZ% - 200 - (8.5 * 2), %ACTT_CX% - 141 + 18, %ACTT_CZ% - 200 + (8.5 * 2), %Offset%, %Offset%, 1, 4, true
		AddFloor --ACTT_PS_S35, ParkingSpaceX, 0, %ACTT_CX% - 141, %ACTT_CZ% - 240 - (8.5 * 2), %ACTT_CX% - 141 + 18, %ACTT_CZ% - 240 + (8.5 * 2), %Offset%, %Offset%, 1, 4, true
		AddFloor --ACTT_PS_S36, ParkingSpaceX, 0, %ACTT_CX% - 141, %ACTT_CZ% - 261 - (8.5 * 1), %ACTT_CX% - 141 + 18, %ACTT_CZ% - 261, %Offset%, %Offset%, 1, 1, true

		AddFloor --ACTT_PS_S41, ParkingSpaceZ, 0, %ACTT_CX% - 120 - (8.5 * 2), %ACTT_CZ% - 299 - 17, %ACTT_CX% - 120 + (8.5 * 2), %ACTT_CZ% - 299, %Offset%, %Offset%, 4, -1, true
		AddFloor --ACTT_PS_S42, ParkingSpaceZ, 0, %ACTT_CX% - 160 - (8.5 * 2), %ACTT_CZ% - 299 - 17, %ACTT_CX% - 160 + (8.5 * 2), %ACTT_CZ% - 299, %Offset%, %Offset%, 4, -1, true

		#West Parking Spaces
		AddFloor --ACTT_PS_W1, ParkingSpaceX, 0, -369 - 18, -300 - (8.5 * 2), -369, -300 + (8.5 * 2), %Offset%, %Offset%, -1, 4, true
		AddFloor --ACTT_PS_W2, ParkingSpaceX, 0, -369 - 18, -260 - (8.5 * 2), -369, -260 + (8.5 * 2), %Offset%, %Offset%, -1, 4, true
		AddFloor --ACTT_PS_W3, ParkingSpaceX, 0, -369 - 18, -220 - (8.5 * 2), -369, -220 + (8.5 * 2), %Offset%, %Offset%, -1, 4, true

		#Northwest parking spaces (Level B3 only)
		if[%floor% = -3] AddFloor --ACTT_PS_NW1, ParkingSpaceZ, 0, -350 - (8.5 * 2), -161 - 1.25, -350 + (8.5 * 2), -161 - 1.25 + 18, %Offset%, %Offset%, 4, 1, true
		if[%floor% = -3] AddFloor --ACTT_PS_NW2, ParkingSpaceZ, 0, -390 - (8.5 * 2), -161 - 1.25, -390 + (8.5 * 2), -161 - 1.25 + 18, %Offset%, %Offset%, 4, 1, true

		#North parking spaces (Levels B2-B1 only)
		if[%floor% ! -3] AddFloor Miriam_PS_N9, ParkingSpaceZ, 0, %ACTT_CX% + 40 - (8.5 * 2), -119 - 18, %ACTT_CX% + 40 + (8.5 * 2), -119, %Offset%, %Offset%, 4, -1, true
