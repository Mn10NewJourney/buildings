##--------------------------------------------------------------------------------##

#Set texture prefixes/suffixes
<Function TexPrefix>
	#Main prefixes
	Set 5 = Shop
	if[%floor% < 0] Set 5 = Parking
	if[%floor% > 5] Set 5 = UpperShop

	#Parking lobby suffixes (For mall elevators serving the basements)
	Set 5L = Wall
	if[%floor% < 0] Set 5L = LobbyWall

	Set LobbyPrefix = LowerParkingLobby
	if[%floor% > 5] Set LobbyPrefix = UpperParkingLobby

	#Parking lobby prefixes (East Zone only)
	Set 5East = 
	if[%floor% < 0] Set 5East = East

	###************###

	#Set heights for External Shaft/Stairwell walls
	Set SHeight = %fullheight%
	Set SOffset = 0
	if[%floor% = 0] Set SHeight = %height%
	if[%floor% = 0] Set SOffset = %interfloorheight%
	if[%floor% < 0] Set SHeight = %height% + Floor(%floor% + 1).InterfloorHeight - 0.5
	if[%floor% < 0] Set SOffset = %interfloorheight%
<EndFunction>

##--------------------------------------------------------------------------------##

#EXTERIOR & INTERIOR
#Parking level B3 (Miriam Tower only)
<Floor -3>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	Set ShowBottom = false

	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor OfficeZonePKFloor, Road, 0.5, -416, -%2% - 80, -%1%, -160, %interfloorheight%, %interfloorheight%, 0, 0, true

		#Extra floorings
		CreateFlr(ACTT_UnderRampFloor, ParkingFloor, 0.5, -416, -320, -392, -320 + 120, 0, true)

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	AddFloor OfficeZonePKCeiling, %5%Ceiling, 0.5, -416, -%2% - 80, -%1%, -160, %fullheight% + 1, %fullheight% + 1, 0, 0, true

	#Perimeter walls
	TexPrefix() #Set texture prefix/suffix
	Set WallHeight = %height% + Floor(-2).InterfloorHeight
	Set WallOffset = %interfloorheight%

		DrawWalls = false, true, false, false, false, false
		WallOrientation = left
		AddWall OfficeZoneFrontWall, %5%Wall, 0.5, -416, -%2% - 80, -%1%, -%2% - 80, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall OfficeZoneLeftWall, %5%Wall, 0.5, -416, -%2% - 80, -416, -160, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		#WallOrientation = right
		#DrawWalls = true, false, false, false, false, false
		#AddWall OfficeZoneBackWall, %5%Wall, 0.5, -416, -160, -%1%, -160, %WallHeight% + 1, %WallHeight% + 1, %WallOffset%, %WallOffset%, 0, 0, true

	#Extra chamber north of Miriam Tower (Negative Thickness)
	WallOrientation = right
	DrawWalls = true, false, true, true, false, true
	TextureOverride %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Ceiling, Road
	AddWall B3F_ExtraChamber, %5%Wall, -19.5, -416 + 0.5, -260 + 100, -230 + 100 - 0.5, -260 + 100, %height% + 1, %height% + 1, %interfloorheight%, %interfloorheight%, 0, 0, true
<EndFloor>

#Parking levels B2-B1
	#Level B2: Separated between west (office/hotel) and east (shopping) sides
	#Level B1: Nearly entire floor is linked together

<Floors -2 to -1>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	Set ShowBottom = false
	if[%floor% = 0] Set ShowBottom = true

