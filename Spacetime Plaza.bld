		TextureOverride ACTT_LobbyRamp_UDS, ACTT_LobbyFloor2, Blank, Blank, Blank, Blank
		AddFloor ACTT_LobbyRampMid, ACTT_LobbyFloor2, 0.5, -90 - 35.5 + 36, -359.5, -90 - 35.5 + 36 + 8, -350 + 8, %ML%, %ML%, false, false, 0, 0, true
		TextureOverride ACTT_LobbyRamp_UDS, ACTT_LobbyFloor2, Blank, Blank, Blank, Blank
		AddFloor ACTT_LobbyRamp2, ACTT_LobbyFloor2, 0.5, -90 - 35.5 + 36 + 8, -359.5, -90 - 35.5 + 36 + 8 + 36, -359.5 + 8, %ML%, %LL%, true, false, 0, 0, true

		#Railings around ramps
		WallOrientation = right
		DrawWalls = true, true, true, true, true, false
		#AddWall ACTT_LRTop_Rail, ACTT_LobbyRampWall, 0.5, -90 - 40, -350 + 8, -90 - 35.5, -350 + 8, %WallHeight%, %WallHeight%, %Wall_UL%, %Wall_UL%, 0, 0, true
		AddWall ACTT_LR1_Rail, ACTT_LobbyRampWall, 0.5, -90 - 35.5, -350 + 8, -90 - 35.5 + 36, -350 + 8, %WallHeight%, %WallHeight%, %Wall_UL%, %Wall_ML%, 0, 0, true
		AddWall ACTT_LRMid_Rail_A, ACTT_LobbyRampWall, 0.5, -90 - 35.5 + 36, -350 + 8, -90 - 35.5 + 36 + 8, -350 + 8, %WallHeight%, %WallHeight%, %Wall_ML%, %Wall_ML%, 0, 0, true
		AddWall ACTT_LRMid_Rail_B, ACTT_LobbyRampWall, 0.5, -90 - 35.5 + 36 + 8, -359.5 + 8 - 0.5, -90 - 35.5 + 36 + 8, -350 + 8 - 0.5, %WallHeight%, %WallHeight%, %Wall_ML%, %Wall_ML%, 0, 0, true
		AddWall ACTT_LR2_Rail, ACTT_LobbyRampWall, 0.5, -90 - 35.5 + 36 + 8, -359.5 + 8, -90 - 35.5 + 36 + 8 + 36, -359.5 + 8, %WallHeight%, %WallHeight%, %Wall_ML%, %Wall_LL%, 0, 0, true

		#Railings around stairs
