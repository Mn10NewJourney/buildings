	LSFloorCreator(LMH_WestEnt1, Sidewalk, -%1% - 20, 370 - 100, -%1%, 370 - 80, %FO%, false, false)
	LSFloorCreator(LMH_WestEnt2, Sidewalk, -%1% - 20, 370 - 20, -%1%, 370, %FO%, false, false)

