	if[%floor% = -2] AddBoxSign(UpToB1_Extra2, NoEntry_Short2, UpToB1_Alt, OverheadSign_Black, 0.1, true, true, true, 170 + 8 - 5 + %ShiftXBy%, 20, 10, 2, %SignOffset%, true)
