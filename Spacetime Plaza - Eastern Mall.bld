#Eastern Annex
<Function EAFloorCreator>
	FloorOrientation = top
	DrawWalls = true, true, false, false, false, false
	TextureOverride %param1%, %param2%, Blank, Blank, Blank, Blank
	AddFloor EAFloor_%floorid%F_%param3%, EAFloor2, %interfloorheight%, %param4%, %param5%, %param6%, %param7%, %interfloorheight%, %interfloorheight%, 0, 0, true
<EndFunction>

<Floor 1>
	#Escalator underside cover
	FloorOrientation = top
	DrawWalls = true, false, true, true, true, true
	AddFloor EUSCover, EscUndersideCover, 2, 347 - 0.1 + %ShiftXBy%, -105.5 - 0.1, 351 + 0.1 + %ShiftXBy%, -94.14, %fullheight%, %fullheight%, 0, 0, true
<EndFloor>

<Floors 2 to 5>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	FloorOrientation = top
	DrawWalls = true, true, false, true, true, true
	TextureOverride EAExtFacade, EAFloor, EAExtFacade, EAExtFacade, EAExtFacade, EAExtFacade
	if[%floor% = 2] AddFloor EABase, EAFloor, 2, %1% + %ShiftXBy%, -%2% + 260, %1% + 24 + %ShiftXBy%, %2% - 220, %interfloorheight%, %interfloorheight%, 0, 0, true

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, true, false, true, true, true
	TextureOverride EACeiling, EAExtFacade, EAExtFacade, EAExtFacade, EAExtFacade, EAExtFacade
	if[%floor% = 5] AddFloor EATop, EACeiling, 2, %1% + %ShiftXBy%, -%2% + 260, %1% + 24 + %ShiftXBy%, %2% - 220, %fullheight%, %fullheight%, 0, 0, true

	#Windows
	Set MyIFloorType = 2
	if[%floor% = 2] Set MyIFloorType = 3
	Set WinHeight = %height%

	SetAutoSize = true, false

		AddCustomWindows(EA_RightWin, EAWindowsInt, EAWindows, %1% + 24 + %ShiftXBy%, -%2% + 260, %1% + 24 + %ShiftXBy%, %2% - 220, %WinHeight%, 0, 0, %MyIFloorType%, %5%Wall, ExtFacade)
		AddCustomWindows(EA_BackWin, EAWindowsIntB, EAWindowsB, %1% + %ShiftXBy%, %2% - 220, %1% + 24 + %ShiftXBy%, %2% - 220, %WinHeight%, 3/4, 0, %MyIFloorType%, %5%Wall, ExtFacade)

	SetAutoSize = true, true
<EndFloors>

#3rd floor extra doors (Added on September 21, 2026)
<Floor 2>
	#Doors
	Set Texture = Door88
	Set MainZ = 280 - 7.5
	WallOrientation = right
	TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
