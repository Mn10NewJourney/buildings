<Break>

<Function MainPlazaSupport>
	Set Prefix = %param1%
	Set SupportX = %param2% #Rightmost column
	Set SupportZ = %param3%
	Set Texture = %param4%
	
	if[%floor% < 0] CreateWallBox2 external, Support%Prefix%1A, %Texture%, %SupportX% + (%DistanceX% * 1), %SupportZ% + 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% < 0] CreateWallBox2 external, Support%Prefix%1, %Texture%, %SupportX%, %SupportZ% + 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% < 0] CreateWallBox2 external, Support%Prefix%2, %Texture%, %SupportX% - (%DistanceX% * 1), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% < 0] CreateWallBox2 external, Support%Prefix%3, %Texture%, %SupportX% - (%DistanceX% * 2), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 external, Support%Prefix%4, %Texture%, %SupportX% - (%DistanceX% * 3), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 external, Support%Prefix%5, %Texture%, %SupportX% - (%DistanceX% * 4), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 external, Support%Prefix%6, %Texture%, %SupportX% - (%DistanceX% * 5), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 external, Support%Prefix%7, %Texture%, %SupportX% - (%DistanceX% * 6), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 external, Support%Prefix%8, %Texture%, %SupportX% - (%DistanceX% * 7), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 external, Support%Prefix%9, %Texture%, %SupportX% - (%DistanceX% * 8), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	#CreateWallBox2 external, Support%Prefix%10, ColumnTex, %SupportX% - (%DistanceX% * 9), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	#CreateWallBox2 external, Support%Prefix%11, ColumnTex, %SupportX% - (%DistanceX% * 10), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	#if[%Prefix% ! N & %Prefix% ! K] CreateWallBox2 external, Support%Prefix%12, ColumnTex, %SupportX% - (%DistanceX% * 11), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	#if[%Prefix% ! N] CreateWallBox2 external, Support%Prefix%13, ColumnTex, %SupportX% - (%DistanceX% * 12), %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	#if[%Prefix% ! N] CreateWallBox2 external, Support%Prefix%14, ColumnTex, %SupportX% - (%DistanceX% * 13) + 1.25, %SupportZ%, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
<EndFunction>

########################################

#SUPPORTS

<Floors -2 to -1>
	#Set Values
	TexPrefix() #Set texture prefixes
	Set DistanceX = 40 #Distance between supports X
	Set DistanceZ = 40 #Distance between supports Z

	Set SupportHeight = %fullheight%
	if[%floor% = -1] Set SupportHeight = %fullheight% + Floor(0).InterfloorHeight
	Set SupportOffset = -%interfloorheight%
	
	#East and Center Areas
	MainPlazaSupport(A, %1% + 100 + %ShiftXBy%, -220, ColumnTex)
	MainPlazaSupport(B, %1% + 100 + %ShiftXBy%, -220 + 40, ColumnTex)
	MainPlazaSupport(C, %1% + 100 + %ShiftXBy%, -220 + 80, ColumnTex)
	MainPlazaSupport(D, %1% + 100 + %ShiftXBy%, -220 + 120, ColumnTex)
	MainPlazaSupport(E, %1% + 100 + %ShiftXBy%, -220 + 160, ColumnTex)
	MainPlazaSupport(F, %1% + 100 + %ShiftXBy%, -220 + 200, ColumnTex)
	MainPlazaSupport(G, %1% + 100 + %ShiftXBy%, -220 + 240, ColumnTex)
	MainPlazaSupport(H, %1% + 100 + %ShiftXBy%, -220 + 280, ColumnTex)
	MainPlazaSupport(J, %1% + 100 + %ShiftXBy%, -220 + 320, ColumnTex)
	MainPlazaSupport(K, %1% + 100 + %ShiftXBy%, -220 + 360, ColumnTex)
	MainPlazaSupport(L, %1% + 100 + %ShiftXBy%, -220 + 400, ColumnTex)
	MainPlazaSupport(M, %1% + 100 + %ShiftXBy%, -220 + 440, ColumnTex)
	MainPlazaSupport(N, %1% + 100 + %ShiftXBy%, -220 + 480, ColumnTex)
<EndFloors>

<Floors 0 to 9>
	#Set Values
	TexPrefix() #Set texture prefixes
	Set DistanceX = 40 #Distance between supports X
	Set DistanceZ = 40 #Distance between supports Z

	Set SupportHeight = %fullheight%
	if[%floor% = 9] Set SupportHeight = %fullheight% + Floor(10).InterfloorHeight
	Set SupportOffset = -%interfloorheight%
	if[%floor% = 0] Set SupportHeight = %height%
	if[%floor% = 0] Set SupportOffset = 0

	#East and Center Areas
	MainPlazaSupport(A, %1% + 100 + %ShiftXBy%, -220, %5%Wall)
	MainPlazaSupport(B, %1% + 100 + %ShiftXBy%, -220 + 40, %5%Wall)
	MainPlazaSupport(C, %1% + 100 + %ShiftXBy%, -220 + 80, %5%Wall)
	MainPlazaSupport(D, %1% + 100 + %ShiftXBy%, -220 + 120, %5%Wall)
	MainPlazaSupport(E, %1% + 100 + %ShiftXBy%, -220 + 160, %5%Wall)
	MainPlazaSupport(F, %1% + 100 + %ShiftXBy%, -220 + 200, %5%Wall)
	MainPlazaSupport(G, %1% + 100 + %ShiftXBy%, -220 + 240, %5%Wall)
	MainPlazaSupport(H, %1% + 100 + %ShiftXBy%, -220 + 280, %5%Wall)
	MainPlazaSupport(J, %1% + 100 + %ShiftXBy%, -220 + 320, %5%Wall)
	MainPlazaSupport(K, %1% + 100 + %ShiftXBy%, -220 + 360, %5%Wall)
	MainPlazaSupport(L, %1% + 100 + %ShiftXBy%, -220 + 400, %5%Wall)
	MainPlazaSupport(M, %1% + 100 + %ShiftXBy%, -220 + 440, %5%Wall)
	MainPlazaSupport(N, %1% + 100 + %ShiftXBy%, -220 + 480, %5%Wall)
<EndFloors>

<Break>

