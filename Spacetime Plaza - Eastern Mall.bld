############################################################

#Floor Assignments
<Floors -1 to -2>
	ID = B(0 - %floor%)
	Name = Basement Level (0 - %floor%)
	Type = Basement
	Height = 10
	InterfloorHeight = 2
	if[%floor% = -1] Altitude = -10
<EndFloors>

<Floor -3>
	ID = PIT #SS Showcase
	Name = Elevator Pits
	Type = Basement
	Height = 10
	InterfloorHeight = 2
<EndFloor>

<Floors 0 to 5>
	ID = %floor% + 1
	Name = East Mall Level %floorid%
	Type = Shopping
	Height = 16
	InterfloorHeight = 2
	if[%floor% = 0] Altitude = 2
<EndFloors>

<Floors 6 to 7>
	if[%floor% = 6] ID = 7
	if[%floor% = 7] ID = 7A
	Name = East Mall Level %floorid%
	Type = Shopping
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 8 to 9>
	if[%floor% = 8] ID = 8
	if[%floor% = 9] ID = 8A
	Name = East Mall Level %floorid%
	Type = Shopping
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floor 10>
	ID = %floor% - 1
	Name = Level %floorid%
	Type = Roof
	Height = 10
	InterfloorHeight = 2
<EndFloor>

#Merge floors
<Floors -2 to 9>
	Group = -2 - 9
<EndFloors>

##--------------------------------------------------------------------------------##

#LANDSCAPES

#Common values
Set 1 = 330 #Building Dimension X (Full width: 660 ft.)
Set 2 = 500 #Building Dimension Z (Full length: 1,000 ft.)

#Cut landscape for building
#Cut Landscape, -%1%, -1, -%2%, %1%, 1, %2%, false, true
#Cut Landscape, -416, -1, -%2% - 80, -%1%, 0.5, %2%, false, true #West parking area
#Cut Landscape, %1% + %ShiftXBy%, -1, -%2% + 260, %1% + 150 + %ShiftXBy%, 0.5, %2% - 220, false, true #East parking area
Cut Landscape, 120, -1, -%2% + 260, 270, 0.5, %2% - 220, false, true #East parking area

#Landscape
DrawWalls = false, true, false, false, false, false
Set FO = Floor(0).Base #Floor Offset
Set LL = 0 #Tranquility City street level
