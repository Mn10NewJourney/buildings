		if[%floor% = -1] CreateFlr(Mall_AboveRampFloor, ParkingFloor, 0.5, 290 + %ShiftXBy%, 140, 313 + %ShiftXBy%, 179, 0, true)

		if[%floor% = -2] CreateFlr(EZ_WestUtilityFloor1, ParkingFloor, 0.5, 90 + %ShiftXBy%, -%2% + 260, 111 + %ShiftXBy%, %2% - 220, 0, true)
		if[%floor% = -1] CreateFlr(EZ_WestUtilityFloor1, ParkingFloor, 0.5, 90 + %ShiftXBy%, -%2% + 260, 111 + %ShiftXBy%, -59, 0, true)
		CreateFlr(EZ_WestUtilityFloor1A, ParkingFloor, 0.5, 111 + %ShiftXBy%, -%2% + 260, 130 + %ShiftXBy%, -180, 0, true)
		CreateFlr(EZ_WestUtilityFloor2, ParkingFloor, 0.5, 111 + %ShiftXBy%, -180, 133 + %ShiftXBy%, -61, 0, true)
		if[%floor% = -2] CreateFlr(EZ_WestUtilityFloor3, ParkingFloor, 0.5, 111 + %ShiftXBy%, -21, 133 + %ShiftXBy%, 221, 0, true)
		if[%floor% = -1] CreateFlr(EZ_WestUtilityFloor3, ParkingFloor, 0.5, 90 + %ShiftXBy%, 179 + 20, 111 + %ShiftXBy%, 280, 0, true)
		if[%floor% = -1] CreateFlr(EZ_MidwestUF1, ParkingFloor, 0.5, 90 + %ShiftXBy%, -59, 111 + %ShiftXBy%, -19, 0, true)

		CreateFlr(EZ_NortheastECF1, ParkingFloor, 0.5, 269 + %ShiftXBy%, 179, 333 + %ShiftXBy%, 221, 0, true) #ECF = Elevator core floor
		CreateFlr(EZ_NortheastECF2, ParkingFloor, 0.5, 269 + 18 + %ShiftXBy%, 221, 333 + %ShiftXBy%, 261, 0, true) #ECF = Elevator core floor
