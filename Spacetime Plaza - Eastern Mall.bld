			#Restrooms' doors (Floor mesh)
			WallOrientation = left
			AddStdDoor Floor %floor%, EZ_Midwest_RR1Door_%floorid%, , , false, %DTex%, %DSTex%, 0.2, right, left, 75, 75, 111.5 + 2 + %ShiftXBy%, -36 - 2.5, 3, 7, 0, 0, 0, 0, 0
			AddStdDoor Floor %floor%, EZ_Midwest_RR2Door_%floorid%, , , false, %DTex%, %DSTex%, 0.2, left, left, 75, 75, 111.5 + 2 + %ShiftXBy%, -36 + 2.5, 3, 7, 0, 0, 0, 0, 0
			AddFillerWalls ConnectionWall, 0.5, 111.5 + 2 + %ShiftXBy%, -36 - 2.5, 3, 7, 0, false, 0, 0, false
			AddFillerWalls ConnectionWall, 0.5, 111.5 + 2 + %ShiftXBy%, -36 + 2.5, 3, 7, 0, false, 0, 0, false

			#Signs for restrooms
			Set BoxTex = WoodSign2
			Set SignSuffix = _Brown

			AddBoxSign(EZ_Midwest_RR1_Sign, Sign_RestroomW%SignSuffix%, Sign_RestroomW%SignSuffix%, %BoxTex%, 0.05, false, true, true, 112 + 2 + 0.025 + %ShiftXBy%, -36 - 2.5, 1.5, 1.5, 7.5, false)
			AddBoxSign(EZ_Midwest_RR2_Sign, Sign_RestroomM%SignSuffix%, Sign_RestroomM%SignSuffix%, %BoxTex%, 0.05, false, true, true, 112 + 2 + 0.025 + %ShiftXBy%, -36 + 2.5, 1.5, 1.5, 7.5, false)

		#E3. Northwest Lobby
		Set EastEndpoint = 149 + %ShiftXBy%
		if[%floor% > 5] Set EastEndpoint = 119 + 1.5 + %ShiftXBy%
		WallOrientation = left
		DrawWalls = true, true, false, true, false, false
