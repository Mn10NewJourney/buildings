#Hallway to Elevator Lobbies and Restrooms
<Function STP-MallHallway>
	#Set door textures for restrooms
	Set DTex = Door8
	Set DSTex = %DTex%Side

	#Set textures for signs at the mall's main hallway
	Set SignTex = Elev_RR
	Set SideTex = WoodSign2

	#Set walls' dimensions
	Set WallHeight = %height%
	Set WallOffset = %interfloorheight%
	if[%floor% = 6] Set WallHeight = %height% + Floor(%floor% + 1).FullHeight
	if[%floor% = 6] Set WallOffset = %interfloorheight%
	if[%floor% = 8] Set WallHeight = %fullheight% + Floor(%floor% + 1).FullHeight
	if[%floor% = 8] Set WallOffset = 0

	#Set offsets for exit signs
	Set SignOffset = %fullheight%
	if[%floor% = 6 | %floor% = 8] Set SignOffset = %fullheight% + Floor(%floor% + 1).FullHeight

	#East Zone
		#E1. Southwest Lobby
		WallOrientation = left
		DrawWalls = true, true, false, true, false, false
		AddWall EZ_SouthwestLby_Front, %5%Wall, 0.5, 90.5 + %ShiftXBy%, -215, 117 + 1.5 + %ShiftXBy%, -215, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = true, true, false, true, false, false
		if[%floor% > 2] AddWall EZ_SouthwestLby_Front2, %5%Wall, 0.5, 117 + 1.5 + %ShiftXBy%, -215, 149 + %ShiftXBy%, -215, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = right
		DrawWalls = true, true, false, false, false, false
		AddWall EZ_SouthwestLby_Back, %5%Wall, 0.5, 90.5 + %ShiftXBy%, -180, 127 + %ShiftXBy%, -180, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

			#Sign leading to the elevators & restrooms
			AddBoxSign(EZ_Southwest_Sign1, %SignTex%_Left, %SignTex%_Right, %SideTex%, 0.1, true, true, true, 149 + 0.75 + %ShiftXBy%, -205 + 0.1, 1.5, 3, 7 + %interfloorheight%, true)
			if[%floor% < 3] AddBoxSign(EZ_Southwest_Sign1, %SignTex%_Left, %SignTex%_Right, %SideTex%, 0.1, false, true, true, 117 + 1.5 - 0.1 + %ShiftXBy%, -215 - 0.75, 1.5, 3, 7 + %interfloorheight%, true)

			#Exit sign
			if[%floor% ! 0] AddBoxSign(EZ_Southwest_ExitSign, ExitSignLeft, ExitSignRight, StainlessSteel, 0.1, true, true, true, 165 + %ShiftXBy%, -210, 1.8, 0.9, %SignOffset% - 0.9, true)

			#Restrooms' floor
			FloorOrientation = top
			DrawWalls = false, true, false, false, false, false
			CreateFlr(EZ_Southwest_RR_Flr, RestroomAreaFloor, 0.5, 90 + %ShiftXBy%, -215, 117 + 1.5 + %ShiftXBy%, -180, 0, true)

			#Restrooms' ceilings
			FloorOrientation = bottom
			DrawWalls = true, false, false, false, false, false
			AddFloor EZ_Southwest_RR_Ceiling, DropCeiling, 0.5, 90 + %ShiftXBy%, -215, 112 + %ShiftXBy%, -180, 8.5, 8.5, 0, 0, false

			#Restrooms' walls
			WallOrientation = right
			DrawWalls = true, true, true, false, false, false
			AddWall EZ_SouthwestRR_Right_EX, %5%Wall, 0.5, 117 + 1.5 + %ShiftXBy%, -215 + 8, 117 + 1.5 + %ShiftXBy%, -180.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
			DrawWalls = true, true, false, false, false, false
			AddWall EZ_SouthwestRR_Right, %5%Wall, 0.5, 117 - 5 + %ShiftXBy%, -214.5, 117 - 5 + %ShiftXBy%, -180.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

			WallOrientation = center
			AddWall EZ_SouthwestRR_Mid, %5%Wall, 1, 90.5 + %ShiftXBy%, -215 + 15, 117 - 5 + %ShiftXBy%, -215 + 15, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

			#Restrooms' doors (Floor mesh)
			WallOrientation = left
			AddStdDoor Floor %floor%, EZ_Southwest_RR1Door_%floorid%, , , false, %DTex%, %DSTex%, 0.2, right, left, 75, 75, 111.5 + %ShiftXBy%, -200 - 2.5, 3, 7, 0, 0, 0, 0, 0
			AddStdDoor Floor %floor%, EZ_Southwest_RR2Door_%floorid%, , , false, %DTex%, %DSTex%, 0.2, left, left, 75, 75, 111.5 + %ShiftXBy%, -200 + 2.5, 3, 7, 0, 0, 0, 0, 0
			AddFillerWalls ConnectionWall, 0.5, 111.5 + %ShiftXBy%, -200 - 2.5, 3, 7, 0, false, 0, 0, false
			AddFillerWalls ConnectionWall, 0.5, 111.5 + %ShiftXBy%, -200 + 2.5, 3, 7, 0, false, 0, 0, false

			#Signs for restrooms
			Set BoxTex = WoodSign2
			Set SignSuffix = _Brown

			AddBoxSign(EZ_Southwest_RR1_Sign, Sign_RestroomM%SignSuffix%, Sign_RestroomM%SignSuffix%, %BoxTex%, 0.05, false, true, true, 112 + 0.025 + %ShiftXBy%, -200 - 2.5, 1.5, 1.5, 7.5, false)
			AddBoxSign(EZ_Southwest_RR2_Sign, Sign_RestroomW%SignSuffix%, Sign_RestroomW%SignSuffix%, %BoxTex%, 0.05, false, true, true, 112 + 0.025 + %ShiftXBy%, -200 + 2.5, 1.5, 1.5, 7.5, false)

		#E2. Midwest Lobby
		WallOrientation = left
		DrawWalls = true, true, false, true, false, false
		AddWall EZ_MidwestLby_Front, %5%Wall, 0.5, 90.5 + %ShiftXBy%, -56, 149 + %ShiftXBy%, -56, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = right
