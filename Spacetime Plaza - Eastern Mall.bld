		if[%floor% < 5 & %floor% ! 0 & %floor% ! 1 & %floor% ! 2] AddWall EZ_RightWall, ExtFacade, 0.5, %1% + %ShiftXBy%, -%2% + 260, %1% + %ShiftXBy%, 140, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride %5%Wall, %ExtTex%, Blank, Blank, Blank, Blank
		if[%floor% < 5 & %floor% ! 0 & %floor% ! 1 & %floor% ! 2] AddWall EZ_RightWall, ExtFacade, 0.5, %1% + %ShiftXBy%, 140, %1% + %ShiftXBy%, %2% - 220, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		####################

