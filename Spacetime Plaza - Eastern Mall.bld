### EAST ZONE PARKING RAMPS (Underneath the main mall, between the April and Monica Dept. Stores) ###
#Auto area for parking ramps
	AddFloorAutoArea 310 - 20 + %ShiftXBy%, Floor(-2).Base, 20, 310 + 20 + %ShiftXBy%, Floor(-1).Base + 5, 140

#Cuts for parking ramps
	Cut External, 310 - 20 + %ShiftXBy%, Floor(-2).Base + 5, 20, 310 + 20 + %ShiftXBy%, Floor(-1).Base + 1.5, 140, false, true

#Parking ramps creation
	<Floor -2>
		TexPrefix() #Set texture prefix
	
		#Parking ramps
		FloorOrientation = top
		DrawWalls = true, true, false, false, false, false
		TextureOverride ParkingCeiling, Road, Blank, Blank, Blank, Blank
		AddFloor NorthRamp1_B2-B1, Road, 1, 310 - 20 + %ShiftXBy%, 20, 310 - 3 + %ShiftXBy%, 140, %fullheight% + Floor(%floor% + 1).InterfloorHeight, %interfloorheight%, 0, 0, true
		TextureOverride ParkingCeiling, Road, Blank, Blank, Blank, Blank
		AddFloor NorthRamp2_B2-B1, Road, 1, 310 + 3 + %ShiftXBy%, 20, 310 + 20 + %ShiftXBy%, 140, %interfloorheight%, %fullheight% + Floor(%floor% + 1).InterfloorHeight, 0, 0, true

		#Railings next to ramps
		Set WallHeight = 1 + 3.5
		Set WallOffset = %interfloorheight% - 1
		Set WallOffset2 = %fullheight% + Floor(%floor% + 1).InterfloorHeight - 1
		DrawWalls = true, true, true, true, true, false

		WallOrientation = left
		AddWall NR1_LeftRail, ParkingWall, 0.5, 310 - 20 + %ShiftXBy%, 20, 310 - 20 + %ShiftXBy%, 140, %WallHeight%, %WallHeight%, %WallOffset2%, %WallOffset%, 0, 0, true
		AddWall NR2_LeftRail, ParkingWall, 0.5, 310 + 3 + %ShiftXBy%, 20, 310 + 3 + %ShiftXBy%, 140, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset2%, 0, 0, true
		WallOrientation = right
		AddWall NR1_RightRail, ParkingWall, 0.5, 310 - 3 + %ShiftXBy%, 20, 310 - 3 + %ShiftXBy%, 140, %WallHeight%, %WallHeight%, %WallOffset2%, %WallOffset%, 0, 0, true
		AddWall NR2_RightRail, ParkingWall, 0.5, 310 + 20 + %ShiftXBy%, 20, 310 + 20 + %ShiftXBy%, 140, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset2%, 0, 0, true
	<EndFloor>

	<Floor -1>
		#Railings on the highest floor
		Set WallHeight = %interfloorheight% + 3.5
		Set WallOffset = 0
		DrawWalls = true, true, true, true, true, true

		WallOrientation = right
		AddWall NR_LeftRail, ParkingWall, 0.5, 310 - 20 + %ShiftXBy%, 20, 310 - 20 + %ShiftXBy%, 140, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall NR_FrontRail, ParkingWall, 0.5, 310 - 3.5 + %ShiftXBy%, 20, 310 + 20.5 + %ShiftXBy%, 20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		WallOrientation = left
		AddWall NR_RightRail, ParkingWall, 0.5, 310 + 20 + %ShiftXBy%, 20, 310 + 20 + %ShiftXBy%, 140, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall NR_BackRail, ParkingWall, 0.5, 310 - 20.5 + %ShiftXBy%, 140, 310 + 3.5 + %ShiftXBy%, 140, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	<EndFloor>

