	if[%floor% = 6] AddWall EA1FrontRail_Left, %5%%Suffix%, 0.5, 210 - 15 + %ShiftXBy%, -189 - 0.5, 210 - 15 + %ShiftXBy%, -184.5 - 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = left
