		if[%floor% > 4] AddWall EZ_RightWall_Top1, ExtFacade, 0.5, %1% + %ShiftXBy%, -%2% + 260, %1% + %ShiftXBy%, 100, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

