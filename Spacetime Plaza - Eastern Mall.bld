	Add3DWindows(3F_EA_FarNorthEnt_WinSide2, %1% + %ShiftXBy%, %MainZ% + 3 + 1.75, right, 3, %EntireHeight% - 0.5, 0.25, MainWindowsIntB, MainWindowsIntB, %5%Wall, 0.5, 1/4, 1)
