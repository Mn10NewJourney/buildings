		AddFloorIndicator 9, false, NewOtisInd_Button, left, %Shaft1CX% - 5.052, %Shaft1CZ% - 0.15, 0.3, 0.3, 4.5
		AddFloorIndicator 10, false, NewOtisInd_Button, left, %Shaft1CX% - 5.052, %Shaft1CZ% + 0.15, 0.3, 0.3, 4.5
<EndFunction>

<Function E11-12HallStation>
	#Shaft Doors
	ElevHallTex_East(true) #Set shaft door and panel textures
	Set StartNo = 11 #Number of the first elevator

	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = -3.84 - 0.3

	WallOrientation = right
	AddShaftDoorComponent %StartNo%, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo%, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
	FinishShaftDoor %StartNo%, 1, %AutoFiller%, false

	WallOrientation = right
	AddShaftDoorComponent %StartNo% + 1, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo% + 1, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
	FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(26, 6, -4.34, -4.14, -5 - 4, -5 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(27, 6, -4.34, -4.14, 5 - 4, 5 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)

	#****************************************#

	#Door trims/fillers
	TexPrefix() #Set filler textures to match with shaft walls
	Set Shaft1CX = -76
	Set Shaft1CZ = 249

		AddDecoObject(E26_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft1CX% - 5, %Shaft1CZ% - 5, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(E27_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft1CX% - 5, %Shaft1CZ% + 5, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)

	#****************************************#

	#Call buttons
		#Button panels
		CreateWallBox2 external, E26-27ExtPanel, %BPanelTexture%, %Shaft1CX% - 5.025, %Shaft1CZ%, 0.05, 0.6 + 0.2, 1 + 0.6 + 0.15, 3.5, 0, 0, false, true, true, true

		#Create buttons
		CallButtonElevators = 11, 12
		CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLitBlue, %ButtonPrefix%Down, %ButtonPrefix%DownLitBlue, %Shaft1CX% - 5.051, %Shaft1CZ%, 4 - 0.3, left, 0.3, 0.6, false, 0, 0

		#Signs
		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		AddBoxSign(E26-27_FloorSign, BlankSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft1CX% - 5.001, %Shaft1CZ%, 1.5, 1.5, 7 - 0.75 + %interfloorheight%, true)
		AddWall E26-27_HallSign, ElevHallSign, 0, %Shaft1CX% - 5.001, %Shaft1CZ% - 0.25, %Shaft1CX% - 5.001, %Shaft1CZ% + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false

	#****************************************#

	#Indicators above call buttons
		#Background
		Set WH = 0.6	
		Set WO = 4.5 + %interfloorheight%
		DrawWalls = true, false, false, false, false, false
		AddWall E26-27-PA-IndBG, NewOtisInd_BG2, 0, %Shaft1CX% - 5.051, %Shaft1CZ% - 0.3, %Shaft1CX% - 5.051, %Shaft1CZ% + 0.3, %WH%, %WH%, %WO%, %WO%, 0, 0, true
	
		#Directional arrows
		AddDirectionalIndicator 11, false, true, true, true, Blank, NewOtisArrow_Blank, NewOtisArrow_LitUp2, NewOtisArrow_Blank, NewOtisArrow_LitDown2, %Shaft1CX% - 5.051, %Shaft1CZ% - 0.15, 4.5 + 0.3 + 0.15 - 0.1375, left, 0.25, 0.275, false, 0, 0
		AddDirectionalIndicator 12, false, true, true, true, Blank, NewOtisArrow_Blank, NewOtisArrow_LitUp2, NewOtisArrow_Blank, NewOtisArrow_LitDown2, %Shaft1CX% - 5.051, %Shaft1CZ% + 0.15, 4.5 + 0.3 + 0.15 - 0.1375, left, 0.25, 0.275, false, 0, 0
	
		#Floor indicators
		AddFloorIndicator 11, false, NewOtisInd2_Button, left, %Shaft1CX% - 5.052, %Shaft1CZ% - 0.15, 0.3, 0.3, 4.5
		AddFloorIndicator 12, false, NewOtisInd2_Button, left, %Shaft1CX% - 5.052, %Shaft1CZ% + 0.15, 0.3, 0.3, 4.5
<EndFunction>

<Floors -2 to 8>
	#East/Outer Edge (Elevators 16-21)
	if[%floor% ! 7] E1-2HallStation()
	if[%floor% ! 7] E3-4HallStation()
	if[%floor% ! 7] E5-6HallStation()

	#West/Inner Edge (Elevators 22-27)
	if[%floor% ! 7] E7-8HallStation()
	if[%floor% ! 7] E9-10HallStation()
	if[%floor% ! 7] E11-12HallStation()
<EndFloors>

