	WallOrientation = left
	if[%floor% = 8] AddWall EA1LeftRail_8FEscLink_Front, %5%%Suffix%, 0.5, 234.14 + %ShiftXBy%, -120 - 4.5, 240 + %ShiftXBy%, -120 - 4.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
