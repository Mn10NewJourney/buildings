		WallOrientation = left
		DrawWalls = false, true, true, true, false, false
		AddWall ECDivWallB, %5%Wall, 0.5, 90 + %ShiftXBy%, -21 - 30, 90 + %ShiftXBy%, -21, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = left
		DrawWalls = false, true, true, true, false, false
		AddWall ECDivWallC, %5%Wall, 0.5, 90 + %ShiftXBy%, -21 - 30, 90 + %ShiftXBy%, 20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		Set SouthEnd = 180 #Reset for "ECDivWallD"
		if[%floor% > 5] Set SouthEnd = 224
		WallOrientation = left
		DrawWalls = false, true, true, true, false, false
		AddWall ECDivWallD, %5%Wall, 0.5, 90 + %ShiftXBy%, %SouthEnd%, 90 + %ShiftXBy%, 239.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

	#Perimeter windows
	Set MyIFloorType = 2
	if[%floor% = 0] Set MyIFloorType = 3
	Set WinHeight = %height%
	if[%floor% > 5] Set WinHeight = %height% + Floor(%floor% + 1).FullHeight

	SetAutoSize = true, false

		#Right windows
		Set MyIFloorType2 = 2
		if[%floor% = 5] Set MyIFloorType2 = 1
		if[%floor% = 0] Set MyIFloorType2 = 3

		Set ExtTex = ShopWindowsInt
		if[%floor% < 2] Set ExtTex = ShopWindows

		if[%floor% < 3] AddCustomWindows(EZ_RightWin1, ShopWindowsInt, %ExtTex%, %1% + %ShiftXBy%, -140, %1% + %ShiftXBy%, -100, %WinHeight%, 0, 0, %MyIFloorType2%, %5%Wall, ExtFacade)
		if[%floor% < 2] AddCustomWindows(EZ_RightWin2, ShopWindowsInt, %ExtTex%, %1% + %ShiftXBy%, 60, %1% + %ShiftXBy%, 140, %WinHeight%, 0, 0, %MyIFloorType2%, %5%Wall, ExtFacade)

		#Special values for windows above the "East annex"
