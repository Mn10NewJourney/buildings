			#Exit sign
			if[%floor% ! 0] AddBoxSign(EZ_Midwest_ExitSign, ExitSignLeft, ExitSignRight, StainlessSteel, 0.1, true, true, true, 165 + %ShiftXBy%, -51, 1.8, 0.9, %SignOffset% - 0.9, true)

			#Restrooms' floor
			FloorOrientation = top
			DrawWalls = false, true, false, false, false, false
			CreateFlr(EZ_Midwest_RR_Flr, RestroomAreaFloor, 0.5, 90 + %ShiftXBy%, -56, 117 + 2 + 1.5 + %ShiftXBy%, -21, 0, true)

			#Restrooms' ceilings
