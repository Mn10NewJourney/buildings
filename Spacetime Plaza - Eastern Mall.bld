	if[%elevator% = 7] Set P1Width = 1.25
	if[%elevator% = 7] Set P2Width = 0.25
	if[%elevator% = 8] Set P1Width = 0.25
	if[%elevator% = 8] Set P2Width = 1.25

	#Set textures and dimensions
