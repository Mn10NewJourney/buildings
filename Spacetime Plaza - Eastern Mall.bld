	AddWall ElevNo%elevator%_Inside, IN_ElevNoE(%elevator%), 0, -3.64 + 0.001, %P1_PositionZ% - 0.25, -3.64 + 0.001, %P1_PositionZ% + 0.25, 0.5, 0.5, 6.75, 6.75, 0, 0
<EndElevators>

<Elevators 11 to 12>
	#Button Panels
