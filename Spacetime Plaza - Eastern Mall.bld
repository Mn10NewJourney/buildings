	AddFillerWalls %5%Wall, 0.5, %1% + %ShiftXBy%, %MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

	Set EntireHeight = 10
	Add3DWindows(3F_EA_FarNorthEnt_WinTop, %1% + %ShiftXBy%, %MainZ%, right, 6, %EntireHeight% - 7.5, 7.25, MainWindowsIntB, MainWindowsIntB, %5%Wall, 0.5, 1/4, 1)
