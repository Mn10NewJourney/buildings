	if[%floor% = 8] AddWall EA1FrontRail, %5%%Suffix%, 0.5, 180 + %ShiftXBy%, -180 - 0.5, 240 + %ShiftXBy%, -180 - 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
