	#Driving lanes
	AddBoxSign(MainMall_DrivingLane1/1, Parking%ExtraSuffix%, NoEntry, OverheadSign_Black, 0.1, true, true, true, 450 + %ShiftXBy%, -140, 16, 2, %SignOffset%, true)
