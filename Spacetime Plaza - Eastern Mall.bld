<Function EA3Railings>
	TexPrefix() #Wall textures
	Set RailingHeight = %interfloorheight% + 3.5
	Set RailingOffset = 0

	Set Suffix = Wall2

		#Sets to determine odd/even floors
		Set Mod_Temp = mod(%floor%, 2)
		Set Mod = abs(%Mod_Temp%)

	Set EA3_EXNorth = 0
	if[%floor% = 8] Set EA3_EXNorth = 9

	#East atrium 3 (North) railings
	WallOrientation = right
	DrawWalls = true, true, true, true, true, false
	if[%Mod% = 1 | %floor% = 8] AddWall EA3FrontRail, %5%%Suffix%, 0.5, 190 + %ShiftXBy%, 210, 230 + %ShiftXBy%, 210, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%Mod% = 0 & %floor% ! 8] AddWall EA3FrontRailA, %5%%Suffix%, 0.5, 190 + %ShiftXBy%, 210, 202 + %ShiftXBy%, 210, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%Mod% = 0 & %floor% ! 8] AddWall EA3FrontRailB, %5%%Suffix%, 0.5, 218 + %ShiftXBy%, 210, 230 + %ShiftXBy%, 210, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	AddWall EA3LeftRail, %5%%Suffix%, 0.5, 190 + %ShiftXBy%, 210 - 0.5, 190 + %ShiftXBy%, 237 + %EA3_EXNorth% + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	WallOrientation = left
	AddWall EA3RightRail, %5%%Suffix%, 0.5, 230 + %ShiftXBy%, 210 - 0.5, 230 + %ShiftXBy%, 237 + %EA3_EXNorth% + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = left
	if[%Mod% = 0 & %floor% ! 8] AddWall EA3BackRail, %5%%Suffix%, 0.5, 190 + %ShiftXBy%, 237 + %EA3_EXNorth%, 230 + %ShiftXBy%, 237 + %EA3_EXNorth%, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%Mod% = 1] AddWall EA3BackRailA, %5%%Suffix%, 0.5, 190 + %ShiftXBy%, 237 + %EA3_EXNorth%, 202 + %ShiftXBy%, 237 + %EA3_EXNorth%, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%Mod% = 1] AddWall EA3BackRailB, %5%%Suffix%, 0.5, 218 + %ShiftXBy%, 237 + %EA3_EXNorth%, 230 + %ShiftXBy%, 237 + %EA3_EXNorth%, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 8] AddWall EA3BackRailA, %5%%Suffix%, 0.5, 190 + %ShiftXBy%, 237 + %EA3_EXNorth%, 206 + %ShiftXBy%, 237 + %EA3_EXNorth%, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 8] AddWall EA3BackRailB, %5%%Suffix%, 0.5, 214 + %ShiftXBy%, 237 + %EA3_EXNorth%, 230 + %ShiftXBy%, 237 + %EA3_EXNorth%, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
<EndFunction>

<Floors 1 to 8>
	if[%floor% ! 7] EA1Railings()
	if[%floor% ! 7] EA3Railings()
<EndFloors>

