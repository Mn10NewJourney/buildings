	WallOrientation = right
	if[%floor% ! 6] AddWall EA1LeftRail, %5%%Suffix%, 0.5, 180 + %ShiftXBy%, -180 - 0.5 - 0.5, 180 + %ShiftXBy%, -60 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 6] AddWall EA1LeftRail_NearTop1, %5%%Suffix%, 0.5, 180 + %ShiftXBy%, -180 - 0.5 - 0.5, 180 + %ShiftXBy%, -120 - 4, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 6] AddWall EA1LeftRail_NearTop2, %5%%Suffix%, 0.5, 180 + %ShiftXBy%, -120 + 4, 180 + %ShiftXBy%, -60 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	WallOrientation = left
	if[%floor% ! 8] AddWall EA1RightRail, %5%%Suffix%, 0.5, 240 + %ShiftXBy%, -180 - 0.5 - 0.5, 240 + %ShiftXBy%, -60 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 8] AddWall EA1RightRail, %5%%Suffix%, 0.5, 240 + %ShiftXBy%, -180 - 0.5 - 0.5, 240 + %ShiftXBy%, -120 - 4, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	if[%floor% = 8] AddWall EA1RightRail, %5%%Suffix%, 0.5, 240 + %ShiftXBy%, -120 + 4, 240 + %ShiftXBy%, -60 + 0.5, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true
	AddWall EA1BackRail, %5%%Suffix%, 0.5, 180 + %ShiftXBy%, -60, 240 + %ShiftXBy%, -60, %RailingHeight%, %RailingHeight%, %RailingOffset%, %RailingOffset%, 0, 0, true

	#New railings to the 7F-8F escalators
