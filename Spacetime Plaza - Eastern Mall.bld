#East Zone East Stairwell B
CreateStairwell 5, 86.5, -26, -2, 10
CutStairwell 5, -12, -4.5, 12, 4.5, 0, 5
ShowFullStairs 5 = always

<Floors -2 to 10>
	StairwellSets() #Determine stairs' size

	Set 21 = 86.5 #Center X
	Set 22 = -26 #Center Z
	Set 23 = 12 #Cut X
	Set 24 = 4.5 #Cut Z
