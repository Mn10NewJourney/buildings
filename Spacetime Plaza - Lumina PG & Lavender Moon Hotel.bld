		DrawWalls = true, true, false, false, false, false
		TextureOverride %5E%Wall, %5S%Wall, Blank, Blank, Blank, Blank
		AddWall HTE_SHA_Divider, %5S%Wall, 1, %CenterPoint%, -%2%, %CenterPoint%, %NorthPoint%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

