<EndTextures>

############################################################

#Floor Assignments
<Floors -1 to -2>
	ID = B(0 - %floor%)
	Name = Basement Level (0 - %floor%)
	Type = Basement
	Height = 10
	InterfloorHeight = 2
	if[%floor% = -1] Altitude = -10
<EndFloors>

<Floor -3>
	ID = -
	Name = Shaft Pit
	Type = Basement
	Height = 8
	InterfloorHeight = 2
<EndFloor>

<Floors 0 to 1>
	ID = %floor% + 1
	Name = Parking Level %floorid%
	Type = Parking
	Height = 16
	InterfloorHeight = 2
	if[%floor% = 0] Altitude = 2
<EndFloors>

<Floors 2 to 4>
	if[%floor% = 2] ID = 3
	if[%floor% = 3] ID = 4A
	if[%floor% = 4] ID = 4B
	Name = Parking Level %floorid%
	Type = Parking
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 5 to 7>
	if[%floor% = 5] ID = 5
	if[%floor% = 6] ID = 6A
	if[%floor% = 7] ID = 6B
	Name = Parking Level %floorid%
	Type = Parking
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 8 to 11>
	if[%floor% = 8] ID = 7
	if[%floor% = 9] ID = 7A
	if[%floor% = 10] ID = 8
	if[%floor% = 11] ID = 8A
	Name = Parking Level %floorid%
	Type = Parking
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 12 to 13>
	ID = %floor% - 3
	Name = Parking Level %floorid%
	Type = Parking
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 14 to 16>
	ID = %floor% - 3
	Name = Middle Mechanical Level %floorid%
	Type = Mechanical
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floor 17>
	ID = %floor% - 3
	Name = Hotel Lobby
	Type = Skylobby
	Height = 22
	InterfloorHeight = 2
<EndFloor>

<Floors 18 to 19>
	ID = %floor% - 3
	Name = Recreation Level %floorid%
	Type = Recreation
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 20 to 41>
	ID = %floor% - 3
	Name = Hotel Level %floorid%
	Type = Hotel
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 42 to 43>
	ID = %floor% - 3
	Name = Restaurant Level %floorid%
	Type = Restaurant
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 44 to 45>
	if[%floor% = 44] ID = 41
	if[%floor% = 45] ID = 41A
	Name = Topside Mechanical Level %floorid%
	Type = Mechanical
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floor 46>
	ID = 42
	Name = Roof
	Type = Roof
	Height = 9.5
	InterfloorHeight = 2
<EndFloor>

#Merge floors
<Floors -2 to -1>
	Group = -2 - -1
<EndFloors>

<Floors 14 to 16>
	Group = 14 - 16
<EndFloors>

<Floors 17 to 18>
	Group = 17 - 18
<EndFloors>

<Floors 44 to 45>
	Group = 44 - 45
<EndFloors>

##--------------------------------------------------------------------------------##

#LANDSCAPES
#Common values
Set 1 = 210 #Building Dimension X (Full width: 420 ft.)
Set 2 = 130 #Building Dimension Z (Full length: 260 ft.)

#Landscape
DrawWalls = false, true, false, false, false, false

##--------------------------------------------------------------------------------##

#Set texture prefixes/suffixes
<Function TexPrefix>
	#Main prefixes
	Set 5 = Hotel
	if[%floor% < 14] Set 5 = Parking
	if[%floor% > 13 & %floor% < 17] Set 5 = LowerService
	if[%floor% > 16 & %floor% < 20] Set 5 = HotelLobby
	if[%floor% = 42 | %floor% = 43] Set 5 = Summit
	if[%floor% > 43] Set 5 = Service

		#Parking lobby suffixes
		Set 5L = Wall
		if[%floor% < 14 & %floor% ! 0] Set 5L = LobbyWall

		#Service lobby prefixes (For walls inside service areas on most floors)
		Set SP1 = %5%
		if[%floor% < 14] Set SP1 = SA
		if[%floor% > 16 & %floor% < 44] Set SP1 = SA

		#Service lobby prefixes (For walls inside service areas on levels 14-40 only)
		Set SP2 = %5%
		if[%floor% > 16 & %floor% < 44] Set SP2 = SA

		#Service lobby prefixes (For podium service elevator)
		Set SP3 = %5%
		if[%floor% > -1 & %floor% < 14] Set SP3 = SA
		if[%floor% > 16 & %floor% < 44] Set SP3 = SA

	###************###

	#Podium Service Elevator's shaft doors
	Set 5PS = ServiceA
	if[%floor% > 13 & %floor% < 17] Set 5PS = ServiceB
	if[%floor% < 0] Set 5PS = ServiceC

	###************###

	#Tower Service Elevators' shaft doors
	Set 5TS = ServiceA
	if[%floor% > 13 & %floor% < 17] Set 5TS = ServiceB
	if[%floor% > 43] Set 5TS = ServiceB

	###************###

	#Set heights for External Shaft/Stairwell walls
	Set SHeight = %fullheight%
	Set SOffset = 0
	if[%floor% = 0 | %floor% = 14] Set SHeight = %height%
	if[%floor% = 0 | %floor% = 14] Set SOffset = %interfloorheight%
	if[%floor% < 0] Set SHeight = %height% + Floor(%floor% + 1).InterfloorHeight - 0.5
	if[%floor% < 0] Set SOffset = %interfloorheight%
	if[%floor% = 13] Set SHeight = %fullheight% + Floor(%floor% + 1).InterfloorHeight - 0.5
	if[%floor% = 13] Set SOffset = 0
<EndFunction>

##--------------------------------------------------------------------------------##

#EXTERIOR & INTERIOR
#Underground parking levels
<Floors -2 to -1>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	if[%floor% = -1] AddFloor LMH_PGFloor, Road, 0.5, -%1%, -%2%, %1% - 140, %2%, %interfloorheight%, %interfloorheight%, 0, 0, true
	if[%floor% = -1] AddFloor LMH_DockMezFloor, ParkingFloor3, 0.5, 70, 5, 80 - 0.5, 55, %interfloorheight%, %interfloorheight%, 0, 0, true
	if[%floor% ! -1] AddFloor LMH_PGFloor, Road, 0.5, -%1%, -%2%, %1%, %2%, %interfloorheight%, %interfloorheight%, 0, 0, true

		#Extra floorings above roads (East zone)
		#if[%floor% < -1] CreateFlr(BasementPK_UtilityFloor, ParkingFloor, 0.5, -180, -130, -126, -90 - 5, 0, true)
		CreateFlr(%floorid%F_PLFloor_East, ParkingFloor, 0.5, -126, -130, -120, -90 - 5, 0, true)
		CreateFlr(%floorid%F_PLFloor_Main, ParkingLobbyFloor, 0.5, -174, -130, -126, -90 - 5, 0, true)
		CreateFlr(%floorid%F_PLFloor_West, ParkingFloor, 0.5, -190, -130, -174, -90 - 5, 0, true)

		#Concrete floors for loading dock
		if[%floor% ! -1] CreateFlr(DockFloor_Left, LoadingDockFloor, 0.5, %1% - 140, -%2%, %1% - 140 + 15, %2%, 0, true)
		if[%floor% ! -1] CreateFlr(DockFloor_Right, LoadingDockFloor, 0.5, %1% - 20, -%2%, %1%, %2%, 0, true)
		if[%floor% ! -1] CreateFlr(DockFloor_Front, LoadingDockFloor, 0.5, %1% - 140 + 15, -%2%, %1% - 20, -%2% + 15, 0, true)

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% = -2] AddFloor LMH_PGCeiling, %5%Ceiling, 0.5, -%1%, -%2%, %1% - 140, %2%, %fullheight% + 1, %fullheight% + 1, 0, 0, true
	if[%floor% = -2] AddFloor LMH_DockMezCeiling, %5%Ceiling, 0.5, 70, 5, 80 - 0.5, 55, %fullheight%, %fullheight%, 0, 0, true
	if[%floor% ! -2] AddFloor LMH_PGCeiling, %5%Ceiling, 0.5, -%1%, -%2%, %1%, %2%, %fullheight% + 1, %fullheight% + 1, 0, 0, true
	AddFloor LMH_ELCeiling, ParkingLobbyCeiling, 0.5, -174, -118, -126, -102 - 5, %fullheight%, %fullheight%, 0, 0, true

	#Perimeter walls
	TexPrefix() #Set texture prefix/suffix
	if[%floor% ! -1] Set WallHeight = %fullheight%
	if[%floor% = -1] Set WallHeight = %fullheight% + Floor(0).InterfloorHeight
	Set WallOffset = 0

		#Set DrawWalls for Front/Left sides
		DrawWalls = false, true, false, false, false, false

		WallOrientation = left
		if[%floor% = -2] AddWall FrontWall, %5%Wall, 0.5, 30 - 0.5, -%2%, %1%, -%2%, %WallHeight% + Floor(-1).InterfloorHeight, %WallHeight% + Floor(-1).InterfloorHeight, %WallOffset%, %WallOffset%, 0, 0, true
		#AddWall LeftWall, %5%Wall, 0.5, -%1%, -%2%, -%1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		#Set DrawWalls for Right/Back sides
		WallOrientation = right
		DrawWalls = true, true, false, false, false, false
		if[%floor% = -2] AddWall RightWall_Inner1, %5%Wall, 0.5, %1% - 140, -%2%, %1% - 140, 5, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true
		if[%floor% = -2] AddWall RightWall_Inner2, %5%Wall, 0.5, %1% - 140, 5 + 12, %1% - 140, 55 - 25, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true
		if[%floor% = -2] AddWall RightWall_Inner3, %5%Wall, 0.5, %1% - 140, 55, %1% - 140, %2%, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true


		DrawWalls = true, false, false, false, false, false
		if[%floor% = -1] AddWall RightWall_Inner2, %5%Wall, 0.5, %1% - 140, 5, %1% - 140, 55, %interfloorheight%, %interfloorheight%, 0, 0, 0, 0, true

		WallOrientation = right
		DrawWalls = true, true, true, true, true, false #Reset for the following wall.
		if[%floor% = -1] AddWall RightWall_DK1, LoadingDockRailing, 0.5, %1% - 140, -%2% + 0.5, %1% - 140, 5, %interfloorheight% + 3.5, %interfloorheight% + 3.5, 0, 0, 0, 0, true
		if[%floor% = -1] AddWall RightWall_DK2, LoadingDockRailing, 0.5, %1% - 130 - 0.5, 5 + 12, %1% - 130 - 0.5, 55 - 25, %interfloorheight% + 3.5, %interfloorheight% + 3.5, 0, 0, 0, 0, true
		DrawWalls = true, true, true, false, true, false #Reset for the following wall.
		if[%floor% = -1] AddWall RightWall_DK3, LoadingDockRailing, 0.5, %1% - 140, 55, %1% - 140, %2%, %interfloorheight% + 3.5, %interfloorheight% + 3.5, 0, 0, 0, 0, true

		#AddWall RightWall, %5%Wall, 0.5, %1%, -%2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		if[%floor% ! -1] AddWall BackWall, %5%Wall, 0.5, -%1%, %2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		DrawWalls = true, false, false, true, false, false
		if[%floor% = -1] AddWall BackWall, %5%Wall, 0.5, -%1%, %2%, -10, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		DrawWalls = true, false, true, false, false, false
		if[%floor% = -1] AddWall BackWall, %5%Wall, 0.5, 30, %2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = true, false, false, false, false, true
		AddWall BackWall_IFloorCover, %5%Wall, 0.5, -10, %2%, 30, %2%, Floor(%floor% + 1).InterfloorHeight, Floor(%floor% + 1).InterfloorHeight, %fullheight%, %fullheight%, 0, 0, true
		if[%floor% = -1] AddWall BackWall_IFloorCover2, %5%Wall, 0.5, -10, %2%, 30, %2%, 1, 1, %interfloorheight% + 9, %interfloorheight% + 9, 0, 0, true

	#Loading dock filler walls
	WallOrientation = right
	if[%floor% = -2] AddFillerWalls ParkingWall, 0.5, 170, %2%, 40, 9, %interfloorheight%, true, 0, 0, true
<EndFloors>

#Tower parking levels
<Floors 0 to 13>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor TowerParkingFlr, Road, 0.5, -%1%, -%2%, %1%, %2%, %interfloorheight%, %interfloorheight%, 0, 0, true

		#Extra floorings above roads
		if[%floor% = 1 | %floor% = 2] CreateFlr(TowerPK_UtilityFloor1, ParkingFloor2, 0.5, -90, -%2%, %1% - 21, -108, 0, true)
		#if[%floor% = 1 | %floor% = 2] CreateFlr(TowerPK_UtilityFloor1, ParkingFloor2, 0.5, -90, -%2%, 110, -108, 0, true)
		if[%floor% = 1] CreateFlr(TowerPK_UtilityFloor2, ParkingFloor, 0.5, -90.5, 85, 110.5, 93, 0, true)
		#if[%floor% = 0] CreateFlr(WalkwayNorthofHotelEntrance, ParkingFloor, 0.5, -%1%, 40, -145, 55, 0, true)

		Set NorthEnd = -95
		if[%floor% = 1] Set NorthEnd = -90
		if[%floor% = 2] Set NorthEnd = -108

		Set NorthEnd2 = -90 - 5
		if[%floor% = 1] Set NorthEnd2 = -90

		if[%floor% = 3 | %floor% = 4 | %floor% = 6 | %floor% = 7] Set NorthEnd = -95
		if[%floor% = 1] CreateFlr(TowerPK_ElevLbyFlr_East1EX, ParkingFloor2, 0.5, -174, -90 - 5, -126, -90, 0, true)

		if[%floor% > 0] CreateFlr(TowerPK_ElevLbyFlr_East1, ParkingFloor2, 0.5, -126, -130, -120, %NorthEnd2%, 0, true)
		if[%floor% > 0] CreateFlr(TowerPK_ElevLbyFlr_East2, ParkingFloor2, 0.5, -120, -130, -90, %NorthEnd%, 0, true)
		if[%floor% > 0] CreateFlr(TowerPK_ElevLbyFlr_Main, ParkingLobbyFloor, 0.5, -174, -130, -126, -90 - 5, 0, true)

		if[%floor% = 3 | %floor% = 4 | %floor% = 6 | %floor% = 7] CreateFlr(LinkToMonicaDS, ParkingFloor2, 0.5, 30, -130, %1% - 21, -113, 0, true)
		if[%floor% > 4 & %floor% ! 6 & %floor% ! 7] CreateFlr(FloorNorthofMallPKElev, ParkingFloor2, 0.5, -90, -130, %1% - 21, -113, 0, true)
		#if[%floor% > 4 & %floor% ! 6 & %floor% ! 7] CreateFlr(FloorNorthofMallPKElev, ParkingFloor2, 0.5, -90, -130, -50, -109, 0, true)
		#if[%floor% = 0] CreateFlr(FloorNorthofMallPKElev, ParkingFloor2, 0.5, -126, -130, -60, -109, 0, true)

		#Extra floorings under ramps
		if[%floor% = 1] CreateFlr(SouthRampUDSFloor, ParkingFloor3, 0.5, -90, -108, 110, -71, 0, true)
		if[%floor% = 2] CreateFlr(NorthRampUDSFloor, ParkingFloor3, 0.5, -170, 111, 150, %2%, 0, true)

		#Far east utility floors
		CreateFlr(FarEastUF, ParkingFloor2, 0.5, %1% - 21, -%2%, %1%, %2%, 0, true)
		#CreateFlr(FarEastUF_1, LoadingDockFloor, 0.5, %1% - 21, -%2%, %1%, -109, 0, true)
		#CreateFlr(FarEastUF_2, LoadingDockFloor, 0.5, %1% - 21, 9, %1%, %2%, 0, true)

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	AddFloor TowerParkingCeil, %5%Ceiling, 0.5, -%1%, -%2%, %1%, %2%, %fullheight% + 1, %fullheight% + 1, 0, 0, true
	if[%floor% > 0] AddFloor LMH_ELCeiling, ParkingLobbyCeiling, 0.5, -174, -118, -126, -102 - 5, %fullheight%, %fullheight%, 0, 0, true

	#Railings
	DrawWalls = true, true, true, true, true, true

	Set WallHeight = %interfloorheight% + 4.5
	Set WallOffset = 0
	if[%floor% = 0] Set WallHeight = 5.5
	if[%floor% = 0] Set WallOffset = %interfloorheight%
	if[%floor% = 1] Set WallHeight = %interfloorheight% + 5.5
	if[%floor% = 1] Set WallOffset = 0

	#Set ShowBottom = true
	#if[%floor% = 0] Set ShowBottom = false

		#Left
		Set EP = 0 #Extra position 1 (North)
		if[%floor% = 0] Set EP = 40 #Extra position 1 (North)
		Set EP2 = 0 #Extra position 2 (South)
		#if[%floor% = 1] Set EP2 = 180 #Extra position 2 (South)

		WallOrientation = left
		#TextureOverride ExtFacade, ExtFacade2, ExtFacade, ExtFacade, ExtFacade2, ExtFacade2
		#if[%floor% ! 0] AddWall LeftRail, ExtFacade2, 0.5, -%1%, -%2% + %EP2%, -%1%, %2% - %EP%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade, ExtFacade2, ExtFacade, ExtFacade, ExtFacade2, ExtFacade2
		if[%floor% ! 0] AddWall LeftRailA, ExtFacade2, 0.5, -%1%, -95 + 5, -%1%, -50 - 20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade, ExtFacade2, ExtFacade, ExtFacade, ExtFacade2, ExtFacade2
		if[%floor% ! 0] AddWall LeftRailB, ExtFacade2, 0.5, -%1%, -50 + 20, -%1%, %2% - %EP%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		#Back
		WallOrientation = right
		TextureOverride ExtFacade2, ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% < 2] AddWall BackRailL1, ExtFacade2, 0.5, -%1% + 0.5, %2%, -90, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade2, ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% = 1] AddWall BackRailL2, ExtFacade2, 0.5, -90 + 200, %2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		#if[%floor% < 2] AddWall BackRail, ExtFacade2, 0.5, -%1% + 0.5, %2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		TextureOverride ExtFacade2, ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% > 1] AddWall BackRailU1, ExtFacade2, 0.5, -%1% + 0.5, %2%, -170, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade2, ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% > 1] AddWall BackRailU2, ExtFacade2, 0.5, -50, %2%, 30, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade2, ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% > 1] AddWall BackRailU3, ExtFacade2, 0.5, 150, %2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

	#Perimeter walls
		#Override for "BackWallA" only
		Set WallHeight = %fullheight%
		Set WallOffset = 0
		if[%floor% = 0] Set WallHeight = %height%
		if[%floor% = 0] Set WallOffset = %interfloorheight%

		#Back walls
		WallOrientation = right
		TextureOverride ExtFacade2, ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% < 2] AddWall BackWallA, ExtFacade2, 0.5, -90, %2%, -90 + 200, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		TextureOverride ExtFacade2, ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% > 1] AddWall BackWallB, ExtFacade2, 0.5, -170, %2%, -50, %2%, %fullheight%, %fullheight%, 0, 0, 0, 0, true
		TextureOverride ExtFacade2, ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% > 1] AddWall BackWallC, ExtFacade2, 0.5, 30, %2%, 150, %2%, %fullheight%, %fullheight%, 0, 0, 0, 0, true

		#Left walls
		DrawWalls = true, true, true, true, false, false
		WallOrientation = left
		TextureOverride ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% > 0] AddWall LeftWallA, ExtFacade2, 0.5, -%1%, -%2%, -%1%, -95 + 5, %fullheight%, %fullheight%, 0, 0, 0, 0, true
		TextureOverride ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% > 0] AddWall LeftWallB, ExtFacade2, 0.5, -%1%, -50 - 20, -%1%, -50 - 15, %fullheight%, %fullheight%, 0, 0, 0, 0, true
		TextureOverride ExtFacade, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2, ExtFacade2
		if[%floor% > 0] AddWall LeftWallC, ExtFacade2, 0.5, -%1%, -50 + 15, -%1%, -50 + 20, %fullheight%, %fullheight%, 0, 0, 0, 0, true
<EndFloors>

<Floors -2 to 13>
	#Flooring at service elevator lobbies
	#Set Extra = 0
	#if[%floor% < 0] Set Extra = 9

	#Tower Service Elevators
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	#if[%floor% > -1] CreateFlr(WestTowerServiceFloor, ParkingFloor3, 0.5, -145, 5, -129, 55, 0, true)
	#if[%floor% > -1] CreateFlr(EastTowerServiceFloor, ParkingFloor3, 0.5, -91, 5, -75, 55, 0, true)

	if[%floor% ! 0] CreateFlr(TowerServiceFloor, ParkingFloor3, 0.5, -145, 5, -75, 55, 0, true) #Basements only

	#Podium Service Elevator
	if[%floor% ! -1] Set End = 0
	if[%floor% = -1] Set End = 9.5
	if[%floor% > -2 & %floor% ! 0] CreateFlr(PodiumServiceFloor, ParkingFloor3, 0.5, 64, 5, 80 - 0.5 - %End%, 55, 0, true)
<EndFloors>

########################################

#ROAD MARKINGS AND EXTRAS
<Floors -2 to -1>
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false

	#Extra floors under ramps
	Set EastPoint = %1% - 140 - 10
	if[%floor% = -1] Set EastPoint = -10
	CreateFlr(LuminaPG_FarNorthUF, ParkingFloor, 0.5, -%1%, 110, %EastPoint%, %2%, 0, true)
	if[%floor% = -2] CreateFlr(LuminaPG_MidEastUF, ParkingFloor, 0.5, %EastPoint%, -%2%, %1% - 140, %2%, 0, true)

	#Two-way road markings leading to the exit
	if[%floor% = -1] CreateFlr(NorthwestLane, 2Lane-TWZ-20FT, 0.5, 15 - 10, -%2%, 15 + 10, -90, 0, true)

	#Basement Parking Spaces
	Set Offset = %interfloorheight% + 0.01

