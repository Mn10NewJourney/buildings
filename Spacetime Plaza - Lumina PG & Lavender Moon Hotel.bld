#Cuts for hotel entrance and shopping arcade
Set NorthPoint = 70 #Northern endpoint for this zone.
Set CenterPoint = -50 #Center point between Hotel Entrance and Shopping Arcade areas.
Cut External, -%1%, Floor(0).Base - 0.1, -%2%, %1%, Floor(0).Base + 5, %NorthPoint%, false, true

<Floor 0>
	Set 5E = HotelEntrance #Override
	Set 5S = SHA #Override

	#Hotel entrance floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor HotelEntrFlr, %5E%Floor, 0.5, -%1%, -%2%, %CenterPoint%, %NorthPoint%, %interfloorheight%, %interfloorheight%, 0, 0, true
