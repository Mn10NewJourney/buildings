########################################

#Podium Service Elevator Lobby (Levels 1-10 and 14)
<Function PodiumSL>
	#Sets for walls
	Set WallHeight = %height%
	if[%floor% < 0] Set WallHeight = %height% + 1
	if[%floor% > 0 & %floor% < 14] Set WallHeight = %height% + 1
	Set WallOffset = %interfloorheight%

	#----------------------------------------

	#Podium service floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	CreateFlr(PodiumServFlr, SAFloor, 0.5, 69.5 + 0.5, 5, 79.5, 55, 0, true)

	#Podium Service Wall
	Set OutsideTex = %5%Wall
	if[%floor% > 16] Set OutsideTex = Blank
	
	LMH_ServCoreWalls(left, %OutsideTex%, SAWall, Podium_Left, 69.5, 5 + 12, 69.5, 55 - 25, %WallHeight%, %WallOffset%, true)
	LMH_ServCoreWalls(right, SAWall, %OutsideTex%, Podium_Right, 79.5, 5 + 12, 79.5, 55 - 25, %WallHeight%, %WallOffset%, true)

	#Interior core walls (14th-15th floors)
	WallOrientation = left
	DrawWalls = true, true, false, false, false, false
	if[%floor% > 16] AddWall PodiumCoreWallInside, SAWall, -13, 70, 30, 79, 30, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true

		#Service doors
		Set Door_MainX = 69.5 + 0.5
		Set Door_MainZ = 25

		WallOrientation = right
		AddStdDoor Door Manager, %floorid%F_PodiumService_D1, , , false, %DTex%, %DSTex%, 0.2, left, right, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddStdDoor Door Manager, %floorid%F_PodiumService_D2, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

	#Full-height ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	CreateFlr(PodiumServFHC, SACeiling, 0.5, 69.5, 5, 79.5, 55, %height%, true)

	#Dropped ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 0 | %floor% = 1 | %floor% = 17] AddFloor EastServDC, SLDropCeiling, 0.5, 69.5, 5 + 12, 79.5, 55 - 25, 9.5, 9.5, 0, 0, false
<EndFunction>

#Elevator lobby creation
<Floors 0 to 13>
	TexPrefix() #Set texture prefixes for walls
	if[%floor% = 0] Set 5 = SHA #Override

	LMH_ServCoreDoors() #Set door textures

	PodiumSL() #Room creation
<EndFloors>

<Floors 17 to 18>
