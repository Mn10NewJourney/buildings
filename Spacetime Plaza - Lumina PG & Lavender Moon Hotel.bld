	DrawWalls = false, true, false, false, false, false
	AddWall ElevNo%elevator%_Inside, IN_ElevNo%elevator%, 0, -2.8 + 0.001, 0 - 0.25, -2.8 + 0.001, 0 + 0.25, 0.5, 0.5, 7.05, 7.05, 0, 0

	#Indicator sets
	KSS670_PI_InternalInd(right, -2.8 + 0.051, %Position%, 6, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)
	KSS670_PI_InternalInd(right, -2.8 + 0.051, %Position2%, 6, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)
<EndElevators>

<Elevators 15 to 24>
	#DETAILED INTERIORS
	Set Prefix = UpperHotel

	#1. Ceiling lights
	Set LightOffset = 8 - 0.001
	Set LightOffset2 = 8 - 0.002
	Set GridSuffix = Grid

	Set LightWidth = 5.5
	Set LightLength = 4
	
	DrawWalls = true, false, false, false, false, false
	AddFloor CeilingLight, %Prefix%ElevCeilingLight, 0, 0 - (%LightWidth% / 2), -(%LightLength% / 2), 0 + (%LightWidth% / 2), (%LightLength% / 2), %LightOffset%, %LightOffset%, 0, 0
	AddFloor CeilingGrid, %Prefix%ElevCeiling%GridSuffix%, 0, 0 - (%LightWidth% / 2), -(%LightLength% / 2), 0 + (%LightWidth% / 2), (%LightLength% / 2), %LightOffset2%, %LightOffset2%, %LightWidth% / 0.5, %LightLength% / 0.5

	#2. Downlights
	DrawWalls = true, false, false, false, false, false
	Set DLOffset = 8 - 0.001 #Offsets for downlights
	AddFloor Downlight1/1, %Prefix%ElevCeilingDL, 0, -1.875 - 0.095, (-2.65) - 0.095, -1.875 + 0.095, (-2.65) + 0.095, %DLOffset%, %DLOffset%, 0, 0
	AddFloor Downlight1/2, %Prefix%ElevCeilingDL, 0, 0 - 0.095, (-2.65) - 0.095, 0 + 0.095, (-2.65) + 0.095, %DLOffset%, %DLOffset%, 0, 0
	AddFloor Downlight1/3, %Prefix%ElevCeilingDL, 0, 1.875 - 0.095, (-2.65) - 0.095, 1.875 + 0.095, (-2.65) + 0.095, %DLOffset%, %DLOffset%, 0, 0

	AddFloor Downlight2/1, %Prefix%ElevCeilingDL, 0, -1.875 - 0.095, (2.65) - 0.095, -1.875 + 0.095, (2.65) + 0.095, %DLOffset%, %DLOffset%, 0, 0
	AddFloor Downlight2/2, %Prefix%ElevCeilingDL, 0, 0 - 0.095, (2.65) - 0.095, 0 + 0.095, (2.65) + 0.095, %DLOffset%, %DLOffset%, 0, 0
	AddFloor Downlight2/3, %Prefix%ElevCeilingDL, 0, 1.875 - 0.095, (2.65) - 0.095, 1.875 + 0.095, (2.65) + 0.095, %DLOffset%, %DLOffset%, 0, 0

	#3. Panels on walls
	Set WPTex = %Prefix%ElevWallPanel1
	if[%elevator% > 19] Set WPTex = %Prefix%ElevWallPanel2
	Set WPanelHeight = 3.5

	Set Direction = %param2%

		#Front/back panels
		CreateWallBox2 elevator, Panel_F, %WPTex%, 0, -3.3 + 0.01, 5.6, 0.02, %WPanelHeight%, 0, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_B, %WPTex%, 0, 3.3 - 0.01, 5.6, 0.02, %WPanelHeight%, 0, 0, 0, false, true, true, true

		#Left/right panels
		if[%elevator% < 20] CreateWallBox2 elevator, Panel_L, %WPTex%, -2.8 + 0.01, 0, 0.02, 6.6 - 0.04, %WPanelHeight%, 0, 0, 0, false, true, true, true
		if[%elevator% > 19] CreateWallBox2 elevator, Panel_R, %WPTex%, 2.8 - 0.01, 0, 0.02, 6.6 - 0.04, %WPanelHeight%, 0, 0, 0, false, true, true, true

	#----------------------------------------

	#Shaft components
	DrawWalls = true, true, true, true, true, true
		#Ropes
		RopePosition = 0, 8 + 0.2, 0
		RopeTexture = Ropes
	
		#Counterweight
		if[%elevator% < 20] Set Position = -3 - 0.75
		if[%elevator% > 19] Set Position = 3 + 0.75
		CreateCounterweight CWeight_Frame, CWeight, %Position%, 0, 0.5, 6, 2, 0.5

		#Rails
		AddRails ElevRail, ElevRailSide, 0, 0, true, 3.5 + 0.06, 0.1
		AddRails ElevRail, ElevRailSide, %Position%, 0, true, 1 + 0.06, 0.1
<EndElevators>

