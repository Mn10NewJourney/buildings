#----------------------------------------#

#Service Elevators' Interiors
<Elevators 25 to 26>
	Set Prefix = Service

	#Set textures and dimensions
	M10_ElevCabTex(ElevExt2, %Prefix%ElevFloor, %Prefix%ElevCeiling, %Prefix%ElevWall, %Prefix%ElevWall)
	M10_ElevDimensions(6, 9.28, 8, 0.2, 0.2, true, true, true, false)
	M10_ElevPanels(%Prefix%ElevPanelMain, %Prefix%ElevPanelTop, 1.25, 0.25, 1, 0.2, false, false, false, true)

	#Finish elevator assembly
	M10_ElevInterior()
	#--------------------
	#Car Doors
	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = 4.64

	WallOrientation = left
	AddDoorComponent 1, 2Speed_Fast, %ElevDoorTex%, %ElevDoorTex%, 0.15, left, 0.8, 0.6, 2.75 - (2.25 * 1), %IDP% + (0.15 * 1), 2.75, %IDP% + (0.15 * 1), 7, 0, 0, 0, 0, 0
	AddDoorComponent 1, 2Speed_Slow, %ElevDoorTex%, %ElevDoorTex%, 0.15, left, 0.4, 0.3, 2.75 - (2.25 * 2), %IDP%, 2.75 - (2.25 * 1), %IDP%, 7, 0, 0, 0, 0, 0
	FinishDoors 1, false, false

		#Door track
		FloorOrientation = top
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevDoorTrackZ, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor DoorTrack, ElevDoorTrackZ, 0.05, 2.75 - (2.25 * 3), %IDP%, 2.75, %IDP% + (0.15 * 2), 0, 0, 0, 0

		#Top filler
		FloorOrientation = bottom
		DrawWalls = true, true, true, true, true, true
		TextureOverride %Prefix%ElevPanelTop, ElevExt, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor TopFiller, %Prefix%ElevPanelTop, 0.05, 2.75 - (2.25 * 1), %IDP%, 2.75, %IDP% + (0.15 * 1), 7, 7, 0, 0

	#Gap filler
	WallOrientation = left
	DrawWalls = true, true, true, true, true, true
	TextureOverride ElevExt, ElevExt, %Prefix%ElevPanelMain, ElevExt, ElevExt, ElevExt
	AddWall GapFiller, %Prefix%ElevPanelMain, 0.15 * 2, 2.75, %IDP%, 3, %IDP%, 7, 7, 0, 0, 0, 0
	#--------------------
	#Button Panels
	Set Position = -2.275

		#Panel back
		if[%elevator% = 25] CreateWallBox2 elevator, MainPB, ElevPanel, %Position%, 4.44 - 0.025, 0.8, 0.05, 5 + 0.125, 2 - 0.125, 0, 0, false, true, true, true
		if[%elevator% = 26] CreateWallBox2 elevator, MainPB, ElevPanel, %Position%, 4.44 - 0.025, 0.9, 0.05, 5 + 0.125, 2 - 0.125, 0, 0, false, true, true, true

		#Panel
		if[%elevator% = 25] CreatePanel , 11, 3, front, %Position%, 4.44 - 0.051, 0.15, 0.15, 0.25, 0.25, 3.5, 0, 0 #All buttons

		if[%elevator% = 26] CreatePanel , 13, 4, front, %Position%, 4.44 - 0.051, 0.15, 0.15, 0.25, 0.25, 3.5, 0, 0 #Floor buttons
		if[%elevator% = 26] CreatePanel , 13, 3, front, %Position%, 4.44 - 0.051, 0.15, 0.15, 0.25, 0.25, 3.5, 0, 0 #Control buttons

			#Buttons
			if[%elevator% = 25] BtnPanelE25(1)
			if[%elevator% = 26] BtnPanelE26-27(1)

	#Elevator number sign
	DrawWalls = true, false, false, false, false, false
	AddWall ElevNo%elevator%_Inside, IN_ElevNo%elevator%, 0, 0.5 - 0.25, 4.44 - 0.051, 0.5 + 0.25, 4.44 - 0.051, 0.5, 0.5, 7.05, 7.05, 0, 0

	#Indicator sets
	KSS670_PI_InternalInd(front, %Position%, 4.44 - 0.051, 6, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)
	#--------------------
	#Proximity scanner
	Set PSscanHeight = 0.45
	Set PScanWidth = %PSscanHeight% * 0.712

	Set PScanTex = HIDScanGreen
	if[%elevator% > 25] Set PScanTex = HIDScanRed

	Set ExtraOffset = 0.125

	DrawWalls = true, false, false, false, false, false
	AddWall ProximityScanner, %PScanTex%, 0, %Position% - (%PScanWidth% / 2), 4.44 - 0.051, %Position% + (%PScanWidth% / 2), 4.44 - 0.051, %PSscanHeight%, %PSscanHeight%, 4.75 + %ExtraOffset%, 4.75 + %ExtraOffset%, 0, 0
	#--------------------
	#Shaft components
	DrawWalls = true, true, true, true, true, true
		#Ropes
		RopePosition = 0, 8 + 0.2, 0
		RopeTexture = Ropes
	
		#Counterweight
		Set Position = -3 - 0.8

		CreateCounterweight CWeight_Frame, CWeight, %Position%, 0, 0.5, 6, 2, 0.5
	
		#Rails
		AddRails ElevRail, ElevRailSide, 0, 0, false, 3 + 0.06, 0.1
		AddRails ElevRail, ElevRailSide, %Position%, 0, true, 1 + 0.06, 0.1
<EndElevators>

<Elevator 27>
	Set Prefix = Service

	#Set textures and dimensions
	M10_ElevCabTex(ElevExt2, %Prefix%ElevFloor, %Prefix%ElevCeiling, %Prefix%ElevWall, %Prefix%ElevWall)
	M10_ElevDimensions(6, 9.28, 8, 0.2, 0.2, false, true, true, true)
	M10_ElevPanels(%Prefix%ElevPanelMain, %Prefix%ElevPanelTop, 0.25, 1.25, 1, 0.2, true, false, false, false)

	#Finish elevator assembly
	M10_ElevInterior()
	#--------------------
	#Car Doors
	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = -4.64

	WallOrientation = right
	AddDoorComponent 1, 2Speed_Fast, %ElevDoorTex%, %ElevDoorTex%, 0.15, right, 0.8, 0.6, -2.75, %IDP% - (0.15 * 1), -2.75 + (2.25 * 1), %IDP% - (0.15 * 1), 7, 0, 0, 0, 0, 0
	AddDoorComponent 1, 2Speed_Slow, %ElevDoorTex%, %ElevDoorTex%, 0.15, right, 0.4, 0.3, -2.75 + (2.25 * 1), %IDP%, -2.75 + (2.25 * 2), %IDP%, 7, 0, 0, 0, 0, 0
	FinishDoors 1, false, false

		#Door track
		FloorOrientation = top
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevDoorTrackZ, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor DoorTrack, ElevDoorTrackZ, 0.05, -2.75, %IDP% - (0.15 * 2), -2.75 + (2.25 * 3), %IDP%, 0, 0, 0, 0

		#Top filler
		FloorOrientation = bottom
		DrawWalls = true, true, true, true, true, true
		TextureOverride %Prefix%ElevPanelTop, ElevExt, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor TopFiller, %Prefix%ElevPanelTop, 0.05, -2.75, %IDP% - (0.15 * 1), -2.75 + (2.25 * 1), %IDP%, 7, 7, 0, 0

	#Gap filler
	WallOrientation = right
	DrawWalls = true, true, true, true, true, true
	TextureOverride ElevExt, ElevExt, ElevExt, %Prefix%ElevPanelMain, ElevExt, ElevExt
	AddWall GapFiller, %Prefix%ElevPanelMain, 0.15 * 2, -3, %IDP%, -2.75, %IDP%, 7, 7, 0, 0, 0, 0
	#--------------------
	#Button Panels
	Set Position = 2.275

		#Panel back
		CreateWallBox2 elevator, MainPB, ElevPanel, %Position%, -4.44 + 0.025, 0.9, 0.05, 5 + 0.125, 2 - 0.125, 0, 0, false, true, true, true

		#Panel
		CreatePanel , 13, 4, back, %Position%, -4.44 + 0.051, 0.15, 0.15, 0.25, 0.25, 3.5, 0, 0 #Floor buttons
		CreatePanel , 13, 3, back, %Position%, -4.44 + 0.051, 0.15, 0.15, 0.25, 0.25, 3.5, 0, 0 #Control buttons

			#Buttons
			BtnPanelE26-27(1)

	#Elevator number sign
	DrawWalls = false, true, false, false, false, false
	AddWall ElevNo%elevator%_Inside, IN_ElevNo%elevator%, 0, -0.5 - 0.25, -4.44 + 0.051, -0.5 + 0.25, -4.44 + 0.051, 0.5, 0.5, 7.05, 7.05, 0, 0

	#Indicator sets
	KSS670_PI_InternalInd(back, %Position%, -4.44 + 0.051, 6, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)
	#--------------------
	#Proximity scanner
	Set PSscanHeight = 0.45
	Set PScanWidth = %PSscanHeight% * 0.712
	Set PScanTex = HIDScanRed

	Set ExtraOffset = 0.125

	DrawWalls = false, true, false, false, false, false
	AddWall ProximityScanner, %PScanTex%, 0, %Position% - (%PScanWidth% / 2), -4.44 + 0.051, %Position% + (%PScanWidth% / 2), -4.44 + 0.051, %PSscanHeight%, %PSscanHeight%, 4.75 + %ExtraOffset%, 4.75 + %ExtraOffset%, 0, 0
	#--------------------
	#Shaft components
	DrawWalls = true, true, true, true, true, true
		#Ropes
		RopePosition = 0, 8 + 0.2, 0
		RopeTexture = Ropes
	
		#Counterweight
		Set Position = 3 + 0.8
		CreateCounterweight CWeight_Frame, CWeight, %Position%, 0, 0.5, 6, 2, 0.5
	
		#Rails
		AddRails ElevRail, ElevRailSide, 0, 0, false, 3 + 0.06, 0.1
		AddRails ElevRail, ElevRailSide, %Position%, 0, true, 1 + 0.06, 0.1
<EndElevator>

<Elevators 25 to 27>
	#DETAILED INTERIORS
	#1. Downlights
	DrawWalls = true, false, false, false, false, false
	Set DLOffset = 8 - 0.001 #Offsets for downlights
	AddFloor Downlight1/1, %Prefix%ElevCeilingDL, 0, -1.75 - 0.11, -4.44 + 0.82 - 0.11, -1.75 + 0.11, -4.44 + 0.82 + 0.11, %DLOffset%, %DLOffset%, 0, 0
	AddFloor Downlight1/2, %Prefix%ElevCeilingDL, 0, 1.75 - 0.11, -4.44 + 0.82 - 0.11, 1.75 + 0.11, -4.44 + 0.82 + 0.11, %DLOffset%, %DLOffset%, 0, 0
	AddFloor Downlight2/1, %Prefix%ElevCeilingDL, 0, -1.75 - 0.11, 4.44 - 0.82 - 0.11, -1.75 + 0.11, 4.44 - 0.82 + 0.11, %DLOffset%, %DLOffset%, 0, 0
	AddFloor Downlight2/2, %Prefix%ElevCeilingDL, 0, 1.75 - 0.11, 4.44 - 0.82 - 0.11, 1.75 + 0.11, 4.44 - 0.82 + 0.11, %DLOffset%, %DLOffset%, 0, 0

	#2. Ceiling trims
	CreateWallBox2 elevator, E%elevator%_TrimMid, %Prefix%ElevCeilingTrim, 0, 0, 5.6, 5.6, 0.04, 8 - 0.04, 0, 0, false, true, true, true

	#3. Panels on walls
	Set WPTex = %Prefix%ElevWallPanel
	Set WPanelHeight = 3.25

		#Left panel
		CreateWallBox2 elevator, Panel_L1, %WPTex%, -2.8 + 0.01, 0, 0.02, 9.28 - 0.4, %WPanelHeight%, 0, 0, 0, false, true, true, true

		#Right panel
		CreateWallBox2 elevator, Panel_R1, %WPTex%, 2.8 - 0.01, 0, 0.02, 9.28 - 0.4, %WPanelHeight%, 0, 0, 0, false, true, true, true

		#Front/back panel
		if[%elevator% < 27] CreateWallBox2 elevator, Panel_F1, %WPTex%, 0, -4.44 + 0.01, 6 - 0.4 - 0.04, 0.02, %WPanelHeight%, 0, 0, 0, false, true, true, true
		if[%elevator% = 27] CreateWallBox2 elevator, Panel_B1, %WPTex%, 0, 4.44 - 0.01, 6 - 0.4 - 0.04, 0.02, %WPanelHeight%, 0, 0, 0, false, true, true, true
<EndElevators>

##--------------------------------------------------------------------------------##

#T2T FLOOR SIGNS
<Textures>
	#Floor signs (Elevator lobby)
	Load data/graygradient.jpg, ELFlrSignBack, 1, 1, false #1st and 14th-16th floors
	Load data/Melvin/ABH_Tex/NewFS256/FloorSignBack_Monica.png, ELFlrSignBack2, 1, 1, false #39th-40th floors

	AddText ELFlrSignBack, ELFlrSign1, nimbus_sans_bold.ttf, 128, 1, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddTextRange 11, 16, ELFlrSignBack, ELFlrSign%number%, nimbus_sans_bold.ttf, 128, %number%, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddTextRange 39, 40, ELFlrSignBack2, ELFlrSign%number%, nimbus_sans_condensed.ttf, 130, %number%, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddText ELFlrSignBack, ELFlrSign41, nimbus_sans_bold.ttf, 128, 41, -1, -1, -1, -1, center, center, 0, 0, 0, false

	#Floor signs (Stairwells)
	AddTextRange 1, 2, Blank, BlankSignB%number%, nimbus_sans_bold.ttf, 72, B%number%, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddTextRange 1, 3, Blank, BlankSign%number%, nimbus_sans_bold.ttf, 72, %number%, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddTextRange 7, 42, Blank, BlankSign%number%, nimbus_sans_bold.ttf, 72, %number%, -1, -1, -1, -1, center, center, 0, 0, 0, false

	AddText Blank, BlankSign4A, nimbus_sans_bold.ttf, 72, 4A, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddText Blank, BlankSign4B, nimbus_sans_bold.ttf, 72, 4B, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddText Blank, BlankSign5, nimbus_sans_bold.ttf, 72, 5, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddText Blank, BlankSign6A, nimbus_sans_bold.ttf, 72, 6A, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddText Blank, BlankSign6B, nimbus_sans_bold.ttf, 72, 6B, -1, -1, -1, -1, center, center, 0, 0, 0, false

	AddTextRange 7, 8, Blank, BlankSign%number%A, nimbus_sans_bold.ttf, 72, %number%A, -1, -1, -1, -1, center, center, 0, 0, 0, false
	AddText Blank, BlankSign41A, nimbus_sans_bold_condensed.ttf, 65, 41A, -1, -1, -1, -1, center, center, 0, 0, 0, false
<EndTextures>

##--------------------------------------------------------------------------------##

#HALL STATIONS
#Set textures (Passenger elevators)
<Function ElevHallTex>
	TexPrefix() #Set prefixes for shaft doors
	if[%floor% = 0]  Set 5 = HotelEntrance #Override

	#Shaft doors
	Set DoorTexture = %5%ShaftDoors

	#Use automatic filler walls or not
	Set AutoFiller = false

	#Door trims
		#Sides
		Set DoorTrimTexture = %DoorTexture%_Trim

		#Top
		Set DoorTrimTexture_Top = %DoorTrimTexture%

	#Deco dimensions
		Set SideDecoH = %height%
		Set TopDecoH = %height% - 7

		if[%floor% < 0] Set SideDecoH = 7.2 #Parking levels
		if[%floor% < 0] Set TopDecoH = 0.2
		if[%floor% > 0 & %floor% < 17] Set SideDecoH = 7.2
		if[%floor% > 0 & %floor% < 17] Set TopDecoH = 0.2

		if[%floor% > 19 & %floor% < 42] Set SideDecoH = 8 #Hotel levels
		if[%floor% > 19 & %floor% < 42] Set TopDecoH = %SideDecoH% - 7

	#Call button panels
	Set BPanelTexture = ElevExtPanels
	Set ButtonPrefix = Button

	#Lantern panels
	Set LPanelTexture = %BPanelTexture%
	Set LanternPrefix = Lantern

		#Lateral offset for lantern panels
		Set ExtraLateralOffset = 0.05
		if[%floor% = -1] Set ExtraLateralOffset = 0
		if[%floor% > 0 & %floor% < 17] Set ExtraLateralOffset = 0
<EndFunction>

#****************************************#

#Parking Elevators
<Function E1-8HallStation>
	#Shaft Doors
	ElevHallTex() #Set shaft door and panel textures
	
		#Elevators 1-4
		Set StartNo = 1 #Number of the first elevator
		Set IDP-ShaftDoors = 4.84 + 0.3 #IDP = Initial door position
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo%, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 1, 0.75, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, -2.25 + (2.25 * 2), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo%, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 1, 0.75, -2.25, %IDP-ShaftDoors%, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo%, 1, %AutoFiller%, false
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 1, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 1, 0.75, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, -2.25 + (2.25 * 2), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 1, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 1, 0.75, -2.25, %IDP-ShaftDoors%, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 2, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 1, 0.75, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, -2.25 + (2.25 * 2), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 2, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 1, 0.75, -2.25, %IDP-ShaftDoors%, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 2, 1, %AutoFiller%, false
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 3, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 1, 0.75, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, -2.25 + (2.25 * 2), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 3, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 1, 0.75, -2.25, %IDP-ShaftDoors%, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 3, 1, %AutoFiller%, false
	
		#Elevators 5-8
		Set StartNo = 5 #Number of the first elevator
		Set IDP-ShaftDoors = -4.84 - 0.3 #IDP = Initial door position

		WallOrientation = right
		AddShaftDoorComponent %StartNo%, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 1, 0.75, -2.25, %IDP-ShaftDoors%, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo%, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 1, 0.75, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, -2.25 + (2.25 * 2), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo%, 1, %AutoFiller%, false
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 1, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 1, 0.75, -2.25, %IDP-ShaftDoors%, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 1, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 1, 0.75, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, -2.25 + (2.25 * 2), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 2, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 1, 0.75, -2.25, %IDP-ShaftDoors%, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 2, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 1, 0.75, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, -2.25 + (2.25 * 2), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 2, 1, %AutoFiller%, false
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 3, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 1, 0.75, -2.25, %IDP-ShaftDoors%, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 3, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 1, 0.75, -2.25 + (2.25 * 1), %IDP-ShaftDoors%, -2.25 + (2.25 * 2), %IDP-ShaftDoors%, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 3, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(1, 1, 18 - 4.5, 18 + 4.5, 5.67 - 0.53, 5.67 - 0.33, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(2, 1, 6 - 4.5, 6 + 4.5, 5.67 - 0.53, 5.67 - 0.33, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(3, 1, -6 - 4.5, -6 + 4.5, 5.67 - 0.53, 5.67 - 0.33, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(4, 1, -18 - 4.5, -18 + 4.5, 5.67 - 0.53, 5.67 - 0.33, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)

	AddShaftTrack(5, 2, 18 - 4.5, 18 + 4.5, -5.67 + 0.33, -5.67 + 0.53, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(6, 2, 6 - 4.5, 6 + 4.5, -5.67 + 0.33, -5.67 + 0.53, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(7, 2, -6 - 4.5, -6 + 4.5, -5.67 + 0.33, -5.67 + 0.53, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(8, 2, -18 - 4.5, -18 + 4.5, -5.67 + 0.33, -5.67 + 0.53, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)

	#****************************************#

	#Door trims/fillers
	TexPrefix() #Set filler walls' textures to match with shaft walls
	Set Shaft1CX = -150 #1st shaft for elevator bank
	Set Shaft1CZ = -124
	Set Shaft2CX = -150 #2nd shaft for elevator bank
	Set Shaft2CZ = -96 - 5

		#PARKING LEVELS
			#Elevators 1-4
			WallOrientation = right
			if[%floor% < 17 & %floor% ! 0] AddFillerWalls %5%%5L%, 0.66, %Shaft1CX% + 18, %Shaft1CZ% + 6, 4.5, 7, %interfloorheight%, true, 0, 0, true #Elevator 1
			if[%floor% < 17 & %floor% ! 0] AddFillerWalls %5%%5L%, 0.66, %Shaft1CX% + 6, %Shaft1CZ% + 6, 4.5, 7, %interfloorheight%, true, 0, 0, true
			if[%floor% < 17 & %floor% ! 0] AddFillerWalls %5%%5L%, 0.66, %Shaft1CX% - 6, %Shaft1CZ% + 6, 4.5, 7, %interfloorheight%, true, 0, 0, true
			if[%floor% < 17 & %floor% ! 0] AddFillerWalls %5%%5L%, 0.66, %Shaft1CX% - 18, %Shaft1CZ% + 6, 4.5, 7, %interfloorheight%, true, 0, 0, true
	
			#Elevators 5-8
			WallOrientation = left
			if[%floor% < 17 & %floor% ! 0] AddFillerWalls %5%%5L%, 0.66, %Shaft2CX% + 18, %Shaft2CZ% - 6, 4.5, 7, %interfloorheight%, true, 0, 0, true #Elevator 4
			if[%floor% < 17 & %floor% ! 0] AddFillerWalls %5%%5L%, 0.66, %Shaft2CX% + 06, %Shaft2CZ% - 6, 4.5, 7, %interfloorheight%, true, 0, 0, true
			if[%floor% < 17 & %floor% ! 0] AddFillerWalls %5%%5L%, 0.66, %Shaft2CX% - 06, %Shaft2CZ% - 6, 4.5, 7, %interfloorheight%, true, 0, 0, true
			if[%floor% < 17 & %floor% ! 0] AddFillerWalls %5%%5L%, 0.66, %Shaft2CX% - 18, %Shaft2CZ% - 6, 4.5, 7, %interfloorheight%, true, 0, 0, true

		#LOBBY LEVELS
			#Elevators 1-4
			if[%floor% = 0 | %floor% = 17] AddDecoObject(Elev1_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + 18, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
			if[%floor% = 0 | %floor% = 17] AddDecoObject(Elev2_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + 6, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
			if[%floor% = 0 | %floor% = 17] AddDecoObject(Elev3_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% - 6, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
			if[%floor% = 0 | %floor% = 17] AddDecoObject(Elev4_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% - 18, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
	
			#Elevators 5-8
			if[%floor% = 0 | %floor% = 17] AddDecoObject(Elev5_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, front, true, false, 0.05, 0.2, %Shaft2CX% + 18, %Shaft2CZ% - 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
			if[%floor% = 0 | %floor% = 17] AddDecoObject(Elev6_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, front, true, false, 0.05, 0.2, %Shaft2CX% + 6, %Shaft2CZ% - 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
			if[%floor% = 0 | %floor% = 17] AddDecoObject(Elev7_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, front, true, false, 0.05, 0.2, %Shaft2CX% - 6, %Shaft2CZ% - 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
			if[%floor% = 0 | %floor% = 17] AddDecoObject(Elev8_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, front, true, false, 0.05, 0.2, %Shaft2CX% - 18, %Shaft2CZ% - 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)

	#****************************************#

	#Call buttons
	CallButtonElevators = 1, 2, 3, 4, 5, 6, 7, 8
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% - 12, %Shaft1CZ% + 6.001, 4 - 0.4, back, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 12, %Shaft1CZ% + 6.001, 4 - 0.4, back, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft2CX% - 12, %Shaft2CZ% - 6.001, 4 - 0.4, front, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft2CX% + 12, %Shaft2CZ% - 6.001, 4 - 0.4, front, 0.4, 0.8, true, 0, 0

		#Signs
		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		if[%floor% ! 0 & %floor% ! 17] AddBoxSign(E1-8_FS1, Blank, BlankSign%floorid%, Blank, 0, true, false, false, %Shaft1CX% - 12, %Shaft1CZ% + 6.001, 1.5, 1.5, 6.5 - 0.75 + %interfloorheight%, true)
		if[%floor% ! 0 & %floor% ! 17] AddBoxSign(E1-8_FS2, Blank, BlankSign%floorid%, Blank, 0, true, false, false, %Shaft1CX% + 12, %Shaft1CZ% + 6.001, 1.5, 1.5, 6.5 - 0.75 + %interfloorheight%, true)

		if[%floor% = 0 | %floor% = 17] AddBoxSign(E1-8_FS1, Blank, ELFlrSign%floorid%, Blank, 0, true, false, false, %Shaft1CX% - 12, %Shaft1CZ% + 6.001, 1, 1, 5.5 + %interfloorheight%, true)
		if[%floor% = 0 | %floor% = 17] AddBoxSign(E1-8_FS2, Blank, ELFlrSign%floorid%, Blank, 0, true, false, false, %Shaft1CX% + 12, %Shaft1CZ% + 6.001, 1, 1, 5.5 + %interfloorheight%, true)

		AddWall E1-8_HS1, ElevHallSign, 0, %Shaft1CX% + 12 - 0.25, %Shaft1CZ% + 6.001, %Shaft1CX% + 12 + 0.25, %Shaft1CZ% + 6.001, 0.75, 0.75, 2.6, 2.6, 0, 0, false

		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		if[%floor% ! 0 & %floor% ! 17] AddBoxSign(E1-6_FS3, BlankSign%floorid%, Blank, Blank, 0, true, false, false, %Shaft2CX% - 12, %Shaft2CZ% - 6.001, 1.5, 1.5, 6.5 - 0.75 + %interfloorheight%, true)
		if[%floor% ! 0 & %floor% ! 17] AddBoxSign(E1-6_FS4, BlankSign%floorid%, Blank, Blank, 0, true, false, false, %Shaft2CX% + 12, %Shaft2CZ% - 6.001, 1.5, 1.5, 6.5 - 0.75 + %interfloorheight%, true)
        
		if[%floor% = 0 | %floor% = 17] AddBoxSign(E1-6_FS3, ELFlrSign%floorid%, Blank, Blank, 0, true, false, false, %Shaft2CX% - 12, %Shaft2CZ% - 6.001, 1, 1, 5.5 + %interfloorheight%, true)
		if[%floor% = 0 | %floor% = 17] AddBoxSign(E1-6_FS4, ELFlrSign%floorid%, Blank, Blank, 0, true, false, false, %Shaft2CX% + 12, %Shaft2CZ% - 6.001, 1, 1, 5.5 + %interfloorheight%, true)

		AddWall E1-8_HS2, ElevHallSign, 0, %Shaft2CX% + 12 - 0.25, %Shaft2CZ% - 6.001, %Shaft2CX% + 12 + 0.25, %Shaft2CZ% - 6.001, 0.75, 0.75, 2.6, 2.6, 0, 0, false

	#****************************************#

	#Indicator sets
	Set Offset = 7.5

		#Set textures
		KSS670_PI_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)

		#Indicator creation (Lobby)
		if[%floor% = 0] KSS670_PI_LobbyInds(back, 1, %Shaft1CX% + 18, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% = 0] KSS670_PI_LobbyInds(back, 2, %Shaft1CX% + 6, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% = 0] KSS670_PI_LobbyInds(back, 3, %Shaft1CX% - 6, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% = 0] KSS670_PI_LobbyInds(back, 4, %Shaft1CX% - 18, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, -2, 17)

		if[%floor% = 0] KSS670_PI_LobbyInds(front, 5, %Shaft2CX% + 18, %Shaft2CZ% - 6 - %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% = 0] KSS670_PI_LobbyInds(front, 6, %Shaft2CX% + 6, %Shaft2CZ% - 6 - %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% = 0] KSS670_PI_LobbyInds(front, 7, %Shaft2CX% - 6, %Shaft2CZ% - 6 - %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% = 0] KSS670_PI_LobbyInds(front, 8, %Shaft2CX% - 18, %Shaft2CZ% - 6 - %ExtraLateralOffset%, %Offset%, -2, 17)

		#Indicator creation (All other floors)
		if[%floor% ! 0] KSS670_PI_LobbyLanterns(back, 1, %Shaft1CX% + 18, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% ! 0] KSS670_PI_LobbyLanterns(back, 2, %Shaft1CX% + 6, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% ! 0] KSS670_PI_LobbyLanterns(back, 3, %Shaft1CX% - 6, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% ! 0] KSS670_PI_LobbyLanterns(back, 4, %Shaft1CX% - 18, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, -2, 17)

		if[%floor% ! 0] KSS670_PI_LobbyLanterns(front, 5, %Shaft2CX% + 18, %Shaft2CZ% - 6 - %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% ! 0] KSS670_PI_LobbyLanterns(front, 6, %Shaft2CX% + 6, %Shaft2CZ% - 6 - %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% ! 0] KSS670_PI_LobbyLanterns(front, 7, %Shaft2CX% - 6, %Shaft2CZ% - 6 - %ExtraLateralOffset%, %Offset%, -2, 17)
		if[%floor% ! 0] KSS670_PI_LobbyLanterns(front, 8, %Shaft2CX% - 18, %Shaft2CZ% - 6 - %ExtraLateralOffset%, %Offset%, -2, 17)
<EndFunction>

#Hall station creation
<Floors -2 to 13>
	E1-8HallStation()
<EndFloors>

<Floor 17>
	E1-8HallStation()
<EndFloor>

#****************************************#

<Break>

#Low Zone Elevators (17-24)
<Floors 17 to 27>
	#Shaft Doors
	ElevHallTex() #Set shaft door and panel textures
	Set StartNo = 9 #Number of the first elevator

		#Elevators 9-11
		Set ElevDoorTex = %Prefix%ElevDoors
		Set IDP = 3 + 0.3
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo%, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo%, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo%, 1, %AutoFiller%, false
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 1, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 1, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 2, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 2, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 2, 1, %AutoFiller%, false
	
		#Elevators 12-14
		Set StartNo = 12 #Number of the first elevator
		Set IDP = -3 - 0.3
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo%, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo%, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo%, 1, %AutoFiller%, false
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 1, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 1, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 2, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 2, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 2, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(9, 4, 4.14, 4.34, -10 - 4, -10 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(10, 4, 4.14, 4.34, 0 - 4, 0 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(11, 4, 4.14, 4.34, 10 - 4, 10 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)

	AddShaftTrack(12, 5, -4.34, -4.14, -10 - 4, -10 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(13, 5, -4.34, -4.14, 0 - 4, 0 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(14, 5, -4.34, -4.14, 10 - 4, 10 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)

	#****************************************#

	#Door trims/fillers
	Set Shaft1CX = -120 #1st shaft for elevator bank
	Set Shaft1CZ = 30

		AddDecoObject(Elev9_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, right, true, false, 0.05, 0.2, %Shaft1CX% + 5, %Shaft1CZ% - 10, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev10_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, right, true, false, 0.05, 0.2, %Shaft1CX% + 5, %Shaft1CZ%, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev11_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, right, true, false, 0.05, 0.2, %Shaft1CX% + 5, %Shaft1CZ% + 10, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)

	Set Shaft2CX = -100 #2nd shaft for elevator bank
	Set Shaft2CZ = 30

		AddDecoObject(Elev12_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft2CX% - 5, %Shaft2CZ% - 10, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev13_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft2CX% - 5, %Shaft2CZ%, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev14_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft2CX% - 5, %Shaft2CZ% + 10, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)

	#****************************************#

	#Call buttons
	CallButtonElevators = 9, 10, 11, 12, 13, 14
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 5.001, %Shaft1CZ% - 5, 4 - 0.4, right, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 5.001, %Shaft1CZ% + 5, 4 - 0.4, right, 0.4, 0.8, true, 0, 0

	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft2CX% - 5.001, %Shaft2CZ% - 5, 4 - 0.4, left, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft2CX% - 5.001, %Shaft2CZ% + 5, 4 - 0.4, left, 0.4, 0.8, true, 0, 0

		#Floor signs
		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		
			#Blank signs (Floors with bright-colored walls)
			if[%floor% > 19 & %floor% < 42] AddBoxSign(HotelLZ_FS1/1, Blank, BlankSign%floorid%, Blank, 0, false, false, false, %Shaft1CX% + 5.001, %Shaft1CZ% - 5, 1.5, 1.5, 6.5 - 0.75, false)
			if[%floor% > 19 & %floor% < 42] AddBoxSign(HotelLZ_FS1/2, Blank, BlankSign%floorid%, Blank, 0, false, false, false, %Shaft1CX% + 5.001, %Shaft1CZ% + 5, 1.5, 1.5, 6.5 - 0.75, false)
	
			#Signs with background (Floors with dark-colored walls)
			if[%floor% < 20 | %floor% > 41] AddBoxSign(HotelLZ_FS1/1, Blank, ELFlrSign%floorid%, Blank, 0, false, false, false, %Shaft1CX% + 5.001, %Shaft1CZ% - 5, 1, 1, 5.5, false)
			if[%floor% < 20 | %floor% > 41] AddBoxSign(HotelLZ_FS1/2, Blank, ELFlrSign%floorid%, Blank, 0, false, false, false, %Shaft1CX% + 5.001, %Shaft1CZ% + 5, 1, 1, 5.5, false)

		WallOrientation = right
		DrawWalls = true, false, false, false, false, false

			#Blank signs (Floor with bright-colored walls)
			if[%floor% > 19 & %floor% < 42] AddBoxSign(HotelLZ_FS2/1, BlankSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft2CX% - 5.001, %Shaft2CZ% - 5, 1.5, 1.5, 6.5 - 0.75, false)
			if[%floor% > 19 & %floor% < 42] AddBoxSign(HotelLZ_FS2/2, BlankSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft2CX% - 5.001, %Shaft2CZ% + 5, 1.5, 1.5, 6.5 - 0.75, false)
	
			#Signs with background (Floors with dark-colored walls)
			if[%floor% < 20 | %floor% > 41] AddBoxSign(HotelLZ_FS2/1, ELFlrSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft2CX% - 5.001, %Shaft2CZ% - 5, 1, 1, 5.5, false)
			if[%floor% < 20 | %floor% > 41] AddBoxSign(HotelLZ_FS2/2, ELFlrSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft2CX% - 5.001, %Shaft2CZ% + 5, 1, 1, 5.5, false)

		#"In case of fire" signs
		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		AddWall HotelLZ_HS1/1, ElevHallSign, 0, %Shaft1CX% + 5.001, %Shaft1CZ% - 5 - 0.25, %Shaft1CX% + 5.001, %Shaft1CZ% - 5 + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false
		#AddWall HotelLZ_HS1/2, ElevHallSign, 0, %Shaft1CX% + 5.001, %Shaft1CZ% + 5 - 0.25, %Shaft1CX% + 5.001, %Shaft1CZ% + 5 + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false

		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		AddWall HotelLZ_HS2/1, ElevHallSign, 0, %Shaft2CX% - 5.001, %Shaft2CZ% - 5 - 0.25, %Shaft2CX% - 5.001, %Shaft2CZ% - 5 + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false
		#AddWall HotelLZ_HS2/2, ElevHallSign, 0, %Shaft2CX% - 5.001, %Shaft2CZ% + 5 - 0.25, %Shaft2CX% - 5.001, %Shaft2CZ% + 5 + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false

	#****************************************#

	#Indicator sets
	Set Offset = 7.5
	if[%floor% > 19 & %floor% < 42] Set Offset = 7.25

		#Set textures
		KSS670_PI_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)

		#Indicator creation (Hotel lobby)
		if[%floor% = 17] KSS670_PI_LobbyInds(right, 9, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% - 10, %Offset%, 17, 27)
		if[%floor% = 17] KSS670_PI_LobbyInds(right, 10, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ%, %Offset%, 17, 27)
		if[%floor% = 17] KSS670_PI_LobbyInds(right, 11, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% + 10, %Offset%, 17, 27)

		if[%floor% = 17] KSS670_PI_LobbyInds(left, 12, %Shaft2CX% - 5 - %ExtraLateralOffset%, %Shaft2CZ% - 10, %Offset%, 17, 27)
		if[%floor% = 17] KSS670_PI_LobbyInds(left, 13, %Shaft2CX% - 5 - %ExtraLateralOffset%, %Shaft2CZ%, %Offset%, 17, 27)
		if[%floor% = 17] KSS670_PI_LobbyInds(left, 14, %Shaft2CX% - 5 - %ExtraLateralOffset%, %Shaft2CZ% + 10, %Offset%, 17, 27)

		#Indicator creation (Other floors)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(right, 9, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% - 10, %Offset%, 17, 27)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(right, 10, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ%, %Offset%, 17, 27)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(right, 11, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% + 10, %Offset%, 17, 27)

		if[%floor% ! 17] KSS670_PI_LobbyLanterns(left, 12, %Shaft2CX% - 5 - %ExtraLateralOffset%, %Shaft2CZ% - 10, %Offset%, 17, 27)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(left, 13, %Shaft2CX% - 5 - %ExtraLateralOffset%, %Shaft2CZ%, %Offset%, 17, 27)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(left, 14, %Shaft2CX% - 5 - %ExtraLateralOffset%, %Shaft2CZ% + 10, %Offset%, 17, 27)
<EndFloors>

