		AddTextRange 7, 41, Button, Button%number%, nimbus_sans.ttf, 45, %number%, -1, -1, -1, -1, center, center, 163, 163, 163, false
		AddTextRange 1, 3, ButtonLit, ButtonLit%number%, nimbus_sans.ttf, 45, %number%, -1, -1, -1, -1, center, center, 253, 145, 22, false
		AddTextRange 7, 41, ButtonLit, ButtonLit%number%, nimbus_sans.ttf, 45, %number%, -1, -1, -1, -1, center, center, 253, 145, 22, false

		AddText Button, Button4A, nimbus_sans.ttf, 45, 4A, -1, -1, -1, -1, center, center, 163, 163, 163, false
		AddText Button, Button4B, nimbus_sans.ttf, 45, 4B, -1, -1, -1, -1, center, center, 163, 163, 163, false
		AddText Button, Button5, nimbus_sans.ttf, 45, 5, -1, -1, -1, -1, center, center, 163, 163, 163, false
		AddText Button, Button6A, nimbus_sans.ttf, 45, 6A, -1, -1, -1, -1, center, center, 163, 163, 163, false
		AddText Button, Button6B, nimbus_sans.ttf, 45, 6B, -1, -1, -1, -1, center, center, 163, 163, 163, false

		AddText ButtonLit, ButtonLit4A, nimbus_sans.ttf, 45, 4A, -1, -1, -1, -1, center, center, 253, 145, 22, false
		AddText ButtonLit, ButtonLit4B, nimbus_sans.ttf, 45, 4B, -1, -1, -1, -1, center, center, 253, 145, 22, false
		AddText ButtonLit, ButtonLit5, nimbus_sans.ttf, 45, 5, -1, -1, -1, -1, center, center, 253, 145, 22, false
		AddText ButtonLit, ButtonLit6A, nimbus_sans.ttf, 45, 6A, -1, -1, -1, -1, center, center, 253, 145, 22, false
		AddText ButtonLit, ButtonLit6B, nimbus_sans.ttf, 45, 6B, -1, -1, -1, -1, center, center, 253, 145, 22, false

		AddTextRange 7, 8, Button, Button%number%A, nimbus_sans.ttf, 45, %number%A, -1, -1, -1, -1, center, center, 163, 163, 163, false
		AddTextRange 7, 8, ButtonLit, ButtonLit%number%A, nimbus_sans.ttf, 45, %number%A, -1, -1, -1, -1, center, center, 253, 145, 22, false
	
		#Lanterns
		Load data/MT/LanternUnlit.gif, LanternUp, 1, 1, false
		Load data/MT/LanternLit.gif, LanternUpLit, 1, 1, false
		Load data/MT/LanternUnlit.gif, LanternDown, 1, -1, false
		Load data/MT/LanternLit.gif, LanternDownLit, 1, -1, false

		#Inside arrows
		Load data/MT/blank.gif, ArrowUp, 1, 1, false
		Load data/Melvin/KSS670_PI/Arrow-LitOrange.png, ArrowUpLit, 1, 1, false
		ScrollAnim ArrowUpLit, 0, 1
		Load data/MT/blank.gif, ArrowDown, 1, 1, false
		Load data/Melvin/KSS670_PI/Arrow-LitOrange-Down.png, ArrowDownLit, 1, 1, false
		ScrollAnim ArrowDownLit, 0, -1

		#Floor indicators (Inside) - Font created by Test Tower
		Load data/Melvin/KSS670_PI/Black_KoneInd.jpg, IndBack, 1, 1, false
		AddTextRange 1, 2, IndBack, Ind_ButtonB%number%, kone_ecodisc.ttf, 120, B%number%, 0, 0, 256, 256, center, center, 255, 106, 0, false
		AddTextRange 1, 3, IndBack, Ind_Button%number%, kone_ecodisc.ttf, 120, %number%, 0, 0, 256, 256, center, center, 255, 106, 0, false
		AddTextRange 7, 41, IndBack, Ind_Button%number%, kone_ecodisc.ttf, 120, %number%, 0, 0, 256, 256, center, center, 255, 106, 0, false

		AddText IndBack, Ind_Button4A, kone_ecodisc.ttf, 120, 4A, 0, 0, 256, 256, center, center, 255, 106, 0, false
		AddText IndBack, Ind_Button4B, kone_ecodisc.ttf, 120, 4B, 0, 0, 256, 256, center, center, 255, 106, 0, false
		AddText IndBack, Ind_Button5, kone_ecodisc.ttf, 120, 5, 0, 0, 256, 256, center, center, 255, 106, 0, false
		AddText IndBack, Ind_Button6A, kone_ecodisc.ttf, 120, 6A, 0, 0, 256, 256, center, center, 255, 106, 0, false
		AddText IndBack, Ind_Button6B, kone_ecodisc.ttf, 120, 6B, 0, 0, 256, 256, center, center, 255, 106, 0, false

		AddTextRange 7, 8, IndBack, Ind_Button%number%A, kone_ecodisc.ttf, 120, %number%A, 0, 0, 256, 256, center, center, 255, 106, 0, false

	##############################

	#Elevator number signs (Inside)
	Load data/Melvin/transparent128.png, IN_ElevNoBack, 1, 1, false
	AddTextRange 1, 8, IN_ElevNoBack, IN_ElevNo%number%, nimbus_sans_bold.ttf, 55, %number%, -1, -1, -1, -1, center, center, 0, 255, 255, false
	AddTextRange 9, 14, IN_ElevNoBack, IN_ElevNo%number%, nimbus_sans_bold.ttf, 55, %number%, -1, -1, -1, -1, center, center, 0, 255, 0, false
	AddTextRange 15, 24, IN_ElevNoBack, IN_ElevNo%number%, nimbus_sans_bold.ttf, 55, %number%, -1, -1, -1, -1, center, center, 0, 255, 255, false
	AddTextRange 25, 27, IN_ElevNoBack, IN_ElevNo%number%, nimbus_sans_bold.ttf, 55, %number%, -1, -1, -1, -1, center, center, 0, 0, 0, false
<EndTextures>

