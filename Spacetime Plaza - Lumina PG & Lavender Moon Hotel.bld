	AddFloor LMH_%floorid%F_SouthRoof, RoofFloor2, 0.5, -%1%, -%2%, -%1% + 200, %2% - 200, %interfloorheight%, %interfloorheight%, 0, 0, true

	#Railings
	Set WallHeight = %interfloorheight% + 5.5
	Set WallOffset = 0

		DrawWalls = true, true, true, true, true, false

		WallOrientation = left
		AddWall FrontWallA, ExtFacade, 0.5, -%1% + 0.5, -%2%, -%1% + 200 + 80 - 0.5, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall FrontWallB, ExtFacade, 0.5, -%1% + 200 + 80, 5, 79.5 - 0.5, 5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall LeftWall, ExtFacade, 0.5, -%1%, -%2%, -%1%, %2% - 200, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		WallOrientation = right
		#AddWall RightWall, ExtFacade, 0.5, -%1% + 200 + 80, -%2%, -%1% + 200 + 80, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall RightWallA, ExtFacade, 0.5, -%1% + 200 + 80, -%2%, -%1% + 200 + 80, 5 + 0.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall RightWallB, ExtFacade, 0.5, 79.5, 5, 79.5, 55 - 25, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall RightWallC, ExtFacade, 0.5, -%1% + 200 + 80, 55, -%1% + 200 + 80, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall BackWall, ExtFacade, 0.5, -%1% + 200, %2%, -%1% + 200 + 80 - 0.5, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
<EndFloor>

#Topside mechanical
<Floors 44 to 45>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	if[%floor% = 44] AddFloor TopMechFlr, %5%Floor, 0.5, -%1%, %2% - 200, -%1% + 200, %2%, %interfloorheight%, %interfloorheight%, 0, 0, true

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 45] AddFloor TopMechCeil, %5%Ceiling, 0.5, -%1%, %2% - 200, -%1% + 200, %2%, %fullheight%, %fullheight%, 0, 0, true

	#Perimeter walls
	TexPrefix() #Set texture prefix/suffix
	Set WallHeight = %fullheight%
	Set WallOffset = 0

		DrawWalls = true, true, false, false, false, false

		WallOrientation = left
		TextureOverride ExtFacade, %5%Wall, Blank, Blank, Blank, Blank
		AddWall FrontWall, %5%Wall, 0.5, -%1%, %2% - 200, -%1% + 200, %2% - 200, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade, %5%Wall, Blank, Blank, Blank, Blank
		AddWall LeftWall, %5%Wall, 0.5, -%1%, %2% - 200, -%1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = right
		TextureOverride %5%Wall, ExtFacade, Blank, Blank, Blank, Blank
		AddWall RightWall, %5%Wall, 0.5, -%1% + 200, %2% - 200, -%1% + 200, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride %5%Wall, ExtFacade, Blank, Blank, Blank, Blank
		AddWall BackWall, %5%Wall, 0.5, -%1%, %2%, -%1% + 200, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
<EndFloors>

<Floor 45>
	Set MM_CenterX = -110
	Set MM_CenterZ = 30
	
	#Mechanical Mezzanine
	FloorOrientation = top
	DrawWalls = true, true, false, false, false, false
	TextureOverride MMEUnderside, MMEFloor, Blank, Blank, Blank, Blank
	AddFloor MechFloor, MMEFloor, %interfloorheight%, %MM_CenterX% - 55, %MM_CenterZ% - 25, %MM_CenterX% + 35, %MM_CenterZ% + 35, 0, 0, 0, 0, false

	#Railings
	DrawWalls = true, true, true, true, true, false
	Set WallHeight = %interfloorheight% + 3.5
	Set WallOffset = -%interfloorheight%

	WallOrientation = left
	AddWall MMERail_West, MMEWall, 0.5, %MM_CenterX% - 55, %MM_CenterZ% - 25, %MM_CenterX% - 55, %MM_CenterZ% + 35, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	AddWall MMERail_South1, MMEWall, 0.5, %MM_CenterX% - 55 + 0.5, %MM_CenterZ% - 25, %MM_CenterX% - 45, %MM_CenterZ% - 25, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	AddWall MMERail_South2, MMEWall, 0.5, %MM_CenterX% - 25, %MM_CenterZ% - 25, %MM_CenterX% + 25, %MM_CenterZ% - 25, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

	WallOrientation = right
	AddWall MMERail_East1, MMEWall, 0.5, %MM_CenterX% + 35, %MM_CenterZ% - 13, %MM_CenterX% + 35, %MM_CenterZ%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	AddWall MMERail_East2, MMEWall, 0.5, %MM_CenterX% + 35, %MM_CenterZ% + 25, %MM_CenterX% + 35, %MM_CenterZ% + 35, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	AddWall MMERail_North, MMEWall, 0.5, %MM_CenterX% - 55 + 0.5, %MM_CenterZ% + 35, %MM_CenterX% + 35 - 0.5, %MM_CenterZ% + 35, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
<EndFloor>

#Rooftop
<Floor 46>
	#Roof floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor LMH_Roof, RoofFloor, 0.5, -%1%, %2% - 200, -%1% + 200, %2%, %interfloorheight%, %interfloorheight%, 0, 0, true

		#Elevator machine room
		CreateFlr(EMRFloor, ElevMRIntFloor, 0.5, -145, 30, -135, 55, 0, true)

	#Elevator machine room enclosures
		#Ceiling
		FloorOrientation = bottom
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevMRIntCeiling, ExtFacade, ExtFacade, ExtFacade, ExtFacade, ExtFacade
		AddFloor EMRCeiling, ElevMRIntCeiling, 1.5, -145, 5, -135, 55, %fullheight%, %fullheight%, 0, 0, true
	
		#Walls
		WallOrientation = left
		DrawWalls = true, true, false, false, false, false
		TextureOverride ExtFacade, ElevMRIntWall, ExtFacade, ExtFacade, ExtFacade, ExtFacade
		AddWall EMRLeft, ExtFacade, 0.5, -145, 30, -145, 43, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true

		WallOrientation = right
		TextureOverride ElevMRIntWall, ExtFacade, ExtFacade, ExtFacade, ExtFacade, ExtFacade
		AddWall EMRRight, ExtFacade, 0.5, -135, 30, -135, 43, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true

		#Doors
		Set DTex = ServiceDoor3
		Set DSTex = %DTex%Side
		Set Door_MainX = -135
		Set Door_MainZ = 35

		WallOrientation = right
		AddStdDoor DoorManager, LMH_Roof_EMR_Door1, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddStdDoor DoorManager, LMH_Roof_EMR_Door2, , , false, %DTex%, %DSTex%, 0.2, left, right, 75, 75,  %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

		#Exit signs
		AddBoxSign(LMH_Roof_EMR_Exit, ExitSign, StainlessSteel, StainlessSteel, 0.1, false, true, true, %Door_MainX% - 0.55, %Door_MainZ%, 1.8, 0.9, %interfloorheight% + 7.2, true)

	#Railings
	Set WallHeight = %interfloorheight% + 5.5
	Set WallOffset = 0

		DrawWalls = true, true, true, true, true, false

		WallOrientation = left
		AddWall FrontWall, ExtFacade, 0.5, -%1% + 0.5, %2% - 200, -%1% + 200 - 0.5, %2% - 200, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall LeftWall, ExtFacade, 0.5, -%1%, %2% - 200, -%1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = right
		AddWall RightWall, ExtFacade, 0.5, -%1% + 200, %2% - 200, -%1% + 200, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		AddWall BackWall, ExtFacade, 0.5, -%1% + 0.5, %2%, -%1% + 200 - 0.5, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
<EndFloor>

