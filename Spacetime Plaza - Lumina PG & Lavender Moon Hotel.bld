#Button creation function (Low Zone Elevators)
<Function BtnPanelE15-19>
	Set PanelNumber = %param1%
	Set PanelNumber2 = %PanelNumber% + 1
	Set BtnPrefix = Button

	if[%PanelNumber% = 1] AddButton %PanelNumber2%, , %BtnPrefix%Alarm, %BtnPrefix%Alarm, 1, 1, alarm, 1, 1

	AddButton %PanelNumber%, , %BtnPrefix%32, %BtnPrefix%Lit32, 3, 2, 35, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%31, %BtnPrefix%Lit31, 3, 1, 34, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%30, %BtnPrefix%Lit30, 4, 2, 33, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%29, %BtnPrefix%Lit29, 4, 1, 32, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%28, %BtnPrefix%Lit28, 5, 2, 31, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%27, %BtnPrefix%Lit27, 5, 1, 30, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%26, %BtnPrefix%Lit26, 6, 2, 29, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%25, %BtnPrefix%Lit25, 6, 1, 28, 1, 1

	AddButton %PanelNumber%, , %BtnPrefix%16, %BtnPrefix%Lit16, 7, 2, 19, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%15, %BtnPrefix%Lit15, 7, 1, 18, 1, 1
	AddButton %PanelNumber2%, , %BtnPrefix%14, %BtnPrefix%Lit14, 8, 1, 17, 1, 1

	AddButton %PanelNumber%, , %BtnPrefix%Open, %BtnPrefix%Open, 10, 1, open, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%Close, %BtnPrefix%Close, 10, 2, close, 1, 1
<EndFunction>

