#GLOBAL SETTINGS
<Elevators 1 to 27>
	#Notifications
	NotifyEarly = 1
	if[%elevator% > 8] NotifyEarly = 2
	UpChimeSound 1 = KSS500/koneup.wav #EG881
	DownChimeSound 1 = KSS500/konedown.wav #EG881

	#Other settings
	QueueResets = true
	LevelingOpen = 0.2
	if[%elevator% < 9 | %elevator% > 24] RecallFloor = 0

	#Door settings
	DoorTimer 1 = 15000
	QuickClose 1 = 10000

	#Motor sounds
	MotorStartSound = EG881Sounds/motor_start3.wav #EG881
	MotorRunSound = EG881Sounds/motor_running3.wav #EG881
	MotorStopSound = EG881Sounds/motor_stop3.wav #EG881
<EndElevators>

<Elevators 1 to 8>
