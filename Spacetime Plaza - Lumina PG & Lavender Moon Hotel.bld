		TextureOverride %5S%Wall, ParkingWall, Blank, Blank, Blank, Blank
		AddWall SHA_Back, %5E%Wall, 0.5, %CenterPoint%, %NorthPoint%, %1%, %NorthPoint%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		#Center divider walls
