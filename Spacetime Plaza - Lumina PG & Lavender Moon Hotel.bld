########################################

#Parking elevator lobby walls and doors
<Function LuminaPG_E1-8Lobby>
	TexPrefix() #Set texture prefix/suffix

	#Lobby walls (Elevators 1-8)	
	WallOrientation = left
	TextureOverride %5%Wall, %5%%5L%, Blank, Blank, Blank, Blank
	AddWall E1-8Lobby_West, %5%Wall, 0.5, -174, -118, -174, -107, %height% + 1, %height% + 1, %interfloorheight%, %interfloorheight%, 0, 0, true

	WallOrientation = right
	TextureOverride %5%%5L%, %5%Wall, Blank, Blank, Blank, Blank
	AddWall E1-8Lobby_East, %5%Wall, 0.5, -126, -118, -126, -107, %height% + 1, %height% + 1, %interfloorheight%, %interfloorheight%, 0, 0, true

	########################################

	#Doors to Elevators 1-8
	Set EntireHeight = %height%
	if[%floor% = 1] Set EntireHeight = 10
	Set Texture = BLKEntDoor

		#WEST DOORS (Basements only)
		Set MainX = -174
		Set MainZ = -112.5
		WallOrientation = left
		TextureOverride %Texture%Int, %Texture%Int, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		if[%floor% < 0] AddExternalDoor , , false, %Texture%Int, 0.2, 4, 75, %MainX%, %MainZ% + 1.5, 3, 7, %interfloorheight%, 0, 0
		TextureOverride %Texture%Int, %Texture%Int, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		if[%floor% < 0] AddExternalDoor , , false, %Texture%Int, 0.2, 1, 75, %MainX%, %MainZ% - 1.5, 3, 7, %interfloorheight%, 0, 0

		if[%floor% < 0] AddFillerWalls %5%Wall, 0.5, %MainX%, %MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

		if[%floor% < 0] Add3DWindows(E1-8West_WinTop, %MainX%, %MainZ%, left, 6, %EntireHeight% - 7.5, 7.25, MainWindowsIntB, MainWindowsIntB, %5%%5L%, 0.5, 1/4, 1)
		if[%floor% < 0] Add3DWindows(E1-8West_WinSide1, %MainX%, %MainZ% - 3 - 1.25, left, 2, %EntireHeight% - 0.5, 0.25, MainWindowsIntB, MainWindowsIntB, %5%%5L%, 0.5, 1/4, 1)
		if[%floor% < 0] Add3DWindows(E1-8West_WinSide2, %MainX%, %MainZ% + 3 + 1.25, left, 2, %EntireHeight% - 0.5, 0.25, MainWindowsIntB, MainWindowsIntB, %5%%5L%, 0.5, 1/4, 1)

		#EAST DOORS
		Set MainX = -126
		Set MainZ = -112.5
		WallOrientation = right
		TextureOverride %Texture%Int, %Texture%Int, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%Int, 0.2, 3, 75, %MainX%, %MainZ% + 1.5, 3, 7, %interfloorheight%, 0, 0
		TextureOverride %Texture%Int, %Texture%Int, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%Int, 0.2, 2, 75, %MainX%, %MainZ% - 1.5, 3, 7, %interfloorheight%, 0, 0

		AddFillerWalls %5%Wall, 0.5, %MainX%, %MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

		Add3DWindows(E1-8East_WinTop, %MainX%, %MainZ%, right, 6, %EntireHeight% - 7.5, 7.25, MainWindowsIntB, MainWindowsIntB, %5%%5L%, 0.5, 1/4, 1)
		Add3DWindows(E1-8East_WinSide1, %MainX%, %MainZ% - 3 - 1.25, right, 2, %EntireHeight% - 0.5, 0.25, MainWindowsIntB, MainWindowsIntB, %5%%5L%, 0.5, 1/4, 1)
		Add3DWindows(E1-8East_WinSide2, %MainX%, %MainZ% + 3 + 1.25, right, 2, %EntireHeight% - 0.5, 0.25, MainWindowsIntB, MainWindowsIntB, %5%%5L%, 0.5, 1/4, 1)
<EndFunction>

<Floors -2 to -1>
	LuminaPG_E1-8Lobby()
<EndFloors>

<Floors 1 to 13>
	LuminaPG_E1-8Lobby()
<EndFloors>

########################################

#Middle mechanical
<Floors 14 to 16>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	if[%floor% ! 14] AddFloor MidMechFlr, %5%Floor, 0.5, -%1%, -%2%, %1% - 140, %2%, 0, 0, 0, 0, false
	if[%floor% ! 14] AddFloor MidMechFlr2, %5%Floor, 0.5, 70, 5, 80 - 0.5, 55, 0, 0, 0, 0, false
	if[%floor% = 14] AddFloor MidMechFlr, %5%Floor, 0.5, -%1%, -%2%, %1%, %2%, 0, 0, 0, 0, false

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% ! 16] AddFloor MidMechCeil, %5%Ceiling, 0.5, -%1%, -%2%, %1% - 140, %2%, %height%, %height%, 0, 0, false
	if[%floor% ! 16] AddFloor MidMechCeil2, %5%Ceiling, 0.5, 70, 5, 80 - 0.5, 55, %height%, %height%, 0, 0, false
	if[%floor% = 16] AddFloor MidMechCeil, %5%Ceiling, 0.5, -%1%, -%2%, %1%, %2%, %height%, %height%, 0, 0, false

	#Railings
	Set WallHeight = %interfloorheight% + 3.5
	Set WallOffset = -%interfloorheight%

	WallOrientation = right
	DrawWalls = true, true, false, true, true, false
	if[%floor% ! 14] AddWall RightMechRail_A, %5%Wall, 0.5, %1% - 140, -%2% + 0.5, %1% - 140, 5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	DrawWalls = true, true, false, false, true, false
	if[%floor% ! 14] AddWall RightMechRail_B, %5%Wall, 0.5, %1% - 130 - 0.5, 5 + 12, %1% - 130 - 0.5, 55 - 25, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	DrawWalls = true, true, true, false, true, false
	if[%floor% ! 14] AddWall RightMechRail_C, %5%Wall, 0.5, %1% - 140, 55, %1% - 140, %2% - 0.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

	#Perimeter walls
	TexPrefix() #Set texture prefix/suffix
	Set WallHeight = %fullheight%
	Set WallOffset = 0
	if[%floor% = 14] Set WallHeight = %height%
	if[%floor% = 14] Set WallOffset = %interfloorheight%

		DrawWalls = true, true, false, false, false, false

		WallOrientation = left
		TextureOverride ExtFacade, %5%Wall, Blank, Blank, Blank, Blank
		AddWall FrontWall, %5%Wall, 0.5, -%1%, -%2%, %1%, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		#TextureOverride ExtFacade, %5%Wall, Blank, Blank, Blank, Blank
		#AddWall LeftWall, %5%Wall, 0.5, -%1%, -%2%, -%1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade, %5%Wall, Blank, Blank, Blank, Blank
		AddWall LeftWallA, %5%Wall, 0.5, -%1%, -%2%, -%1%, -50 - 15, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade, %5%Wall, Blank, Blank, Blank, Blank
		AddWall LeftWallB, %5%Wall, 0.5, -%1%, -50 + 15, -%1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = right
		TextureOverride %5%Wall, ExtFacade, Blank, Blank, Blank, Blank
		AddWall RightWall, %5%Wall, 0.5, %1%, -%2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride %5%Wall, ExtFacade, Blank, Blank, Blank, Blank
		AddWall BackWall, %5%Wall, 0.5, -%1%, %2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
<EndFloors>

########################################

#Hotel base levels
<Floors 17 to 18>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor LMH_Floor, %5%Floor, 0.5, -%1%, -%2%, -%1% + 200 + 80, %2%, %interfloorheight%, %interfloorheight%, 0, 0, true

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	AddFloor LMH_Ceiling, %5%Ceiling, 0.5, -%1%, -%2%, -%1% + 200 + 80, %2%, %fullheight%, %fullheight%, 0, 0, true
	
	#Windows
	Set MyIFloorType = 1
	Set WinHeight = %height%
	DrawWalls = true, true, false, false, false, false

	SetAutoSize = true, false
		#Front and left windows
		AddCustomWindows(LMH_HotelBaseWin_Front1, MainWindows, MainWindowsInt, -%1%, -%2%, -180, -%2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		AddCustomWindows(LMH_HotelBaseWin_Front2, MainWindows, MainWindowsInt, -120, -%2%, -%1% + 200 + 80, -%2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		#AddCustomWindows(LMH_HotelBaseWin_Left, MainWindows, MainWindowsInt, -%1%, -%2%, -%1%, %2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		AddCustomWindows(LMH_HotelBaseWin_Left1, MainWindows, MainWindowsInt, -%1%, -%2%, -%1%, -50 - 20, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		AddCustomWindows(LMH_HotelBaseWin_Left2, MainWindows, MainWindowsInt, -%1%, -50 + 20, -%1%, %2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)

		#Right and back windows
		AddCustomWindows(LMH_HotelBaseWin_Right1, MainWindowsInt, MainWindows, -%1% + 200 + 80, -%2%, -%1% + 200 + 80, 5, %WinHeight%, 0, 0, %MyIFloorType%, %5%Wall, ExtFacade)
		AddCustomWindows(LMH_HotelBaseWin_Right2, MainWindowsInt, MainWindows, -%1% + 200 + 80, 55, -%1% + 200 + 80, %2%, %WinHeight%, 0, 0, %MyIFloorType%, %5%Wall, ExtFacade)
		AddCustomWindows(LMH_HotelBaseWin_Back, MainWindowsInt, MainWindows, -%1%, %2%, -%1% + 200 + 80, %2%, %WinHeight%, 0, 0, %MyIFloorType%, %5%Wall, ExtFacade)

	SetAutoSize = true, true

	#Perimeter walls
	Set WallHeight = %fullheight%
	Set WallOffset = 0

		#Front walls
		WallOrientation = left
		DrawWalls = true, true, true, false, false, false
		TextureOverride ExtFacade, %5%Wall, %5%Wall, %5%Wall, Blank, Blank
		AddWall FrontWallA, %5%Wall, 0.5, -180, -%2%, -174, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = true, false, false, false, false, false
		AddWall FrontWallB, ExtFacade, 0.5, -174, -%2%, -126, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = true, true, false, true, false, false
		TextureOverride ExtFacade, %5%Wall, %5%Wall, %5%Wall, Blank, Blank
		AddWall FrontWallC, %5%Wall, 0.5, -126, -%2%, -120, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		#Left walls
		WallOrientation = left
		DrawWalls = true, true, true, true, false, false
		TextureOverride ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		AddWall HB_Left1, ExtFacade, 0.5, -%1%, -50 - 20, -%1%, -50 - 15, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		AddWall HB_Left2, ExtFacade, 0.5, -%1%, -50 + 15, -%1%, -50 + 20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		#Right walls
		WallOrientation = left
		DrawWalls = false, true, true, true, false, false
		AddWall RightWall_Main_Ext, ExtFacade, 9.5, -%1% + 200 + 80, 5, -%1% + 200 + 80, 55, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = right
		DrawWalls = true, false, true, true, false, false
		AddWall RightWall_Main_Int, %5%Wall, 0.5, -%1% + 200 + 80, 5, -%1% + 200 + 80, 55, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true

		DrawWalls = true, false, false, true, false, false
		if[%floor% = 17] AddWall RightWallA, %5%Wall, 1, -%1% + 200 + 80, -%2%, -%1% + 200 + 80, -%2% + 1, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		DrawWalls = true, false, true, false, false, false
		if[%floor% = 17] AddWall RightWallB, %5%Wall, 1, -%1% + 200 + 80, %2% - 1, -%1% + 200 + 80, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
<EndFloors>

