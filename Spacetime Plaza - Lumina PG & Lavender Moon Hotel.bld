#Mid Zone Elevators (25-32)
<Function MZ_Elev_HallStation>
	#Shaft Doors
	ElevHallTex() #Set shaft door and panel textures
	Set StartNo = 15 #Number of the first elevator

		Set ElevDoorTex = %Prefix%ElevDoors
		Set IDP = 3 + 0.3
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo%, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo%, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo%, 1, %AutoFiller%, false
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 1, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 1, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 2, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 2, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 2, 1, %AutoFiller%, false

		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 3, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 3, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 3, 1, %AutoFiller%, false
	
		WallOrientation = left
		AddShaftDoorComponent %StartNo% + 4, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 4, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 4, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(15, 6, 4.14, 4.34, -20 - 4, -20 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(16, 6, 4.14, 4.34, -10 - 4, -10 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(17, 6, 4.14, 4.34, 0 - 4, 0 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(18, 6, 4.14, 4.34, 10 - 4, 10 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(19, 6, 4.14, 4.34, 20 - 4, 20 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)

	#****************************************#

	#Door trims/fillers
	Set Shaft1CX = -70 #1st shaft for elevator bank
	Set Shaft1CZ = 30

		AddDecoObject(Elev15_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, right, true, false, 0.05, 0.2, %Shaft1CX% + 5, %Shaft1CZ% - 20, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev16_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, right, true, false, 0.05, 0.2, %Shaft1CX% + 5, %Shaft1CZ% - 10, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev17_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, right, true, false, 0.05, 0.2, %Shaft1CX% + 5, %Shaft1CZ%, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev18_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, right, true, false, 0.05, 0.2, %Shaft1CX% + 5, %Shaft1CZ% + 10, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev19_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, right, true, false, 0.05, 0.2, %Shaft1CX% + 5, %Shaft1CZ% + 20, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)

	#****************************************#

	#Call buttons
	CallButtonElevators = 15, 16, 17, 18, 19
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 5.001, %Shaft1CZ% - 15, 4 - 0.4, right, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 5.001, %Shaft1CZ% - 5, 4 - 0.4, right, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 5.001, %Shaft1CZ% + 5, 4 - 0.4, right, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 5.001, %Shaft1CZ% + 15, 4 - 0.4, right, 0.4, 0.8, true, 0, 0

		#Floor signs
		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		
			#Blank signs (Floors with bright-colored walls)
			if[%floor% > 19 & %floor% < 42] AddBoxSign(HotelMZ_FS1/1, Blank, BlankSign%floorid%, Blank, 0, false, false, false, %Shaft1CX% + 5.001, %Shaft1CZ% - 15, 1.5, 1.5, 6.5 - 0.75, false)
			if[%floor% > 19 & %floor% < 42] AddBoxSign(HotelMZ_FS1/2, Blank, BlankSign%floorid%, Blank, 0, false, false, false, %Shaft1CX% + 5.001, %Shaft1CZ% + 15, 1.5, 1.5, 6.5 - 0.75, false)
	
			#Signs with background (Floors with dark-colored walls)
			if[%floor% < 20 | %floor% > 41] AddBoxSign(HotelMZ_FS1/1, Blank, ELFlrSign%floorid%, Blank, 0, false, false, false, %Shaft1CX% + 5.001, %Shaft1CZ% - 15, 1, 1, 5.5, false)
			if[%floor% < 20 | %floor% > 41] AddBoxSign(HotelMZ_FS1/2, Blank, ELFlrSign%floorid%, Blank, 0, false, false, false, %Shaft1CX% + 5.001, %Shaft1CZ% + 15, 1, 1, 5.5, false)

		#"In case of fire" signs
		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		AddWall HotelMZ_HS1/1, ElevHallSign, 0, %Shaft1CX% + 5.001, %Shaft1CZ% - 15 - 0.25, %Shaft1CX% + 5.001, %Shaft1CZ% - 15 + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false
		AddWall HotelMZ_HS1/2, ElevHallSign, 0, %Shaft1CX% + 5.001, %Shaft1CZ% + 15 - 0.25, %Shaft1CX% + 5.001, %Shaft1CZ% + 15 + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false

	#****************************************#

	#Indicator sets
	Set Offset = 7.5
	if[%floor% > 19 & %floor% < 42] Set Offset = 7.25

		#Set textures
		KSS670_PI_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)

		#Indicator creation
		if[%floor% = 17] KSS670_PI_LobbyInds(right, 15, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% - 20, %Offset%, 17, 35)
		if[%floor% = 17] KSS670_PI_LobbyInds(right, 16, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% - 10, %Offset%, 17, 35)
		if[%floor% = 17] KSS670_PI_LobbyInds(right, 17, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ%, %Offset%, 17, 35)
		if[%floor% = 17] KSS670_PI_LobbyInds(right, 18, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% + 10, %Offset%, 17, 35)
		if[%floor% = 17] KSS670_PI_LobbyInds(right, 19, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% + 20, %Offset%, 17, 35)

		if[%floor% ! 17] KSS670_PI_LobbyLanterns(right, 15, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% - 20, %Offset%, 17, 35)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(right, 16, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% - 10, %Offset%, 17, 35)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(right, 17, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ%, %Offset%, 17, 35)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(right, 18, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% + 10, %Offset%, 17, 35)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(right, 19, %Shaft1CX% + 5 + %ExtraLateralOffset%, %Shaft1CZ% + 20, %Offset%, 17, 35)
<EndFunction>

#****************************************#

<Break>

#High Zone Elevators (33-40)
<Function HZ_Elev_HallStation>
	#Shaft Doors
	ElevHallTex() #Set shaft door and panel textures
	Set StartNo = 20 #Number of the first elevator
	Set IDP = -3 - 0.3
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo%, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo%, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo%, 1, %AutoFiller%, false
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 1, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 1, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 2, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 2, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 2, 1, %AutoFiller%, false

		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 3, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 3, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 3, 1, %AutoFiller%, false
	
		WallOrientation = right
		AddShaftDoorComponent %StartNo% + 4, 1, Left, %DoorTexture%, %DoorTexture%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
		AddShaftDoorComponent %StartNo% + 4, 1, Right, %DoorTexture%2, %DoorTexture%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
		FinishShaftDoor %StartNo% + 4, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(20, 7, -4.34, -4.14, -20 - 4, -20 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(21, 7, -4.34, -4.14, -10 - 4, -10 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(22, 7, -4.34, -4.14, 0 - 4, 0 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(23, 7, -4.34, -4.14, 10 - 4, 10 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)
	AddShaftTrack(24, 7, -4.34, -4.14, 20 - 4, 20 + 4, ElevDoorTrackX, ElevExt, 0.05, 1, 7)

	#****************************************#

	#Door trims/fillers
	Set Shaft1CX = -150 #1st shaft for elevator bank
	Set Shaft1CZ = 30

		AddDecoObject(Elev20_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft1CX% - 5, %Shaft1CZ% - 20, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev21_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft1CX% - 5, %Shaft1CZ% - 10, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev22_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft1CX% - 5, %Shaft1CZ%, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev23_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft1CX% - 5, %Shaft1CZ% + 10, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		AddDecoObject(Elev24_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, left, true, false, 0.05, 0.2, %Shaft1CX% - 5, %Shaft1CZ% + 20, 4, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)

	#****************************************#

	#Call buttons
	CallButtonElevators = 20, 21, 22, 23, 24
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% - 5.001, %Shaft1CZ% - 15, 4 - 0.4, left, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% - 5.001, %Shaft1CZ% - 5, 4 - 0.4, left, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% - 5.001, %Shaft1CZ% + 5, 4 - 0.4, left, 0.4, 0.8, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% - 5.001, %Shaft1CZ% + 15, 4 - 0.4, left, 0.4, 0.8, true, 0, 0

		#Floor signs
		WallOrientation = right
		DrawWalls = true, false, false, false, false, false

			#Blank signs (Floor with bright-colored walls)
			if[%floor% > 19 & %floor% < 42] AddBoxSign(TheHotel_FS2/1, BlankSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft1CX% - 5.001, %Shaft1CZ% - 15, 1.5, 1.5, 6.5 - 0.75, false)
			if[%floor% > 19 & %floor% < 42] AddBoxSign(TheHotel_FS2/2, BlankSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft1CX% - 5.001, %Shaft1CZ% + 15, 1.5, 1.5, 6.5 - 0.75, false)
	
			#Signs with background (Floors with dark-colored walls)
			if[%floor% < 20 | %floor% > 41] AddBoxSign(TheHotel_FS2/1, ELFlrSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft1CX% - 5.001, %Shaft1CZ% - 15, 1, 1, 5.5, false)
			if[%floor% < 20 | %floor% > 41] AddBoxSign(TheHotel_FS2/2, ELFlrSign%floorid%, Blank, Blank, 0, false, false, false, %Shaft1CX% - 5.001, %Shaft1CZ% + 15, 1, 1, 5.5, false)

		#"In case of fire" signs
		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		AddWall TheHotel_HS2/1, ElevHallSign, 0, %Shaft1CX% - 5.001, %Shaft1CZ% - 15 - 0.25, %Shaft1CX% - 5.001, %Shaft1CZ% - 15 + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false
		AddWall TheHotel_HS2/2, ElevHallSign, 0, %Shaft1CX% - 5.001, %Shaft1CZ% + 15 - 0.25, %Shaft1CX% - 5.001, %Shaft1CZ% + 15 + 0.25, 0.75, 0.75, 2.6, 2.6, 0, 0, false

	#****************************************#

	#Indicator sets
	Set Offset = 7.5
	if[%floor% > 19 & %floor% < 42] Set Offset = 7.25

		#Set textures
		KSS670_PI_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)

		#Indicator creation (Hotel lobby)
		if[%floor% = 17] KSS670_PI_LobbyInds(left, 20, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ% - 20, %Offset%, 17, 43)
		if[%floor% = 17] KSS670_PI_LobbyInds(left, 21, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ% - 10, %Offset%, 17, 43)
		if[%floor% = 17] KSS670_PI_LobbyInds(left, 22, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ%, %Offset%, 17, 43)
		if[%floor% = 17] KSS670_PI_LobbyInds(left, 23, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ% + 10, %Offset%, 17, 43)
		if[%floor% = 17] KSS670_PI_LobbyInds(left, 24, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ% + 20, %Offset%, 17, 43)

		#Indicator creation (Other floors)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(left, 20, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ% - 20, %Offset%, 17, 43)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(left, 21, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ% - 10, %Offset%, 17, 43)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(left, 22, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ%, %Offset%, 17, 43)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(left, 23, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ% + 10, %Offset%, 17, 43)
		if[%floor% ! 17] KSS670_PI_LobbyLanterns(left, 24, %Shaft1CX% - 5 - %ExtraLateralOffset%, %Shaft1CZ% + 20, %Offset%, 17, 43)
<EndFunction>

#****************************************#

#Hall station creation (Mid Zone and High Zone Elevators)
#14th-16th floors (Lobby and amenities)
<Floors 17 to 19>
	MZ_Elev_HallStation()
	HZ_Elev_HallStation()
<EndFloors>

#25th-32nd floors (Mid Zone)
<Floors 28 to 35>
	MZ_Elev_HallStation()
<EndFloors>

#33rd-40th floors (High Zone)
<Floors 36 to 43>
	HZ_Elev_HallStation()
<EndFloors>

#----------------------------------------#

#HALL STATIONS (SERVICE ELEVATORS)
#Added on August 27, 2026

#Set textures (Podium Service Elevator)
<Function ElevHallTex-PS>
	TexPrefix() #Set prefixes for shaft doors

	#Shaft doors
	Set DoorTexture = %5PS%ShaftDoors #Different prefix from the Tower Service Elevators

	#Use automatic filler walls or not
	Set AutoFiller = false

	#Door trims
		#Sides
		Set DoorTrimTexture = %DoorTexture%_Trim

		#Top
		Set DoorTrimTexture_Top = %DoorTrimTexture%

	#Deco dimensions
		Set SideDecoH = 7.2
		Set TopDecoH = 0.2
		
	#Determine whether to create "Door trims" or "Filler walls matching the shaft walls"
	Set DoorTrim = true
	if[%floor% < 0] Set DoorTrim = false
	if[%floor% > 13 & %floor% < 17] Set DoorTrim = false

	#Call button panels
	Set BPanelTexture = ElevExtPanels
	Set ButtonPrefix = Button

	#Lantern panels
	Set LPanelTexture = %BPanelTexture%
	Set LanternPrefix = Lantern

		#Lateral offset for lantern panels
		Set ExtraLateralOffset = 0
<EndFunction>

#Set textures (Tower Service Elevators)
<Function ElevHallTex-Service>
	TexPrefix() #Set prefixes for shaft doors

	#Shaft doors
	Set DoorTexture = %5TS%ShaftDoors

	#Use automatic filler walls or not
	Set AutoFiller = false

	#Door trims
		#Sides
		Set DoorTrimTexture = %DoorTexture%_Trim

		#Top
		Set DoorTrimTexture_Top = %DoorTrimTexture%

	#Deco dimensions
		Set SideDecoH = 7.2
		Set TopDecoH = 0.2
		
	#Determine whether to create "Door trims" or "Filler walls matching the shaft walls"
	Set DoorTrim = true
	if[%floor% > 43] Set DoorTrim = false
	if[%floor% > 13 & %floor% < 17] Set DoorTrim = false

	#Call button panels
	Set BPanelTexture = ElevExtPanels
	Set ButtonPrefix = Button

	#Lantern panels
	Set LPanelTexture = %BPanelTexture%
	Set LanternPrefix = Lantern

		#Lateral offset for lantern panels
		Set ExtraLateralOffset = 0
<EndFunction>

#----------------------------------------#

#Podium Service Elevator (No. 25)
<Floors -2 to 17>
	#Shaft Doors
	ElevHallTex-PS() #Set shaft door and panel textures

		#Elevator 25
		Set IDP = 4.64 + (0.15 * 2) + 0.1

		WallOrientation = left
		AddShaftDoorComponent 25, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, left, 0.8, 0.6, 2.75 - (2.25 * 1), %IDP%, 2.75, %IDP%, 7, 0, -1, 0, -1, 0
		AddShaftDoorComponent 25, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, left, 0.4, 0.3, 2.75 - (2.25 * 2), %IDP% + (0.15 * 1), 2.75 - (2.25 * 1), %IDP% + (0.15 * 1), 7, 0, 0, 0, 0, 0
		FinishShaftDoor 25, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(25, 3, 1 - 4.5, 1 + 2.25, 5.34 - 0.3, 5.34, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)

	#Top filler
	AddShaftTrack(25, 3, 1, 1 + 2.25, 5.34 - 0.15, 5.34, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)

	#Gap filler
		WallOrientation = right
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 3, GapFiller_Elev25, ElevExt, 0.15 * 2, 1 + 2.25, 5.34, 1 + 2.25 + 0.25, 5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0	

	#****************************************#

	#Door trims/fillers
	TexPrefix() #Set filler textures to match with shaft walls
	Set Shaft1CX = 75 - 0.5 #1st shaft for elevator bank
	Set Shaft1CZ = 30 - 19

		#Floors with door trims
		if[%DoorTrim% = true] AddDecoObject(Elev25_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + 1, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)

		#Floors with filler walls
		WallOrientation = right
		if[%DoorTrim% = false] AddFillerWalls %5%Wall, 0.66, %Shaft1CX% + 1, %Shaft1CZ% + 6, 4.5, 7, %interfloorheight%, true, 0, 0, true #Elevator 25

	#Call buttons
	CallButtonElevators = 25
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 1 - 2.25 - 1.25, %Shaft1CZ% + 6 + 0.001, 4 - 0.4, back, 0.4, 0.8, true, 0, 0

		#Signs (Elevator 25)
		Set Sign1X = %Shaft1CX% + 1 - 2.25 - 1.25
		Set Sign1Z = %Shaft1CZ% + 6

		DrawWalls = false, true, false, false, false, false
		AddWall E25FloorSign, BlankSign%floorid%, 0, %Sign1X% - 0.75, %Sign1Z% + 0.001, %Sign1X% + 0.75, %Sign1Z% + 0.001, 1.5, 1.5, 6.5 - 0.75 + %interfloorheight%, 6.5 - 0.75 + %interfloorheight%, 0, 0, true
		#if[%floor% > 13 & %floor% < 17] AddWall E26FloorSign, ELFlrSign%floorid%, 0, %Sign1X% - 0.5, %Sign1Z% + 0.001, %Sign1X% + 0.5, %Sign1Z% + 0.001, 1, 1, 6.5 - 1 + %interfloorheight%, 6.5 - 1 + %interfloorheight%, 0, 0, true
		AddWall E25_HS1, ElevHallSign, 0, %Sign1X% - 0.25, %Sign1Z% + 0.001, %Sign1X% + 0.25, %Sign1Z% + 0.001, 0.75, 0.75, 2.6, 2.6, 0, 0, false

	#****************************************#

	#Indicator sets
	Set Offset = 7.5

		#Set textures
		KSS670_PI_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)

		#Indicator creation
		KSS670_PI_LobbyInds(back, 25, %Shaft1CX% + 1, %Shaft1CZ% + 6, %Offset%, -2, 17)
<EndFloors>

#----------------------------------------#

#Tower Service Elevators (No. 26-27)
<Function E26-27HallStation>
	#Shaft Doors
	ElevHallTex-Service() #Set shaft door and panel textures

		#Elevator 26
		Set IDP = 4.64 + (0.15 * 2) + 0.1

		WallOrientation = left
		AddShaftDoorComponent 26, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, left, 0.8, 0.6, 2.75 - (2.25 * 1), %IDP%, 2.75, %IDP%, 7, 0, -1, 0, -1, 0
		AddShaftDoorComponent 26, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, left, 0.4, 0.3, 2.75 - (2.25 * 2), %IDP% + (0.15 * 1), 2.75 - (2.25 * 1), %IDP% + (0.15 * 1), 7, 0, 0, 0, 0, 0
		FinishShaftDoor 26, 1, %AutoFiller%, false

		#Elevator 27
		Set IDP = -4.64 - (0.15 * 2) - 0.1

		WallOrientation = right
		AddShaftDoorComponent 27, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, right, 0.8, 0.6, -2.75, %IDP%, -2.75 + (2.25 * 1), %IDP%, 7, 0, -1, 0, -1, 0
		AddShaftDoorComponent 27, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.4, 0.3, -2.75 + (2.25 * 1), %IDP% - (0.15 * 1), -2.75 + (2.25 * 2), %IDP% - (0.15 * 1), 7, 0, 0, 0, 0, 0
		FinishShaftDoor 27, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(26, 8, 1 - 4.5, 1 + 2.25, 5.34 - 0.3, 5.34, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(27, 9, -1 - 2.25, -1 + 4.5, -5.34, -5.34 + 0.3, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)

	#Top filler
	AddShaftTrack(26, 8, 1, 1 + 2.25, 5.34 - 0.15, 5.34, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)
	AddShaftTrack(27, 9, -1 - 2.25, -1, -5.34, -5.34 + 0.15, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)

	#Gap filler
		WallOrientation = right
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 8, GapFiller_Elev26, ElevExt, 0.15 * 2, 1 + 2.25, 5.34, 1 + 2.25 + 0.25, 5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0	

		WallOrientation = left
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 9, GapFiller_Elev27, ElevExt, 0.15 * 2, -1 - 2.25 - 0.25, -5.34, -1 - 2.25, -5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0	

	#****************************************#

	#Door trims/fillers
	TexPrefix() #Set filler textures to match with shaft walls
	Set Shaft1CX = -80 #1st shaft for elevator bank
	Set Shaft1CZ = 30 - 19
	Set Shaft2CX = -140 #2nd shaft for elevator bank
	Set Shaft2CZ = 30 + 19

		#Floors with door trims
		if[%DoorTrim% = true] AddDecoObject(Elev26_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + 1, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)
		if[%DoorTrim% = true] AddDecoObject(Elev27_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, front, true, false, 0.05, 0.2, %Shaft2CX% - 1, %Shaft2CZ% - 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, external)

		#Floors with filler walls
		WallOrientation = right
		if[%DoorTrim% = false] AddFillerWalls %5%Wall, 0.66, %Shaft1CX% + 1, %Shaft1CZ% + 6, 4.5, 7, %interfloorheight%, true, 0, 0, true #Elevator 26

		WallOrientation = left
		if[%DoorTrim% = false] AddFillerWalls %5%Wall, 0.66, %Shaft2CX% - 1, %Shaft2CZ% - 6, 4.5, 7, %interfloorheight%, true, 0, 0, true #Elevator 27

	#Call buttons
	CallButtonElevators = 26
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 1 - 2.25 - 1.25, %Shaft1CZ% + 6 + 0.001, 4 - 0.4, back, 0.4, 0.8, true, 0, 0

	CallButtonElevators = 27
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft2CX% - 1 + 2.25 + 1.25, %Shaft2CZ% - 6 - 0.001, 4 - 0.4, front, 0.4, 0.8, true, 0, 0

		#Signs (Elevator 26)
		Set Sign1X = %Shaft1CX% + 1 - 2.25 - 1.25
		Set Sign1Z = %Shaft1CZ% + 6

		DrawWalls = false, true, false, false, false, false
		if[%floor% ! 44] AddWall E26FloorSign, BlankSign%floorid%, 0, %Sign1X% - 0.75, %Sign1Z% + 0.001, %Sign1X% + 0.75, %Sign1Z% + 0.001, 1.5, 1.5, 6.5 - 0.75 + %interfloorheight%, 6.5 - 0.75 + %interfloorheight%, 0, 0, true
		if[%floor% = 44] AddWall E26FloorSign, ELFlrSign%floorid%, 0, %Sign1X% - 0.5, %Sign1Z% + 0.001, %Sign1X% + 0.5, %Sign1Z% + 0.001, 1, 1, 6.5 - 1 + %interfloorheight%, 6.5 - 1 + %interfloorheight%, 0, 0, true

		AddWall E26_HS1, ElevHallSign, 0, %Sign1X% - 0.25, %Sign1Z% + 0.001, %Sign1X% + 0.25, %Sign1Z% + 0.001, 0.75, 0.75, 2.6, 2.6, 0, 0, false

		#Signs (Elevator 27)
		Set Sign2X = %Shaft2CX% - 1 + 2.25 + 1.25
		Set Sign2Z = %Shaft2CZ% - 6

		DrawWalls = true, false, false, false, false, false
		if[%floor% ! 44] AddWall E27FloorSign, BlankSign%floorid%, 0, %Sign2X% - 0.75, %Sign2Z% - 0.001, %Sign2X% + 0.75, %Sign2Z% - 0.001, 1.5, 1.5, 6.5 - 0.75 + %interfloorheight%, 6.5 - 0.75 + %interfloorheight%, 0, 0, true
		if[%floor% = 44] AddWall E27FloorSign, ELFlrSign%floorid%, 0, %Sign2X% - 0.5, %Sign2Z% - 0.001, %Sign2X% + 0.5, %Sign2Z% - 0.001, 1, 1, 6.5 - 1 + %interfloorheight%, 6.5 - 1 + %interfloorheight%, 0, 0, true

		AddWall E27_HS1, ElevHallSign, 0, %Sign2X% - 0.25, %Sign2Z% - 0.001, %Sign2X% + 0.25, %Sign2Z% - 0.001, 0.75, 0.75, 2.6, 2.6, 0, 0, false

	#****************************************#

	#Indicator sets
	Set Offset = 7.5

		#Set textures
		KSS670_PI_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)

		#Indicator creation
		KSS670_PI_LobbyInds(back, 26, %Shaft1CX% + 1, %Shaft1CZ% + 6, %Offset%, -2, 44)
		KSS670_PI_LobbyInds(front, 27, %Shaft2CX% - 1, %Shaft2CZ% - 6, %Offset%, -2, 44)
<EndFunction>

#Hall station creation
<Floors -2 to 0>
	E26-27HallStation()
<EndFloors>

<Floors 14 to 44>
	E26-27HallStation()
<EndFloors>

