		AddFloor SHACeil, %5S%Ceiling, 0.5, %CenterPoint%, -%2%, %1%, %NorthPoint%, %fullheight%, %fullheight%, 0, 0, true

	########################################

	#Divider walls
	Set WallHeight = %height% + Floor(%floor% + 1).InterfloorHeight - 1
	Set WallOffset = %interfloorheight%

		#Back walls
