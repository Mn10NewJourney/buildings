		AddFloor SHAFloor, %5S%Floor, 0.5, %CenterPoint%, -%2%, %1%, %NorthPoint%, %interfloorheight%, %interfloorheight%, 0, 0, true

	#Hotel entrance ceiling
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	AddFloor HotelEntrCeil, %5E%Ceiling, 0.5, -%1% + 0.5, -%2%, %CenterPoint%, %NorthPoint%, %fullheight%, %fullheight%, 0, 0, true

		#Shopping arcade ceiling
