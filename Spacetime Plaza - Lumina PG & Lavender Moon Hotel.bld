#Button creation function (Low Zone Elevators)
<Function BtnPanelE9-14>
	Set PanelNumber = %param1%
	Set PanelNumber2 = %PanelNumber% + 1
	Set BtnPrefix = Button

	if[%PanelNumber% = 1] AddButton %PanelNumber2%, , %BtnPrefix%Alarm, %BtnPrefix%Alarm, 1, 1, alarm, 1, 1

	AddButton %PanelNumber%, , %BtnPrefix%24, %BtnPrefix%Lit24, 3, 2, 27, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%23, %BtnPrefix%Lit23, 3, 1, 26, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%22, %BtnPrefix%Lit22, 4, 2, 25, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%21, %BtnPrefix%Lit21, 4, 1, 24, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%20, %BtnPrefix%Lit20, 5, 2, 23, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%19, %BtnPrefix%Lit19, 5, 1, 22, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%18, %BtnPrefix%Lit18, 6, 2, 21, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%17, %BtnPrefix%Lit17, 6, 1, 20, 1, 1

	AddButton %PanelNumber%, , %BtnPrefix%16, %BtnPrefix%Lit16, 7, 2, 19, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%15, %BtnPrefix%Lit15, 7, 1, 18, 1, 1

	AddButton %PanelNumber2%, , %BtnPrefix%14, %BtnPrefix%Lit14, 8, 1, 17, 1, 1

	AddButton %PanelNumber%, , %BtnPrefix%Open, %BtnPrefix%Open, 10, 1, open, 1, 1
	AddButton %PanelNumber%, , %BtnPrefix%Close, %BtnPrefix%Close, 10, 2, close, 1, 1
<EndFunction>

<Elevators 9 to 11>
	Set Prefix = LowerHotel

	#Set textures and dimensions
	M10_ElevCabTex(ElevExt, %Prefix%ElevFloor, %Prefix%ElevCeiling, %Prefix%ElevWall, %Prefix%ElevWall)
	M10_ElevDimensions(6, 7, 8, 0.2, 0.2, true, true, false, true)
	M10_ElevPanels(%Prefix%ElevPanelMain, %Prefix%ElevPanelTop, 1.5, 1.5, 1, 0.2, false, false, true, false)

	#Finish elevator assembly
	M10_ElevInterior()
	#--------------------
	#Car Doors
	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = 3

	WallOrientation = left
	AddDoorComponent 1, Left, %ElevDoorTex%, %ElevDoorTex%, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
	AddDoorComponent 1, Right, %ElevDoorTex%2, %ElevDoorTex%2, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
	FinishDoors 1, false, false

		#Door track
		FloorOrientation = top
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevDoorTrackX, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor DoorTrack, ElevDoorTrackX, 0.05, %IDP%, -2 - (2 * 1), %IDP% + 0.2, 2 + (2 * 1), 0, 0, 0, 0
	#--------------------
	#Button Panels
	Set Position = -2.65 #Right panel
	Set Position2 = 2.65 #Left panel

		#Panel back
		CreateWallBox2 elevator, MainPB, ElevPanel, 2.8 - 0.025, %Position%, 0.05, 0.8, 5, 2, 0, 0, false, true, true, true
		CreateWallBox2 elevator, SecondaryPB, ElevPanel, 2.8 - 0.025, %Position2%, 0.05, 0.8, 5, 2, 0, 0, false, true, true, true

		#Panels
		CreatePanel , 10, 2, left, 2.8 - 0.051, %Position%, 0.15, 0.15, 0.5, 0.25, 3.75, 0, 0
		CreatePanel , 10, 1, left, 2.8 - 0.051, %Position%, 0.15, 0.15, 0.5, 0.25, 3.75, 0, 0 #Alarm and 14 buttons only

		CreatePanel , 10, 2, left, 2.8 - 0.051, %Position2%, 0.15, 0.15, 0.5, 0.25, 3.75, 0, 0
		CreatePanel , 10, 1, left, 2.8 - 0.051, %Position2%, 0.15, 0.15, 0.5, 0.25, 3.75, 0, 0 #Alarm and 14 buttons only

			#Buttons
			BtnPanelE9-14(1)
			BtnPanelE9-14(3)

	#Elevator number sign
	DrawWalls = true, false, false, false, false, false
	AddWall ElevNo%elevator%_Inside, IN_ElevNo%elevator%, 0, 2.8 - 0.001, 0 - 0.25, 2.8 - 0.001, 0 + 0.25, 0.5, 0.5, 7.05, 7.05, 0, 0

	#Indicator sets
	KSS670_PI_InternalInd(left, 2.8 - 0.051, %Position%, 6, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)
	KSS670_PI_InternalInd(left, 2.8 - 0.051, %Position2%, 6, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)
<EndElevators>

<Elevators 12 to 14>
	Set Prefix = LowerHotel

	#Set textures and dimensions
	M10_ElevCabTex(ElevExt, %Prefix%ElevFloor, %Prefix%ElevCeiling, %Prefix%ElevWall, %Prefix%ElevWall)
	M10_ElevDimensions(6, 7, 8, 0.2, 0.2, true, false, true, true)
	M10_ElevPanels(%Prefix%ElevPanelMain, %Prefix%ElevPanelTop, 1.5, 1.5, 1, 0.2, false, true, false, false)

	#Finish elevator assembly
	M10_ElevInterior()
	#--------------------
	#Car Doors
	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = -3

	WallOrientation = right
	AddDoorComponent 1, Left, %ElevDoorTex%, %ElevDoorTex%, 0.2, left, 0.8, 0.6, %IDP%, -2, %IDP%, 0, 7, 0, 0, 0, 0, 0
	AddDoorComponent 1, Right, %ElevDoorTex%2, %ElevDoorTex%2, 0.2, right, 0.8, 0.6, %IDP%, 0, %IDP%, 2, 7, 0, 0, 0, 0, 0
	FinishDoors 1, false, false

		#Door track
		FloorOrientation = top
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevDoorTrackX, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor DoorTrack, ElevDoorTrackX, 0.05, %IDP% - 0.2, -2 - (2 * 1), %IDP%, 2 + (2 * 1), 0, 0, 0, 0
	#--------------------
	#Button Panels
	Set Position = 2.65 #Right panel
	Set Position2 = -2.65 #Left panel

		#Panel back
		CreateWallBox2 elevator, MainPB, ElevPanel, -2.8 + 0.025, %Position%, 0.05, 0.8, 5, 2, 0, 0, false, true, true, true
		CreateWallBox2 elevator, SecondaryPB, ElevPanel, -2.8 + 0.025, %Position2%, 0.05, 0.8, 5, 2, 0, 0, false, true, true, true

		#Right panels
		CreatePanel , 10, 2, right, -2.8 + 0.051, %Position%, 0.15, 0.15, 0.5, 0.25, 3.75, 0, 0
		CreatePanel , 10, 1, right, -2.8 + 0.051, %Position%, 0.15, 0.15, 0.5, 0.25, 3.75, 0, 0 #Alarm and 14 buttons only

		#Left panels
		CreatePanel , 10, 2, right, -2.8 + 0.051, %Position2%, 0.15, 0.15, 0.5, 0.25, 3.75, 0, 0
		CreatePanel , 10, 1, right, -2.8 + 0.051, %Position2%, 0.15, 0.15, 0.5, 0.25, 3.75, 0, 0 #Alarm and 14 buttons only

			#Buttons
			BtnPanelE9-14(1)
			BtnPanelE9-14(3)

	#Elevator number sign
	DrawWalls = false, true, false, false, false, false
	AddWall ElevNo%elevator%_Inside, IN_ElevNo%elevator%, 0, -2.8 + 0.001, 0 - 0.25, -2.8 + 0.001, 0 + 0.25, 0.5, 0.5, 7.05, 7.05, 0, 0

	#Indicator sets
	KSS670_PI_InternalInd(right, -2.8 + 0.051, %Position%, 6, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)
	KSS670_PI_InternalInd(right, -2.8 + 0.051, %Position2%, 6, Ind_Button, ArrowUp, ArrowUpLit, ArrowDownLit)
<EndElevators>

<Elevators 9 to 14>
	#DETAILED INTERIORS
	#1. Lights
		#1a. Downlights
		Set DLOffset = 8 - 0.001
		FloorOrientation = top
		DrawWalls = true, false, false, false, true, true
		AddFloor Downlight1/1, %Prefix%ElevCeilingDL, 0, -1.95 - 0.11, 2.45 - 0.11, -1.95 + 0.11, 2.45 + 0.11, %DLOffset%, %DLOffset%, 0, 0
		AddFloor Downlight1/2, %Prefix%ElevCeilingDL, 0, 0 - 0.11, 2.45 - 0.11, 0 + 0.11, 2.45 + 0.11, %DLOffset%, %DLOffset%, 0, 0
		AddFloor Downlight1/3, %Prefix%ElevCeilingDL, 0, 1.95 - 0.11, 2.45 - 0.11, 1.95 + 0.11, 2.45 + 0.11, %DLOffset%, %DLOffset%, 0, 0
		AddFloor Downlight2/1, %Prefix%ElevCeilingDL, 0, -1.95 - 0.11, -2.45 - 0.11, -1.95 + 0.11, -2.45 + 0.11, %DLOffset%, %DLOffset%, 0, 0
		AddFloor Downlight2/2, %Prefix%ElevCeilingDL, 0, 0 - 0.11, -2.45 - 0.11, 0 + 0.11, -2.45 + 0.11, %DLOffset%, %DLOffset%, 0, 0
		AddFloor Downlight2/3, %Prefix%ElevCeilingDL, 0, 1.95 - 0.11, -2.45 - 0.11, 1.95 + 0.11, -2.45 + 0.11, %DLOffset%, %DLOffset%, 0, 0
	
		#1b. Center light
		CreateWallBox2 elevator, E%elevator%_MidLight, %Prefix%ElevCeilingLight, 0, 0, 5.6, 2.5, 0.1, 8 - 0.1, 0, 0, false, true, true, true
	
		#1c. Ceiling trims
		CreateWallBox2 elevator, E%elevator%_Trim1, %Prefix%ElevCeilingTrim, 0, 1.5 - 0.125, 5.6, 0.25, 0.1, 8 - 0.1, 0, 0, false, true, true, true
		CreateWallBox2 elevator, E%elevator%_Trim2, %Prefix%ElevCeilingTrim, 0, -1.5 + 0.125, 5.6, 0.25, 0.1, 8 - 0.1, 0, 0, false, true, true, true

	#2. Panels on walls
	Set WPTex = %Prefix%ElevWallPanel
	if[%elevator% > 11] Set WPTex = %Prefix%ElevWallPanel2
	Set WPanelHeight = 8 - 0.5
	
		#Front panels
		CreateWallBox2 elevator, Panel_F1, %WPTex%, 0 - (5.6 * 1/4), -3.3 + 0.01, (5.6 * 1/2) - 0.3, 0.02, %WPanelHeight%, 0.25 + 0.05, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_F3, %WPTex%, 0 + (5.6 * 1/4), -3.3 + 0.01, (5.6 * 1/2) - 0.3, 0.02, %WPanelHeight%, 0.25 + 0.05, 0, 0, false, true, true, true

		#Back panels
		CreateWallBox2 elevator, Panel_B1, %WPTex%, 0 - (5.6 * 1/4), 3.3 - 0.01, (5.6 * 1/2) - 0.3, 0.02, %WPanelHeight%, 0.25 + 0.05, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_B3, %WPTex%, 0 + (5.6 * 1/4), 3.3 - 0.01, (5.6 * 1/2) - 0.3, 0.02, %WPanelHeight%, 0.25 + 0.05, 0, 0, false, true, true, true

		#Left/right panels
		Set Position = -2.8 + 0.01
		if[%elevator% > 11] Set Position = 2.8 - 0.01
		CreateWallBox2 elevator, Panel_R1, %WPTex%, %Position%, 0 - (6.6 * 1/4), 0.02, (6.6 * 1/2) - 0.3, %WPanelHeight%, 0.25 + 0.05, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_R2, %WPTex%, %Position%, 0 + (6.6 * 1/4), 0.02, (6.6 * 1/2) - 0.3, %WPanelHeight%, 0.25 + 0.05, 0, 0, false, true, true, true

	#----------------------------------------

	#Shaft components
	DrawWalls = true, true, true, true, true, true
		#Ropes
		RopePosition = 0, 8 + 0.2, 0
		RopeTexture = Ropes
	
		#Counterweight
		if[%elevator% < 12] Set Position = -3 - 0.75
		if[%elevator% > 11] Set Position = 3 + 0.75
		CreateCounterweight CWeight_Frame, CWeight, %Position%, 0, 0.5, 6, 2, 0.5

		#Rails
		AddRails ElevRail, ElevRailSide, 0, 0, true, 3.5 + 0.06, 0.1
		AddRails ElevRail, ElevRailSide, %Position%, 0, true, 1 + 0.06, 0.1
<EndElevators>

