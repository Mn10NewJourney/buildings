########################################

#SERVICE CORE WALLS
#Added on August 27, 2026

#Wall creation function
<Function LMH_ServCoreWalls>
  #Set wall orientation - Parameter 1
  WallOrientation = %param1%
  DrawWalls = true, true, false, false, false, false

  #Set textures
    #Main negative - Parameter 2
    #Main positive - Parameter 3
    #Wall name - Parameter 4
	#Is external - Parameter 11
    TextureOverride %param2%, %param3%, Blank, Blank, Blank, Blank
    AddWall LMH_%floorid%F_%param4%, %param2%, 0.5, %param5%, %param6%, %param7%, %param8%, %param9%, %param9%, %param10%, %param10%, 0, 0, %param11%

  #Footnote:
  #1. Parameters 5-8 contains the wall's coordinates
  #2. Wall height is specified in Parameter 9.
  #3. Wall offset is set in Parameter 10.
<EndFunction>

#Set door textures
<Function LMH_ServCoreDoors>
	Set DTex = ServiceDoor2 #Most floors
	if[%floor% = 0] Set DTex = Door8 #Hotel entrance / shopping arcade level

	if[%floor% < 0] Set DTex = ServiceDoor1 #Parking levels
	if[%floor% > 0 & %floor% < 14] Set DTex = ServiceDoor1

	if[%floor% > 41] Set DTex = ServiceDoor3 #Top floor restaurant

	Set DSTex = %DTex%Side
<EndFunction>

########################################

#Tower Service Elevator Lobby (Levels B2-1) / Utility Room in place of service elevators (Levels 2-10)
<Function TowerSL1>
	#Sets for walls
	Set WallHeight = %height%
	if[%floor% < 0] Set WallHeight = %height% + 1
	if[%floor% > 0 & %floor% < 14] Set WallHeight = %height% + 1
	Set WallOffset = %interfloorheight%

	#----------------------------------------

	#West service floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	CreateFlr(WestServFlr, SAFloor, 0.5, -145, 5, -135 - 0.5, 55, 0, true)

	#West Service Wall
	LMH_ServCoreWalls(left, %5%Wall, SAWall, East_Left, -145, 5 + 25, -145, 55 - 12, %WallHeight%, %WallOffset%, true)
	LMH_ServCoreWalls(right, SAWall, %5%Wall, East_Right, -135, 5 + 25, -135, 55 - 12, %WallHeight%, %WallOffset%, true)

		#Service doors
		Set Door_MainX = -135 - 0.5
		Set Door_MainZ = 35

		WallOrientation = left
		AddStdDoor Door Manager, %floorid%F_WestService_D1, , , false, %DTex%, %DSTex%, 0.2, left, left, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddStdDoor Door Manager, %floorid%F_WestService_D2, , , false, %DTex%, %DSTex%, 0.2, right, left, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

	#Full-height ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	CreateFlr(WestServFHC, SACeiling, 0.5, -145, 5, -135, 55, %height%, true)

	#Dropped ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 0 | %floor% = 1] AddFloor WestServDC, SLDropCeiling, 0.5, -145, 5 + 25, -135, 55 - 12, 9.5, 9.5, 0, 0, false

	#----------------------------------------

	#East service floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	CreateFlr(EastServFlr, SAFloor, 0.5, -85 + 0.5, 5, -75, 55, 0, true)

	#East Service Wall
	LMH_ServCoreWalls(left, %5%Wall, SAWall, East_Left, -85, 5 + 12, -85, 55 - 25, %WallHeight%, %WallOffset%, true)
	LMH_ServCoreWalls(right, SAWall, %5%Wall, East_Right, -75, 5 + 12, -75, 55 - 25, %WallHeight%, %WallOffset%, true)

		#Service doors
		Set Door_MainX = -85 + 0.5
		Set Door_MainZ = 25

		WallOrientation = right
		AddStdDoor Door Manager, %floorid%F_EastService_D1, , , false, %DTex%, %DSTex%, 0.2, left, right, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddStdDoor Door Manager, %floorid%F_EastService_D2, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, false, 0, 0, true

	#Full-height ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	CreateFlr(EastServFHC, SACeiling, 0.5, -85, 5, -75, 55, %height%, true)

	#Dropped ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 0 | %floor% = 1] AddFloor EastServDC, SLDropCeiling, 0.5, -85, 5 + 12, -75, 55 - 25, 9.5, 9.5, 0, 0, false
<EndFunction>

#Tower Service Elevator Lobby (Levels 14-40)
<Function TowerSL2>
	#Sets for walls
	Set WallHeight = %height%
	if[%floor% < 0] Set WallHeight = %height% + 1
	if[%floor% > 0 & %floor% < 14] Set WallHeight = %height% + 1
	Set WallOffset = 0

	#----------------------------------------

	#West service floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	CreateFlr(WestServFlr, SAFloor, 0.5, -145, 5 + 0.5, -125, 55 - 0.5, 0, false)

	#West Service Wall
	LMH_ServCoreWalls(left, Blank, SAWall, West_Left, -145, 5 + 25, -145, 55 - 12, %WallHeight%, %WallOffset%, false)
	LMH_ServCoreWalls(left, %5%Wall, SAWall, West_Front, -135, 5, -125, 5, %WallHeight%, %WallOffset%, false)
	LMH_ServCoreWalls(right, SAWall, %5%Wall, West_Back, -135, 55, -125, 55, %WallHeight%, %WallOffset%, false)

		#South doors
		Set Door_MainX = -130
		Set Door_MainZ = 5 + 0.5

		WallOrientation = right
		AddStdDoor Door Manager, %floorid%F_WestService_D1, , , false, %DTex%, %DSTex%, 0.2, back, back, 75, 75, %Door_MainX% - 1.5, %Door_MainZ%, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddStdDoor Door Manager, %floorid%F_WestService_D2, , , false, %DTex%, %DSTex%, 0.2, front, back, 75, 75, %Door_MainX% + 1.5, %Door_MainZ%, 3, 7, Floor(%floor%).Base, 0, 0, 0, 0
		AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, %interfloorheight%, true, 0, 0, true

		#North doors
		Set Door_MainX = -130
		Set Door_MainZ = 55 - 0.5

