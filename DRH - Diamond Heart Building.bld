#Floor Assignments
<Floor -1>
	ID = PIT
	Name = Shaft Pit
	Type = Basement
	Height = 8
	InterfloorHeight = 2
	Altitude = -12
<EndFloor>

<Floor 0>
	ID = %floor% + 1
	Name = Level %floorid%
	Type = Lobby
	Height = 10
	InterfloorHeight = 2
	Altitude = -2
<EndFloor>

<Floor 1>
	ID = M
	Name = Mezzanine
	Type = Mezzanine
	Height = 10
	InterfloorHeight = 2
<EndFloor>

<Floors 2 to 6>
	ID = %floor%
	Name = Hospital Level %floorid%
	Type = Hospital
	Height = 10
	InterfloorHeight = 2
<EndFloors>

<Floors 7 to 8>
	if[%floor% = 7] ID = %floor%
	if[%floor% = 8] ID = 7A
	Name = Mechanical Level %floorid%
	Type = Mechanical
	Height = 9.5
	InterfloorHeight = 1.5
	if[%floor% = 7] InterfloorHeight = 2
	
		#Merge floors
		if[%floor% = 7] Group = 8
		if[%floor% = 8] Group = 7
<EndFloors>

<Floor 9>
	ID = R
	Name = Roof
	Type = Roof
	Height = 9.5
	InterfloorHeight = 1.5
<EndFloor>

#Merge floors
<Floors 0 to 6>
	Group = 0 - 6
<EndFloors>

##--------------------------------------------------------------------------------##

#Common values
Set 1 = 60 #Building Dimension X
Set 2 = 120 #Building Dimension Z
Set SE_MechPH = -31.25 #South end for mechanical penthouse

#Landscape
DrawWalls = false, true, false, false, false, false

	#Perimeter floors
	DrawWalls = false, true, false, false, false, false
	AddFloor landscape, FrontGrass, Grass, 0, -%1%, -%2% - 30, %1%, -%2%, Floor(0).Base, Floor(0).Base, 0, 0
	AddFloor landscape, LeftGrass1, Grass, 0, -%1% - 20, -%2% - 30, -%1%, 30, Floor(0).Base, Floor(0).Base, 0, 0
	AddFloor landscape, LeftSidewalk, Sidewalk, 0, -%1% - 20, 30, -%1%, 30 + 60, Floor(0).Base, Floor(0).Base, 0, 0
	AddFloor landscape, LeftGrass2, Grass, 0, -%1% - 20, 30 + 60, -%1%, %2% + 30, Floor(0).Base, Floor(0).Base, 0, 0

	AddFloor landscape, RightGrass1, Grass, 0, %1%, -%2% - 30, %1% + 20, -30, Floor(0).Base, Floor(0).Base, 0, 0
	AddFloor landscape, RightSidewalk, Sidewalk, 0, %1%, -30, %1% + 20, 30, Floor(0).Base, Floor(0).Base, 0, 0
	AddFloor landscape, RightGrass2, Grass, 0, %1%, 30, %1% + 20, %2% + 30, Floor(0).Base, Floor(0).Base, 0, 0
	AddFloor landscape, BackGrass, Grass, 0, -%1%, %2%, %1%, %2% + 30, Floor(0).Base, Floor(0).Base, 0, 0

##--------------------------------------------------------------------------------##

#Set texture prefixes/suffixes
<Function TexPrefix>
	#Main prefixes
	Set 5 = Lobby
	if[%floor% > 1] Set 5 = 2F
	if[%floor% = 7 | %floor% = 8] Set 5 = Service

		#Infix for office areas
		Set Infix = 
		if[%floor% > 1 & %floor% < 7] Set Infix = Office

		#Suffixes for support columns
		Set SupportSuffix = Wall
		if[%floor% > -1 & %floor% < 7] Set SupportSuffix = DecoWall

		#Suffixes for elevator lobbies
		Set ELSuffix = Wall
		if[%floor% < 7] Set ELSuffix = LobbyWall

		#Prefixes for service elevator lobby
		Set 5A = %5%
		if[%floor% < 7] Set 5A = SA
		
		#Special values for plaza area on 1 and M
		Set 5B = %5%
		if[%floor% > -1 & %floor% < 2] Set 5B = Plaza
<EndFunction>

##--------------------------------------------------------------------------------##

#EXTERIOR & INTERIOR
#All floors
<Floors 0 to 8>
	TexPrefix() #Set texture prefix/suffix

	#Floors
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	if[%floor% ! 0 & %floor% ! 1 & %floor% < 7] AddFloor MainFloor, %5%Floor, 0.5, -%1%, -%2%, %1%, %2%, 0, 0, 0, 0, false
	if[%floor% = 7] AddFloor MechPHFloor, %5%Floor, 0.5, -%1%, %SE_MechPH%, %1%, %2%, 0, 0, 0, 0, false
		
		#Lobby and plaza areas (1st floor)
		if[%floor% = 0] AddFloor LobbyFloor, %5%Floor, 0.5, -%1%, -%2%, 20, %2%, 0, 0, 0, 0, false
		if[%floor% = 0] AddFloor PlazaFloor, PlazaFloor, 0.5, 20, -%2%, %1%, %2%, 0, 0, 0, 0, false

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% ! 0 & %floor% < 7] AddFloor MainCeiling, %5%Ceiling, 0.5, -%1%, -%2%, %1%, %2%, %height%, %height%, 0, 0, false
	if[%floor% = 8] AddFloor MechPHCeiling, %5%Ceiling, 0.5, -%1%, %SE_MechPH%, %1%, %2%, %height%, %height%, 0, 0, false
<EndFloors>

#Mezzanine area
<Floors 0 to 1>
	TexPrefix() #Set texture prefix/suffix

	#Mezzanine floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	if[%floor% = 1] AddFloor MezFloor1, PlazaFloor, 0.5, 20 - 0.5, -%2%, %1%, %2%, 0, 0, 0, 0, false
	if[%floor% = 1] AddFloor MezFloor2, PlazaFloor, 0.5, -20, 27.5, 20 - 0.5, 70, 0, 0, 0, 0, false
	if[%floor% = 1] AddFloor MezFloor3, PlazaFloor, 0.5, -20, -%2%, 20 - 0.5, -50, 0, 0, 0, 0, false

	#Mezzanine ceiling
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 0] AddFloor MezCeiling1, %5%Ceiling, 0.5, 20 - 0.5, -%2%, %1%, %2%, %height%, %height%, 0, 0, false
	if[%floor% = 0] AddFloor MezCeiling2, %5%Ceiling, 0.5, -20, 27.5, 20 - 0.5, 70, %height%, %height%, 0, 0, false
	if[%floor% = 0] AddFloor MezCeiling3, %5%Ceiling, 0.5, -20, -%2%, 20 - 0.5, -50, %height%, %height%, 0, 0, false
<EndFloors>

########################################

#PLAZA ATRIUM CUTS
<Floors 0 to 1>
	if[%floor% > 0] CutAll 20 + 15.5, %interfloorheight% - 0.1, -55, %1%, %interfloorheight% + 0.1, 30, false, true
	if[%floor% < 1] CutAll 20 + 15.5, %fullheight% - 0.1, -55, %1%, %fullheight% + 0.1, 30, false, true
<EndFloors>

#PLAZA ATRIUM RAILINGS - Mezzanine level
<Floor 1>
	#Plaza atrium railings
	Set WallHeight = %interfloorheight% + 3.5
	Set WallOffset = -%interfloorheight%

		WallOrientation = left
		DrawWalls = true, true, true, false, true, false
		AddWall PlazaRail_Back, PlazaWall, 0.5, 20 + 15.5, 30, %1%, 30, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		WallOrientation = right
		AddWall PlazaRail_Front, PlazaWall, 0.5, 43.5, -55, %1%, -55, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		DrawWalls = true, true, true, true, true, false
		AddWall PlazaRail_Left, PlazaWall, 0.5, 20 + 15.5, -55, 20 + 15.5, 30.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
<EndFloor>

########################################

<Floor 0>
	TexPrefix() #Set texture prefix/suffix
	DrawWalls = true, true, false, false, false, false

	#Plaza/lobby divider walls
	Set WallHeight = %height%
	Set WallOffset = 0

		#Dividers at elevator lobbies
		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		AddWall LobbyDivWall_Elev1-6, %5%LobbyWall, 0.5, 20, 6, 20, 38, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		DrawWalls = false, true, false, false, false, false
		AddWall PlazaWall_Elev1-6_Int, PlazaWall, 0.5, 20, 6, 20, 38, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

		#Dividers at other areas
		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		AddWall_CustomTex(LDW_North, 2, %5%Wall2, %5%Wall, Blank, 0.5, 20, 70, 20, %2%, 4, %height% - 4, 0, 0, false)
		AddWall_CustomTex(LDW_Center, 2, %5%Wall2, %5%Wall, Blank, 0.5, 20, -60, 20, -6, 4, %height% - 4, 0, 0, false)
		AddWall_CustomTex(LDW_South, 2, %5%Wall2, %5%Wall, Blank, 0.5, 20, -%2%, 20, -90, 4, %height% - 4, 0, 0, false)
		
		DrawWalls = false, true, false, false, false, false
		AddWall PlazaWall_North, PlazaWall, 0.5, 20, 70, 20, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		AddWall PlazaWall_Center, PlazaWall, 0.5, 20, -60, 20, -6, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		AddWall PlazaWall_South, PlazaWall, 0.5, 20, -%2%, 20, -90, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		
		#Dividers west of restrooms
		WallOrientation = left
		DrawWalls = true, true, false, false, false, false
		AddWall_CustomTex(PlazaDivWall_WestofRR, 2, %5%Wall2, %5%Wall, Blank, 0.5, -20, -%2%, -20, -90, 4, %height% - 4, 0, 0, false)

