<Function BtnPanelE3-6>
	Set PanelNumber = %param1%
	Set ButtonPrefix = T2Button

	AddButton %PanelNumber%, , %ButtonPrefix%6, %ButtonPrefix%Lit6, 1, 2, 6, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%5, %ButtonPrefix%Lit5, 1, 1, 5, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%4, %ButtonPrefix%Lit4, 2, 2, 4, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%3, %ButtonPrefix%Lit3, 2, 1, 3, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%2, %ButtonPrefix%Lit2, 3, 2, 2, 1, 1
	AddButton %PanelNumber%, , MainFloorStar, MainFloorStar, 3, 1, off, 0.4, 0.8, -0.75, 0
	AddButton %PanelNumber%, , %ButtonPrefix%1, %ButtonPrefix%Lit1, 3, 1, 0, 1, 1

	AddButton %PanelNumber%, , %ButtonPrefix%Open, %ButtonPrefix%Open, 5, 1, open, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%Close, %ButtonPrefix%Close, 5, 2, close, 1, 
	if[%PanelNumber% = 1] AddControl %PanelNumber%, , 6, 1, 1, 1, 0, 0, reset, hold, %ButtonPrefix%DH, %ButtonPrefix%LitDH
	if[%PanelNumber% = 1] AddButton %PanelNumber%, , %ButtonPrefix%Alarm, %ButtonPrefix%Alarm, 6, 2, alarm, 1, 1
<EndFunction>

<Elevators 3 to 6>
	Set Prefix = Main

	#Set textures and dimensions
	Set P1Width = 0.25
	Set P2Width = 1.25

	M10_ElevCabTex(ElevExt2, %Prefix%ElevFloor, %Prefix%ElevCeiling, %Prefix%ElevWall, %Prefix%ElevWall)
	M10_ElevDimensions(6, 9.28, 8, 0.2, 0.2, true, true, true, false)
	M10_ElevPanels(%Prefix%ElevPanelMain, %Prefix%ElevPanelTop, %P1Width%, %P2Width%, 1, 0.2, false, false, false, true)

	#Finish elevator assembly
	M10_ElevInterior()
	#--------------------
	#MORE DETAILED INTERIORS

	#1. Panels on walls
	Set WPTex = %Prefix%ElevWallPanel
	Set WPanelHeight = 8 - 0.5

		#Front panels
		CreateWallBox2 elevator, Panel_F1, %WPTex%, 0 - (5.6 * 1/4), -4.44 + 0.01, (5.6 * 1/2) - 0.3, 0.02, %WPanelHeight%, 0.25, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_F2, %WPTex%, 0 + (5.6 * 1/4), -4.44 + 0.01, (5.6 * 1/2) - 0.3, 0.02, %WPanelHeight%, 0.25, 0, 0, false, true, true, true

		#Left panels
		CreateWallBox2 elevator, Panel_L1, %WPTex%, -2.8 + 0.01, 0 - (8.88 * 1/3), 0.02, (8.88 * 1/3) - 0.3, %WPanelHeight%, 0.25, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_L2, %WPTex%, -2.8 + 0.01, 0, 0.02, (8.88 * 1/3) - 0.3, %WPanelHeight%, 0.25, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_L3, %WPTex%, -2.8 + 0.01, 0 + (8.88 * 1/3), 0.02, (8.88 * 1/3) - 0.3, %WPanelHeight%, 0.25, 0, 0, false, true, true, true

		#Right panels
		CreateWallBox2 elevator, Panel_R1, %WPTex%, 2.8 - 0.01, 0 - (8.88 * 1/3), 0.02, (8.88 * 1/3) - 0.3, %WPanelHeight%, 0.25, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_R2, %WPTex%, 2.8 - 0.01, 0, 0.02, (8.88 * 1/3) - 0.3, %WPanelHeight%, 0.25, 0, 0, false, true, true, true
		CreateWallBox2 elevator, Panel_R3, %WPTex%, 2.8 - 0.01, 0 + (8.88 * 1/3), 0.02, (8.88 * 1/3) - 0.3, %WPanelHeight%, 0.25, 0, 0, false, true, true, true

	#2. Ceiling lights
	BedElev_CeilingLights()
	#--------------------
	#Car Doors
	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = 4.64

	WallOrientation = left
	AddDoorComponent 1, 2Speed_Fast, %ElevDoorTex%2, %ElevDoorTex%2, 0.15, right, 0.8, 0.6, -2.75, %IDP% + (0.15 * 1), -2.75 + (2.25 * 1), %IDP% + (0.15 * 1), 7, 0, 0, 0, 0, 0
	AddDoorComponent 1, 2Speed_Slow, %ElevDoorTex%2, %ElevDoorTex%2, 0.15, right, 0.4, 0.3, -2.75 + (2.25 * 1), %IDP%, -2.75 + (2.25 * 2), %IDP%, 7, 0, 0, 0, 0, 0
	FinishDoors 1, false, false

		#Door track
		FloorOrientation = top
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevDoorTrackZ, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor DoorTrack, ElevDoorTrackZ, 0.05, -2.75, %IDP%, -2.75 + (2.25 * 3), %IDP% + (0.15 * 2), 0, 0, 0, 0

		#Top filler
		FloorOrientation = bottom
		DrawWalls = true, true, true, true, true, true
		TextureOverride %Prefix%ElevPanelTop, ElevExt, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor TopFiller, %Prefix%ElevPanelTop, 0.05, -2.75, %IDP%, -2.75 + (2.25 * 1), %IDP% + (0.15 * 1), 7, 7, 0, 0

	#Gap filler
	WallOrientation = left
	DrawWalls = true, true, true, true, true, true
	TextureOverride ElevExt, ElevExt, %Prefix%ElevPanelMain, %Prefix%ElevPanelMain, ElevExt, ElevExt
	AddWall GapFiller, %Prefix%ElevPanelMain, 0.15 * 2, -3, %IDP%, -2.75, %IDP%, 7, 7, 0, 0, 0, 0
	#--------------------
	#Button Panels
	Set P1_PositionX = 2.275
	Set P1_PositionZ = 4.44 - 0.051

		#Panel back
		CreateWallBox2 elevator, MainPB, ElevPanel, %P1_PositionX%, %P1_PositionZ% + 0.051 - 0.025, 0.8, 0.05, 4.875, 2, 0, 0, false, true, true, true

		#Panel
		CreatePanel , 8, 2, front, %P1_PositionX%, %P1_PositionZ%, 0.22, 0.11, 0.35, 0.35, 3.75, 0, 0

			#Buttons
			BtnPanelE3-6(1)

	#Elevator number sign
	DrawWalls = true, false, false, false, false, false
	AddWall ElevNo%elevator%_Inside, IN_ElevNo%elevator%, 0, %P1_PositionX% - 0.25, %P1_PositionZ% - 0.001, %P1_PositionX% + 0.25, %P1_PositionZ% - 0.001, 0.5, 0.5, 6.25, 6.25, 0, 0

	#Indicator sets
	AddFloorIndicator T4VRInd_Button, front, %P1_PositionX%, %P1_PositionZ% - 0.001, 0.6, 0.3, 5.75 + 0.25 - (0.3 / 2)
	AddDirectionalIndicator true, true, true, Blank, T4VRArrowUp, T4VRArrowUpLit, T4VRArrowDown, T4VRArrowDownLit, %P1_PositionX% - (0.3 / 2), %P1_PositionZ% - 0.001, 5.75 + 0.25 - (0.3 / 2), front, 0.3, 0.3, true, 0, 0
	#--------------------
	#Shaft components
	DrawWalls = true, true, true, true, true, true
		#Ropes
		RopePosition = 0, 8 + 0.2, 0
		RopeTexture = Ropes
	
		#Counterweight
		Set Position = 3 + 0.8
		CreateCounterweight CWeight_Frame, CWeight, %Position%, 0, 0.5, 6, 2, 0.5
	
		#Rails
		AddRails ElevRail, ElevRailSide, 0, 0, false, 3 + 0.06, 0.1
		AddRails ElevRail, ElevRailSide, %Position%, 0, true, 1 + 0.06, 0.1
<EndElevators>

#Service Elevators
<Elevator 7>
	Name = Service Elevator 1
	Speed = 5
	Acceleration = 0.6
	Deceleration = 0.6
	ServicedFloors = 0 - 7
	AssignedShaft = 3
	CreateElevator true, 4.75, 0, 0
<EndElevator>

<Elevator 8>
	Name = Service Elevator 2
	Speed = 5
	Acceleration = 0.6
	Deceleration = 0.6
	ServicedFloors = 0 - 7
	AssignedShaft = 3
	CreateElevator true, -4.75, 0, 0
<EndElevator>

<Function BtnPanelE7-8>
	Set PanelNumber = %param1%
	Set ButtonPrefix = TKVRButton

	AddButton %PanelNumber%, , %ButtonPrefix%7, %ButtonPrefix%Lit7, 1, 2, 7, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%6, %ButtonPrefix%Lit6, 1, 1, 6, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%5, %ButtonPrefix%Lit5, 2, 2, 5, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%4, %ButtonPrefix%Lit4, 2, 1, 4, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%3, %ButtonPrefix%Lit3, 3, 2, 3, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%2, %ButtonPrefix%Lit2, 3, 1, 2, 1, 1

	AddButton %PanelNumber%, , %ButtonPrefix%M, %ButtonPrefix%LitM, 4, 2, 1, 1, 1

	AddButton %PanelNumber%, , MainFloorStar, MainFloorStar, 4, 1, off, 0.4, 0.8, -0.75, 0
	AddButton %PanelNumber%, , %ButtonPrefix%1, %ButtonPrefix%Lit1, 4, 1, 0, 1, 1

	AddButton %PanelNumber%, , %ButtonPrefix%Open, %ButtonPrefix%Open, 6, 1, open, 1, 1
	AddButton %PanelNumber%, , %ButtonPrefix%Close, %ButtonPrefix%Close, 6, 2, close, 1, 
	if[%PanelNumber% = 1] AddControl %PanelNumber%, , 7, 1, 1, 1, 0, 0, reset, hold, %ButtonPrefix%DH, %ButtonPrefix%LitDH
	if[%PanelNumber% = 1] AddButton %PanelNumber%, , %ButtonPrefix%Alarm, %ButtonPrefix%Alarm, 7, 2, alarm, 1, 1
<EndFunction>

<Elevators 7 to 8>
	Type = Service
	AutoEnable = false

	Set Prefix = Service #Set prefix for elevator interiors

	#Set textures and dimensions
	Set P1Width = 0.25
	Set P2Width = 0.25

	M10_ElevCabTex(ElevExt2, %Prefix%ElevFloor, %Prefix%ElevCeiling, %Prefix%ElevWall, %Prefix%ElevWall)
	M10_ElevDimensions(6.5, 9.28, 8, 0.2, 0.2, true, true, true, false)
	M10_ElevPanels(%Prefix%ElevPanelMain, %Prefix%ElevPanelTop, %P1Width%, %P2Width%, 1, 0.2, false, false, false, true)

	#Finish elevator assembly
	M10_ElevInterior()
	#--------------------
	#MORE DETAILED INTERIORS

	#1. Panels on walls
	Set WPTex = %Prefix%ElevWallPanel
	Set WPanelHeight = 3.5

		#Front panel
		CreateWallBox2 elevator, Panel_F1, %WPTex%, 0, -4.44 + 0.01, 6.1 - 0.04, 0.02, %WPanelHeight%, 0, 0, 0, false, true, true, true

		#Left panel
		CreateWallBox2 elevator, Panel_L1, %WPTex%, -3.05 + 0.01, 0, 0.02, 8.88, %WPanelHeight%, 0, 0, 0, false, true, true, true

		#Right panel
		CreateWallBox2 elevator, Panel_L1, %WPTex%, 3.05 - 0.01, 0, 0.02, 8.88, %WPanelHeight%, 0, 0, 0, false, true, true, true

	#2. Ceiling lights
	Set LightWidth = 2
	Set LightLength = 4.5
	Set TrimWidth = 0.15

	CreateWallBox2 elevator, CL_Light1, %Prefix%ElevCeilingLight, 0, 0, %LightWidth%, %LightLength%, 0.1, 8 - 0.05, 0, 0, false, true, true, true
	#--------------------
	#Car Doors
	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = 4.64

	WallOrientation = left
	AddDoorComponent 1, FreightDoor1, %ElevDoorTex%, %ElevDoorTex%, 0.15, left, 0.4, 0.3, -3, %IDP%, -3 + (1.5 * 1), %IDP%, 7, 0, 0, 0, 0, 0
	AddDoorComponent 1, FreightDoor2, %ElevDoorTex%, %ElevDoorTex%, 0.15, left, 0.8, 0.6, -3 + (1.5 * 1), %IDP% + (0.15 * 1), -3 + (1.5 * 2), %IDP% + (0.15 * 1), 7, 0, 0, 0, 0, 0
	AddDoorComponent 1, FreightDoor3, %ElevDoorTex%2, %ElevDoorTex%2, 0.15, right, 0.8, 0.6, -3 + (1.5 * 2), %IDP% + (0.15 * 1), -3 + (1.5 * 3), %IDP% + (0.15 * 1), 7, 0, 0, 0, 0, 0
	AddDoorComponent 1, FreightDoor4, %ElevDoorTex%2, %ElevDoorTex%2, 0.15, right, 0.4, 0.3, -3 + (1.5 * 3), %IDP%, -3 + (1.5 * 4), %IDP%, 7, 0, 0, 0, 0, 0
	FinishDoors 1, false, false

		#Door track
		FloorOrientation = top
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevDoorTrackZ, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor DoorTrack, ElevDoorTrackZ, 0.05, -3 - (1.5 * 1), %IDP%, -3 + (1.5 * 5), %IDP% + (0.15 * 2), 0, 0, 0, 0

		#Top filler
		FloorOrientation = bottom
		DrawWalls = true, true, true, true, true, true
		TextureOverride %Prefix%ElevPanelTop, ElevExt, ElevExt, ElevExt, ElevExt, ElevExt
		AddFloor TopFiller, %Prefix%ElevPanelTop, 0.05, -3 + (1.5 * 1), %IDP%, -3 + (1.5 * 3), %IDP% + (0.15 * 1), 7, 7, 0, 0
	#--------------------
	#Button Panels
	Set P1_PositionX = 3.05 - 0.051
	Set P1_PositionZ = 4.44 - 0.525

		#Panel back
		CreateWallBox2 elevator, MainPB, ElevPanel, %P1_PositionX% + 0.051 - 0.025, %P1_PositionZ%, 0.05, 0.8, 4.875, 2, 0, 0, false, true, true, true

		#Panel
		CreatePanel , 7, 2, left, %P1_PositionX%, %P1_PositionZ%, 0.22, 0.11, 0.35, 0.35, 3.75, 0, 0

			#Buttons
			BtnPanelE7-8(1)

	#Elevator number sign
	DrawWalls = true, false, false, false, false, false
	AddWall ElevNo%elevator%_Inside, IN_ElevNo%elevator%, 0, 0 - 0.25, 4.44 - 0.001, 0 + 0.25, 4.44 - 0.001, 0.5, 0.5, 7.05, 7.05, 0, 0

	#Indicator sets
	AddFloorIndicator T4VRInd_Button, left, %P1_PositionX% - 0.001, %P1_PositionZ%, 0.6, 0.3, 5.75 + 0.25 - (0.3 / 2)
	AddDirectionalIndicator true, true, true, Blank, T4VRArrowUp, T4VRArrowUpLit, T4VRArrowDown, T4VRArrowDownLit, %P1_PositionX% - 0.001, %P1_PositionZ% + (0.3 / 2), 5.75 + 0.25 - (0.3 / 2), left, 0.3, 0.3, true, 0, 0
	#--------------------
	#Proximity scanner
	Set PSscanHeight = 0.45
	Set PScanWidth = %PSscanHeight% * 0.712

	DrawWalls = true, false, false, false, false, false
	AddWall ProximityScanner, HIDScanRed, 0, %P1_PositionX% - 0.001, %P1_PositionZ% - (%PScanWidth% / 2), %P1_PositionX% - 0.001, %P1_PositionZ% + (%PScanWidth% / 2), %PSscanHeight%, %PSscanHeight%, 4.875, 4.875, 0, 0
	#--------------------
	#Shaft components
	DrawWalls = true, true, true, true, true, true
		#Ropes
		RopePosition = 0, 8 + 0.2, 0
		RopeTexture = Ropes
	
		#Counterweight
		Set Position = 3.25 + 0.8
		if[%elevator% = 10] Set Position = -3.25 - 0.8
		CreateCounterweight CWeight_Frame, CWeight, %Position%, 0, 0.5, 6, 2, 0.5
	
		#Rails
		AddRails ElevRail, ElevRailSide, 0, 0, false, 3.25 + 0.06, 0.1
		AddRails ElevRail, ElevRailSide, %Position%, 0, true, 1 + 0.06, 0.1
<EndElevators>

##--------------------------------------------------------------------------------##

#HALL STATIONS
#Set textures (Passenger)
<Function ElevHallTex>
	TexPrefix() #Set prefixes for shaft doors
	if[%floor% = 1] Set 5 = Mezzanine #Override for the mezzanine

	#Shaft doors
	Set DoorTexture = %5%ShaftDoors

	#Use automatic filler walls or not
	Set AutoFiller = false
	
	#Deco types 
		#True: Custom door decos
		#False: Filler walls matching with the shaft walls
		
		Set DecoType = true
		if[%floor% = -1 | %floor% > 6] Set DecoType = false

	#Door trims
		#Sides
		Set DoorTrimTexture = %DoorTexture%_Trim

		#Top
		Set DoorTrimTexture_Top = %DoorTrimTexture%

	#Deco dimensions
		Set SideDecoH = %height%
		Set TopDecoH = %height% - 7

	#Call button panels
	Set BPanelTexture = ElevExtPanels
	Set ButtonPrefix = T2Button

	#Lantern panels
	Set LPanelTexture = %BPanelTexture%
	Set LanternPrefix = T2Lantern

		#Lateral offset for lantern panels
		Set ExtraLateralOffset = 0
		if[%floor% > -1 & %floor% < 7] Set ExtraLateralOffset = 0.05
<EndFunction>

#Patient Transport Elevators (No. 1-2)
<Floors 0 to 6>
	#Shaft Doors
	ElevHallTex() #Set shaft door and panel textures
	Set StartNo = 1 #Number of the first elevator

	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = -4.64 - 0.4

	WallOrientation = right
	AddShaftDoorComponent %StartNo%, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, left, 0.8, 0.6, 2.75 - (2.25 * 1), %IDP%, 2.75, %IDP%, 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo%, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, left, 0.4, 0.3, 2.75 - (2.25 * 2), %IDP% - (0.15 * 1), 2.75 - (2.25 * 1), %IDP% - (0.15 * 1), 7, 0, -1, 0, -1, 0
	FinishShaftDoor %StartNo%, 1, %AutoFiller%, false

	WallOrientation = right
	AddShaftDoorComponent %StartNo% + 1, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, left, 0.8, 0.6, 2.75 - (2.25 * 1), %IDP%, 2.75, %IDP%, 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo% + 1, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, left, 0.4, 0.3, 2.75 - (2.25 * 2), %IDP% - (0.15 * 1), 2.75 - (2.25 * 1), %IDP% - (0.15 * 1), 7, 0, -1, 0, -1, 0
	FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(1, 1, -4 - 4.5, -4 + 2.25, -5.34, -5.34 + 0.3, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(2, 1, 6 - 4.5, 6 + 2.25, -5.34, -5.34 + 0.3, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)

	#Top filler
	AddShaftTrack(1, 1, -4, -4 + 2.25, -5.34, -5.34 + 0.15, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)
	AddShaftTrack(2, 1, 6, 6 + 2.25, -5.34, -5.34 + 0.15, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)

	#Gap filler
		WallOrientation = left
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 1, GapFiller_E1, ElevExt, 0.15 * 2, -4 + 2.25, -5.34, -4 + 2.25 + 0.25, -5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 1, GapFiller_E2, ElevExt, 0.15 * 2, 6 + 2.25, -5.34, 6 + 2.25 + 0.25, -5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0

	#****************************************#

	#Door trims/fillers
	TexPrefix() #Reset texture prefixes
	Set Shaft1CX = -10
	Set Shaft1CZ = 44

		#Floors with decos
		if[%DecoType% = true] AddDecoObject(Elev1_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, front, true, false, 0.05, 0.2, %Shaft1CX% - 4, %Shaft1CZ% - 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, floor)
		if[%DecoType% = true] AddDecoObject(Elev2_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, front, true, false, 0.05, 0.2, %Shaft1CX% + 6, %Shaft1CZ% - 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, floor)

		#Floors with trims matching with the walls
		WallOrientation = left
		if[%DecoType% = false] AddFillerWalls %5%%ELSuffix%, 0.66, %Shaft1CX% - 4, %Shaft1CZ% - 6, 4.5, 7, 0, true, 0, 0, fals #Elevator 1
		if[%DecoType% = false] AddFillerWalls %5%%ELSuffix%, 0.66, %Shaft1CX% + 6, %Shaft1CZ% - 6, 4.5, 7, 0, true, 0, 0, fals #Elevator 2

	#****************************************#

	#Call buttons
	CallButtonElevators = 1, 2
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 1, %Shaft1CZ% - 6.001, 3.5, front, 0.5, 1, true, 0, 0

		#Signs
		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		AddWall E1-2HallSign, FireSign, 0, %Shaft1CX% + 1 - 0.25, %Shaft1CZ% - 6.001, %Shaft1CX% + 1 + 0.25, %Shaft1CZ% - 6.001, 0.75, 0.75, 2.6, 2.6, 0, 0, false
		AddBoxSign(E1-2_FS1, ELFlrSign%floorid%, Blank, Blank, 0, true, false, false, %Shaft1CX% + 1, %Shaft1CZ% - 6.001, 1, 1, 5.5, false)
		#if[%floor% = 0 | %floor% = 6] AddBoxSign(Bank1Sign, DHBElevBank1, DHBElevBank1, Blank, 0, true, false, false, %Shaft1CX% + 1, %Shaft1CZ% - 6.001, 3, 2, 7.5 - 2, false)
		AddBoxSign(Bank1Sign, DHBElevBank1A, DHBElevBank1A, Blank, 0, true, false, false, %Shaft1CX% + 1, %Shaft1CZ% - 6.001, 1.8, 0.9, 8 - 0.9, false)

	#****************************************#

	#Indicator sets
	Set Offset = 7.5

		#Set textures
		ACMEInd_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, T4VR_OInd_Button)

		#Indicator creation
		ACMELobbyInds(front, 1, %Shaft1CX% - 4, %Shaft1CZ% - 6 - %ExtraLateralOffset%, %Offset%, 0, 6)
		ACMELobbyInds(front, 2, %Shaft1CX% + 6, %Shaft1CZ% - 6 - %ExtraLateralOffset%, %Offset%, 0, 6)

	#****************************************#

	#Elevator number signs
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 0] AddWall E1Sign, ElevNo1, 0, (%Shaft1CX% - 4 - 1.25) - 0.25, %Shaft1CZ% - 6 - %ExtraLateralOffset% - 0.001, (%Shaft1CX% - 4 - 1.25) + 0.25, %Shaft1CZ% - 6 - %ExtraLateralOffset% - 0.001, 0.5, 0.5, %Offset%, %Offset%, 0, 0, false
	if[%floor% = 0] AddWall E2Sign, ElevNo2, 0, (%Shaft1CX% + 6 - 1.25) - 0.25, %Shaft1CZ% - 6 - %ExtraLateralOffset% - 0.001, (%Shaft1CX% + 6 - 1.25) + 0.25, %Shaft1CZ% - 6 - %ExtraLateralOffset% - 0.001, 0.5, 0.5, %Offset%, %Offset%, 0, 0, false
<EndFloors>

#Main Elevators (No. 3-6)
<Function E3-6HallStation>
	#Shaft Doors
	ElevHallTex() #Set shaft door and panel textures
	Set StartNo = 3 #Number of the first elevator

	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = 4.64 + 0.4

	WallOrientation = left
	AddShaftDoorComponent %StartNo%, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, right, 0.8, 0.6, -2.75, %IDP%, -2.75 + (2.25 * 1), %IDP%, 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo%, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.4, 0.3, -2.75 + (2.25 * 1), %IDP% + (0.15 * 1), -2.75 + (2.25 * 2), %IDP% + (0.15 * 1), 7, 0, -1, 0, -1, 0
	FinishShaftDoor %StartNo%, 1, %AutoFiller%, false

	WallOrientation = left
	AddShaftDoorComponent %StartNo% + 1, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, right, 0.8, 0.6, -2.75, %IDP%, -2.75 + (2.25 * 1), %IDP%, 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo% + 1, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.4, 0.3, -2.75 + (2.25 * 1), %IDP% + (0.15 * 1), -2.75 + (2.25 * 2), %IDP% + (0.15 * 1), 7, 0, -1, 0, -1, 0
	FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false

	WallOrientation = left
	AddShaftDoorComponent %StartNo% + 2, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, right, 0.8, 0.6, -2.75, %IDP%, -2.75 + (2.25 * 1), %IDP%, 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo% + 2, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.4, 0.3, -2.75 + (2.25 * 1), %IDP% + (0.15 * 1), -2.75 + (2.25 * 2), %IDP% + (0.15 * 1), 7, 0, -1, 0, -1, 0
	FinishShaftDoor %StartNo% + 2, 1, %AutoFiller%, false

	WallOrientation = left
	AddShaftDoorComponent %StartNo% + 3, 1, 2Speed_Fast, %DoorTexture%, %DoorTexture%, 0.15, right, 0.8, 0.6, -2.75, %IDP%, -2.75 + (2.25 * 1), %IDP%, 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo% + 3, 1, 2Speed_Slow, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.4, 0.3, -2.75 + (2.25 * 1), %IDP% + (0.15 * 1), -2.75 + (2.25 * 2), %IDP% + (0.15 * 1), 7, 0, -1, 0, -1, 0
	FinishShaftDoor %StartNo% + 3, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(3, 2, 14 - 2.25, 14 + 4.5, 5.34 - 0.3, 5.34, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(4, 2, 4 - 2.25, 4 + 4.5, 5.34 - 0.3, 5.34, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(5, 2, -6 - 2.25, -6 + 4.5, 5.34 - 0.3, 5.34, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(6, 2, -16 - 2.25, -16 + 4.5, 5.34 - 0.3, 5.34, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)

	#Top filler
	AddShaftTrack(3, 2, 14 - 2.25, 14, 5.34 - 0.15, 5.34, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)
	AddShaftTrack(4, 2, 4 - 2.25, 4, 5.34 - 0.15, 5.34, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)
	AddShaftTrack(5, 2, -6 - 2.25, -6, 5.34 - 0.15, 5.34, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)
	AddShaftTrack(6, 2, -16 - 2.25, -16, 5.34 - 0.15, 5.34, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)

	#Gap filler
		WallOrientation = right
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 2, GapFiller_E3, ElevExt, 0.15 * 2, 14 - 2.25 - 0.25, 5.34, 14 - 2.25, 5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 2, GapFiller_E4, ElevExt, 0.15 * 2, 4 - 2.25 - 0.25, 5.34, 4 - 2.25, 5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 2, GapFiller_E5, ElevExt, 0.15 * 2, -6 - 2.25 - 0.25, 5.34, -6 - 2.25, 5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0
		TextureOverride ElevExt, ElevExt, %DoorTrimTexture%, %DoorTrimTexture%, ElevExt, ElevExt
		AddShaftWall 2, GapFiller_E6, ElevExt, 0.15 * 2, -16 - 2.25 - 0.25, 5.34, -16 - 2.25, 5.34, 7, 7, %interfloorheight%, %interfloorheight%, 0, 0

	#****************************************#

	#Door trims/fillers
	TexPrefix() #Reset texture prefixes
	if[%floor% = 0] Set SideDecoH = %height% + Floor(1).FullHeight #Override for lobby
	if[%floor% = 0] Set TopDecoH = %SideDecoH% - 7 #Override for lobby
	Set Shaft1CX = 0
	Set Shaft1CZ = 0

		#Floors with decos
		if[%DecoType% = true] AddDecoObject(Elev3_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + 14, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, floor)
		if[%DecoType% = true] AddDecoObject(Elev4_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + 4, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, floor)
		if[%DecoType% = true] AddDecoObject(Elev5_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + -6, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, floor)
		if[%DecoType% = true] AddDecoObject(Elev6_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + -16, %Shaft1CZ% + 6, 4.5, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, floor)

		#Floors with trims matching with the walls
		WallOrientation = right
		if[%DecoType% = false] AddFillerWalls %5%%ELSuffix%, 0.66, %Shaft1CX% + 14, %Shaft1CZ% + 6, 4.5, 7, 0, true, 0, 0, false #Elevator 3
		if[%DecoType% = false] AddFillerWalls %5%%ELSuffix%, 0.66, %Shaft1CX% + 4, %Shaft1CZ% + 6, 4.5, 7, 0, true, 0, 0, false
		if[%DecoType% = false] AddFillerWalls %5%%ELSuffix%, 0.66, %Shaft1CX% - 6, %Shaft1CZ% + 6, 4.5, 7, 0, true, 0, 0, false
		if[%DecoType% = false] AddFillerWalls %5%%ELSuffix%, 0.66, %Shaft1CX% - 16, %Shaft1CZ% + 6, 4.5, 7, 0, true, 0, 0, false

	#****************************************#

	#Call buttons
	CallButtonElevators = 3, 4, 5, 6
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% + 9, %Shaft1CZ% + 6.001, 3.5, back, 0.5, 1, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% - 1, %Shaft1CZ% + 6.001, 3.5, back, 0.5, 1, true, 0, 0
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX% - 11, %Shaft1CZ% + 6.001, 3.5, back, 0.5, 1, true, 0, 0

		#Signs
		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		AddWall E5-8HallSign, FireSign, 0, %Shaft1CX% - 1 - 0.25, %Shaft1CZ% + 6.001, %Shaft1CX% - 1 + 0.25, %Shaft1CZ% + 6.001, 0.75, 0.75, 2.6, 2.6, 0, 0, false
		AddBoxSign(E5-8_FS1, Blank, ELFlrSign%floorid%, Blank, 0, true, false, false, %Shaft1CX% + 9, %Shaft1CZ% + 6.001, 1, 1, 5.5, false)
		AddBoxSign(E5-8_FS2, Blank, ELFlrSign%floorid%, Blank, 0, true, false, false, %Shaft1CX% - 11, %Shaft1CZ% + 6.001, 1, 1, 5.5, false)

	#****************************************#

	#Indicator sets
	Set Offset = 7.5

		#Set textures
		ACMEInd_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, T4VR_OInd_Button)

		#Indicator creation
		ACMELobbyInds(back, 3, %Shaft1CX% + 14, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, 0, 6)
		ACMELobbyInds(back, 4, %Shaft1CX% + 4, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, 0, 6)
		ACMELobbyInds(back, 5, %Shaft1CX% - 6, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, 0, 6)
		ACMELobbyInds(back, 6, %Shaft1CX% - 16, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, 0, 6)

	#****************************************#

	#Elevator number signs
	Set Distance = 1.25
	if[%floor% ! 0] Set Distance = 1
	DrawWalls = false, true, false, false, false, false
	if[%floor% = 0] AddWall E3Sign, ElevNo3, 0, (%Shaft1CX% + 14 + %Distance%) - 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, (%Shaft1CX% + 14 + %Distance%) + 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, 0.5, 0.5, %Offset%, %Offset%, 0, 0, false
	if[%floor% = 0] AddWall E4Sign, ElevNo4, 0, (%Shaft1CX% + 4 + %Distance%) - 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, (%Shaft1CX% + 4 + %Distance%) + 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, 0.5, 0.5, %Offset%, %Offset%, 0, 0, false
	if[%floor% = 0] AddWall E5Sign, ElevNo5, 0, (%Shaft1CX% - 6 + %Distance%) - 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, (%Shaft1CX% - 6 + %Distance%) + 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, 0.5, 0.5, %Offset%, %Offset%, 0, 0, false
	if[%floor% = 0] AddWall E6Sign, ElevNo6, 0, (%Shaft1CX% - 16 + %Distance%) - 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, (%Shaft1CX% - 16 + %Distance%) + 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, 0.5, 0.5, %Offset%, %Offset%, 0, 0, false
<EndFunction>

<Floors 0 to 6>
	if[%floor% ! 1] E3-6HallStation()
<EndFloors>

#Set textures (Service)
<Function ElevHallTex_Service>
	TexPrefix() #Set prefixes for filler walls

	#Shaft doors
	Set DoorTexture = ServiceAShaftDoors
	if[%floor% = 15] Set DoorTexture = ServiceBShaftDoors
	if[%floor% = -1] Set DoorTexture = ServiceCShaftDoors

	#Use automatic filler walls or not
	Set AutoFiller = false
	
	#Deco types 
		#True: Custom door decos
		#False: Filler walls matching with the shaft walls
		
		Set DecoType = false
		#Set DecoType = true
		#if[%floor% = -1 | %floor% = 15] Set DecoType = false

	#Door trims
		#Sides
		Set DoorTrimTexture = %DoorTexture%_Trim

		#Top
		Set DoorTrimTexture_Top = %DoorTrimTexture%

	#Deco dimensions
		Set SideDecoH = 7.2
		Set TopDecoH = 0.2

	#Call button panels
	Set BPanelTexture = ElevExtPanels
	Set ButtonPrefix = TKVRButton

	#Lantern panels
	Set LPanelTexture = %BPanelTexture%
	Set LanternPrefix = TKVRLantern

		#Lateral offset for lantern panels
		Set ExtraLateralOffset = 0
		#Set ExtraLateralOffset = 0.05
<EndFunction>

#Service Elevators (No. 7-8)
<Floors 0 to 7>
	#Shaft Doors
	ElevHallTex_Service() #Set shaft door and panel textures
	Set StartNo = 7 #Number of the first elevator

	Set ElevDoorTex = %Prefix%ElevDoors
	Set IDP = 4.64 + 0.4

	WallOrientation = left
	AddShaftDoorComponent %StartNo%, 1, FreightDoor1, %DoorTexture%2, %DoorTexture%2, 0.15, left, 0.4, 0.3, -3, %IDP% + (0.15 * 1), -3 + (1.5 * 1), %IDP% + (0.15 * 1), 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo%, 1, FreightDoor2, %DoorTexture%, %DoorTexture%, 0.15, left, 0.8, 0.6, -3 + (1.5 * 1), %IDP%, -3 + (1.5 * 2), %IDP%, 7, 0, -1, 0, -1, 0
	AddShaftDoorComponent %StartNo%, 1, FreightDoor3, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.8, 0.6, -3 + (1.5 * 2), %IDP%, -3 + (1.5 * 3), %IDP%, 7, 0, -1, 0, -1, 0
	AddShaftDoorComponent %StartNo%, 1, FreightDoor4, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.4, 0.3, -3 + (1.5 * 3), %IDP% + (0.15 * 1), -3 + (1.5 * 4), %IDP% + (0.15 * 1), 7, 0, -1, 0, -1, 0
	FinishShaftDoor %StartNo%, 1, %AutoFiller%, false

	#WallOrientation = left
	AddShaftDoorComponent %StartNo% + 1, 1, FreightDoor1, %DoorTexture%2, %DoorTexture%2, 0.15, left, 0.4, 0.3, -3, %IDP% + (0.15 * 1), -3 + (1.5 * 1), %IDP% + (0.15 * 1), 7, 0, 0, 0, 0, 0
	AddShaftDoorComponent %StartNo% + 1, 1, FreightDoor2, %DoorTexture%, %DoorTexture%, 0.15, left, 0.8, 0.6, -3 + (1.5 * 1), %IDP%, -3 + (1.5 * 2), %IDP%, 7, 0, -1, 0, -1, 0
	AddShaftDoorComponent %StartNo% + 1, 1, FreightDoor3, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.8, 0.6, -3 + (1.5 * 2), %IDP%, -3 + (1.5 * 3), %IDP%, 7, 0, -1, 0, -1, 0
	AddShaftDoorComponent %StartNo% + 1, 1, FreightDoor4, %DoorTexture%2, %DoorTexture%2, 0.15, right, 0.4, 0.3, -3 + (1.5 * 3), %IDP% + (0.15 * 1), -3 + (1.5 * 4), %IDP% + (0.15 * 1), 7, 0, -1, 0, -1, 0
	FinishShaftDoor %StartNo% + 1, 1, %AutoFiller%, false

	#Door tracks
	AddShaftTrack(7, 3, 4.75 - 4.5, 4.75 + 4.5, 5.34 - 0.3, 5.34, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)
	AddShaftTrack(8, 3, -4.75 - 4.5, -4.75 + 4.5, 5.34 - 0.3, 5.34, ElevDoorTrackZ, ElevExt, 0.05, 1, 7)

	#Top filler
	AddShaftTrack(7, 3, 4.75 - 1.5, 4.75 + 1.5, 5.34 - 0.15, 5.34, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)
	AddShaftTrack(8, 3, -4.75 - 1.5, -4.75 + 1.5, 5.34 - 0.15, 5.34, %DoorTrimTexture%, ElevExt, 0.05, 2, 7)

	#****************************************#

	#Door trims/fillers
	TexPrefix() #Reset texture prefixes
	if[%floor% < 7] Set 5 = SA
	Set Shaft1CX = 10
	Set Shaft1CZ = 44

		#Floors with decos
		if[%DecoType% = true] AddDecoObject(Elev9_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% + 4.75, %Shaft1CZ% + 6, 6, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, floor)
		if[%DecoType% = true] AddDecoObject(Elev10_Deco, %DoorTrimTexture%, %DoorTrimTexture_Top%, back, true, false, 0.05, 0.2, %Shaft1CX% - 4.75, %Shaft1CZ% + 6, 6, 7, %SideDecoH%, %TopDecoH%, 0, true, %DoorTrimTexture%, 0.66, floor)

		#Floors with trims matching with the walls
		WallOrientation = right
		if[%DecoType% = false] AddFillerWalls %5%Wall, 0.66, %Shaft1CX% + 4.75, %Shaft1CZ% + 6, 6, 7, 0, true, 0, 0, false #Elevator 9
		if[%DecoType% = false] AddFillerWalls %5%Wall, 0.66, %Shaft1CX% - 4.75, %Shaft1CZ% + 6, 6, 7, 0, true, 0, 0, false #Elevator 10

	#****************************************#

	#Call buttons
	CallButtonElevators = 7, 8
	CreateCallButtons %BPanelTexture%, %ButtonPrefix%Up, %ButtonPrefix%UpLit, %ButtonPrefix%Down, %ButtonPrefix%DownLit, %Shaft1CX%, %Shaft1CZ% + 6.001, 3.5, back, 0.5, 1, true, 0, 0

		#Signs
		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		AddWall E9-10HallSign, FireSign, 0, %Shaft1CX% - 0.25, %Shaft1CZ% + 6.001, %Shaft1CX% + 0.25, %Shaft1CZ% + 6.001, 0.75, 0.75, 2.6, 2.6, 0, 0, false
		AddBoxSign(E9-10_FS1, Blank, BlankSign%floorid%, Blank, 0, true, false, false, %Shaft1CX%, %Shaft1CZ% + 6.001, 1.5, 1.5, 5.25, false)

	#****************************************#

	#Indicator sets
	Set Offset = 7.5

		#Set textures
		ACMEInd_LanternTex(%LanternPrefix%Up, %LanternPrefix%UpLit, %LanternPrefix%Down, %LanternPrefix%DownLit, %LPanelTexture%, T4VR_OInd_Button)

		#Indicator creation
		ACMELobbyInds(back, 7, %Shaft1CX% + 4.75, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, 0, 7)
		ACMELobbyInds(back, 8, %Shaft1CX% - 4.75, %Shaft1CZ% + 6 + %ExtraLateralOffset%, %Offset%, 0, 7)

	#****************************************#

	#Elevator number signs
	DrawWalls = false, true, false, false, false, false
	if[%floor% < 7] AddWall E7Sign, ElevNo7, 0, (%Shaft1CX% + 4.75 + 1.25) - 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, (%Shaft1CX% + 4.75 + 1.25) + 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, 0.5, 0.5, %Offset%, %Offset%, 0, 0, false
	if[%floor% < 7] AddWall E8Sign, ElevNo8, 0, (%Shaft1CX% - 4.75 + 1.25) - 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, (%Shaft1CX% - 4.75 + 1.25) + 0.25, %Shaft1CZ% + 6 + %ExtraLateralOffset% + 0.001, 0.5, 0.5, %Offset%, %Offset%, 0, 0, false
<EndFloors>

##--------------------------------------------------------------------------------##

#Elevator global settings
<Elevators 1 to 8>
	#Recall floor and notifications
	QueueResets = true
	RecallFloor = 0
	NotifyEarly = 1

	UpChimeSound 1 = Other People's Fixtures/TK Traditional II/upchime.wav #Vector, gooper1, et al.
	DownChimeSound 1 = Other People's Fixtures/TK Traditional II/dnchime.wav #Vector, gooper1, et al.

	#Door settings
	DoorTimer 1 = 15000
	QuickClose 1 = 10000
	OpenSound 1 = EG881Sounds/freightelevatoropen3.wav #EG881
	CloseSound 1 = EG881Sounds/freightelevatorclose3.wav #EG881
	if[%elevator% > 6] OpenSound 1 = EG881Sounds/freightelevatoropen1.wav #EG881
	if[%elevator% > 6] CloseSound 1 = EG881Sounds/freightelevatorclose1.wav #EG881

	#Beep sound(s)
	if[%elevator% < 7] BeepSound = Other People's Fixtures/signa4/tkbeep.wav #Vector, gooper1, et al.

	#Movement Sounds
	MotorStartSound = EG881Sounds/motor_start3.wav #EG881
	MotorRunSound = EG881Sounds/motor_running3.wav #EG881
	MotorStopSound = EG881Sounds/motor_stop3.wav #EG881

	CarStartSound = EG881Sounds/elevstart11.wav #EG881
	CarMoveSound = EG881Sounds/elevmove11.wav #EG881
	CarStopSound = EG881Sounds/elevstop11.wav #EG881
<EndElevators>

##--------------------------------------------------------------------------------##

#STAIRWELLS
<Function StairwellSets>
	#Set Values
	Set NumSteps = 12 #Total: 24 steps
	if[%floor% > 6] Set NumSteps = 11 #Total: 22 steps
	
	#Extra sets at transition points
	Set NumSteps2 = %NumSteps%
	if[%floor% = 7] Set NumSteps2 = 12
<EndFunction>

#North Stairwell
CreateStairwell 1, -7.5, 65, 0, 9
CutStairwell 1, -12, -4.5, 12, 4.5, 0, 5
ShowFullStairs 1 = always

<Floors 0 to 9>
	StairwellSets() #Determine stairs' size

	Set 21 = -7.5 #Center X
	Set 22 = 65 #Center Z
	Set 23 = 12 #Cut X
	Set 24 = 4.5 #Cut Z
	Set 25 = 1 #Stairwell Number
	Set 26 = 0.5 #Riser Size

	#Walls
	WallOrientation = right
	DrawWalls = false, true, false, false, false, false
	AddStairsWall %25%, Stair%25%Front, StairsWall, 0.5, -%23%, -%24%, %23%, -%24%, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0
	AddStairsWall %25%, Stair%25%Left, StairsWall, 0.5, -%23%, -%24%, -%23%, %24%, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0
	WallOrientation = left
	DrawWalls = true, false, false, false, false, false
	AddStairsWall %25%, Stair%25%Right, StairsWall, 0.5, %23%, -%24%, %23%, %24%, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0
	AddStairsWall %25%, Stair%25%Back, StairsWall, 0.5, -%23%, %24%, %23%, %24%, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0

	WallOrientation = center
	DrawWalls = true, true, true, true, false, true
	AddStairsWall %25%, Stair%25%Center, StairsWall2, 1, -%23% + 5, 0, -%23% + 5 + %NumSteps%, 0, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0

	DrawWalls = true, true, true, true, true, true
	if[%floor% = 7] AddStairsWall %25%, Stair%25%Center-Trans, StairsWall2, 1, -%23% + 5 + %NumSteps%, 0, -%23% + 5 + %NumSteps2%, 0, %interfloorheight% + 3, %interfloorheight% + 3, -%interfloorheight%, -%interfloorheight%, 0, 0

	#Railing
	WallOrientation = right
	DrawWalls = true, true, true, false, true, true
	if[%floor% = 9] AddStairsWall %25%, Stair%25%Rail, StairsWall2, 0.5, -%23% + 5 + %NumSteps%, %24% - 4, -%23% + 5 + %NumSteps%, %24%, 0.5 + 3.5, 0.5 + 3.5, -0.5, -0.5, 0, 0

	#Ceiling
	FloorOrientation = top
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 9] AddStairsFloor %25%, Stairs%25%Ceiling, StairsCeiling, 0.5, -%23%, -%24%, %23%, %24%, %height%, %height%, false, false, 0, 0

	#Stairs
	OP_Draw(true, true, true, true, true, true)
	if[%floor% < 9] OP_OrthoStair(%25%, ST%25%_LowerStairs, Stairs, %24% - 4, %24%, right, -%23% + 5 + %NumSteps%, %NumSteps%, 1, %26%, 0, 0.5)
	if[%floor% < 9] OP_OrthoStair(%25%, ST%25%_UpperStairs, Stairs, -%24%, -%24% + 4, left, -%23% + 5, %NumSteps%, 1, %26%, %26% * %NumSteps%, 0.5)

	#Landings
	FloorOrientation = top
	DrawWalls = true, true, false, false, false, false
	if[%floor% = 0] AddStairsFloor %25%, Stairs%25%LandingLower, StairsFloor, 0.5, -%23%, -%24%, %23%, %24%, 0, 0, false, false, 0, 0
	if[%floor% > 0] AddStairsFloor %25%, Stairs%25%LandingLower, StairsFloor, 0.5, -%23% + 5 + %NumSteps2%, -%24%, %23%, %24%, 0, 0, false, false, 0, 0
	if[%floor% = 7] AddStairsFloor %25%, Stairs%25%Transition, StairsFloor, 0.5, -%23% + 5 + %NumSteps%, %24% - 4, -%23% + 5 + %NumSteps2%, %24%, 0, 0, false, false, 0, 0
	if[%floor% < 9] AddStairsFloor %25%, Stairs%25%LandingUpper, StairsFloor, 0.5, -%23%, -%24%, -%23% + 5, %24%, %26% * %NumSteps%, %26% * %NumSteps%, false, false, 0, 0

	#Floor Signs
	Set Suffix = %floorid%
	Set SignCenterPoint = 0

	DrawWalls = true, false, false, false, false, false
	AddStairsWall %25%, ST%25%FloorSign, BlankSign%Suffix%, 0, %23% - 0.001, %SignCenterPoint% - 1, %23% - 0.001, %SignCenterPoint% + 1, 2, 2, 4 - 0.5, 4 - 0.5, 0, 0

	#Doors
	WallOrientation = left
	TextureOverride ServiceDoor2, ServiceDoor2B, ServiceDoor2Side, ServiceDoor2Side, ServiceDoor2Side, ServiceDoor2Side
	if[%floor% = 0] AddStairsDoor %25%, , , false, ServiceDoor2, 0.2, 5, 75, %23% - 2, -%24% - 0.5, 3, 7, 0, 0, 0

	WallOrientation = right
	TextureOverride ServiceDoor2B, ServiceDoor2, ServiceDoor2Side, ServiceDoor2Side, ServiceDoor2Side, ServiceDoor2Side
	if[%floor% ! 0] AddStairsDoor %25%, , , false, ServiceDoor2, 0.2, 6, 75, %23% - 2, -%24%, 3, 7, 0, 0, 0

		#Manual fillers (external mesh)
		WallOrientation = right
		if[%floor% = 9] AddFillerWalls ServiceDoor2Side, 0.5, %21% + %23% - 2, %22% - %24%, 3, 7 - 0.001, %interfloorheight%, true, 0, 0, true

	#Exit Signs
	Set SignTex = ExitSign
	#if[%floor% < 0] Set SignTex = ExitSignUp

	if[%floor% ! 0] AddBoxSign(Stair%25%_SignMain, %SignTex%, StainlessSteel, StainlessSteel, 0.1, true, true, true, %21% + %23% - 2, %22% - %24% - 0.55, 1.8, 0.9, %interfloorheight% + 7.2, true)
	if[%floor% ! 0] AddBoxSign(Stair%25%_SignHall, ExitSignLeft, ExitSignRight, StainlessSteel, 0.1, false, true, true, %21% + %23% - 2, 55, 1.8, 0.9, %fullheight% - 0.9, true)
	if[%floor% = 0] AddBoxSign(Stair%25%_SignGroundLevel, StainlessSteel, ExitSign, StainlessSteel, 0.1, true, true, true, %21% + %23% - 2, %22% - %24% + 0.05, 1.8, 0.9, %interfloorheight% + 7.2, true)

	if[%floor% ! 0 & %floor% ! 1 & %floor% ! 9] AddBoxSign(Stair%25%_SignHall_W, ExitSignRight, ExitSignLeft, StainlessSteel, 0.1, true, true, true, -25, 55, 1.8, 0.9, %height% - 0.9, false)
	if[%floor% ! 0 & %floor% ! 7 & %floor% ! 9] AddBoxSign(Stair%25%_SignHall_E, ExitSignLeft, ExitSignRight, StainlessSteel, 0.1, true, true, true, 25, 55, 1.8, 0.9, %height% - 0.9, false)
<EndFloors>

#South Stairwell
CreateStairwell 2, -7.5, -65, 0, 6
CutStairwell 2, -12, -4.5, 12, 4.5, 0, 5

<Floors 0 to 6>
	StairwellSets() #Determine stairs' size

	Set 21 = -7.5 #Center X
	Set 22 = -65 #Center Z
	Set 23 = 12 #Cut X
	Set 24 = 4.5 #Cut Z
	Set 25 = 2 #Stairwell Number
	Set 26 = 0.5 #Riser Size

	#Walls
	WallOrientation = right
	DrawWalls = false, true, false, false, false, false
	AddStairsWall %25%, Stair%25%Front, StairsWall, 0.5, -%23%, -%24%, %23%, -%24%, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0
	AddStairsWall %25%, Stair%25%Left, StairsWall, 0.5, -%23%, -%24%, -%23%, %24%, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0
	WallOrientation = left
	DrawWalls = true, false, false, false, false, false
	AddStairsWall %25%, Stair%25%Right, StairsWall, 0.5, %23%, -%24%, %23%, %24%, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0
	AddStairsWall %25%, Stair%25%Back, StairsWall, 0.5, -%23%, %24%, %23%, %24%, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0

	WallOrientation = center
	DrawWalls = true, true, true, true, false, true
	AddStairsWall %25%, Stair%25%Center, StairsWall2, 1, -%23% + 5, 0, -%23% + 5 + %NumSteps%, 0, %fullheight%, %fullheight%, -%interfloorheight%, -%interfloorheight%, 0, 0

	#DrawWalls = true, true, true, true, true, true
	#if[%floor% = 7] AddStairsWall %25%, Stair%25%Center-Trans, StairsWall2, 1, -%23% + 5 + %NumSteps%, 0, -%23% + 5 + %NumSteps2%, 0, %interfloorheight% + 3, %interfloorheight% + 3, -%interfloorheight%, -%interfloorheight%, 0, 0

	#Railing
	WallOrientation = right
	DrawWalls = true, true, true, false, true, true
	if[%floor% = 6] AddStairsWall %25%, Stair%25%Rail, StairsWall2, 0.5, -%23% + 5 + %NumSteps%, -%24%, -%23% + 5 + %NumSteps%, -%24% + 4, 0.5 + 3.5, 0.5 + 3.5, -0.5, -0.5, 0, 0

	#Ceiling
	FloorOrientation = top
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 6] AddStairsFloor %25%, Stairs%25%Ceiling, StairsCeiling, 0.5, -%23%, -%24%, %23%, %24%, %height%, %height%, false, false, 0, 0

	#Stairs
	OP_Draw(true, true, true, true, true, true)
	if[%floor% < 6] OP_OrthoStair(%25%, ST%25%_LowerStairs, Stairs, -%24%, -%24% + 4, right, -%23% + 5 + %NumSteps%, %NumSteps%, 1, %26%, 0, 0.5)
	if[%floor% < 6] OP_OrthoStair(%25%, ST%25%_UpperStairs, Stairs, %24% - 4, %24%, left, -%23% + 5, %NumSteps%, 1, %26%, %26% * %NumSteps%, 0.5)

	#Landings
	FloorOrientation = top
	DrawWalls = true, true, false, false, false, false
	if[%floor% = 0] AddStairsFloor %25%, Stairs%25%LandingLower, StairsFloor, 0.5, -%23%, -%24%, %23%, %24%, 0, 0, false, false, 0, 0
	if[%floor% > 0] AddStairsFloor %25%, Stairs%25%LandingLower, StairsFloor, 0.5, -%23% + 5 + %NumSteps2%, -%24%, %23%, %24%, 0, 0, false, false, 0, 0
	#if[%floor% = 7] AddStairsFloor %25%, Stairs%25%Transition, StairsFloor, 0.5, -%23% + 5 + %NumSteps%, -%24%, -%23% + 5 + %NumSteps2%, -%24% + 4, 0, 0, false, false, 0, 0
	if[%floor% < 6] AddStairsFloor %25%, Stairs%25%LandingUpper, StairsFloor, 0.5, -%23%, -%24%, -%23% + 5, %24%, %26% * %NumSteps%, %26% * %NumSteps%, false, false, 0, 0

	#Floor Signs
	Set Suffix = %floorid%
	Set SignCenterPoint = 0

	DrawWalls = true, false, false, false, false, false
	AddStairsWall %25%, ST%25%FloorSign, BlankSign%Suffix%, 0, %23% - 0.001, %SignCenterPoint% - 1, %23% - 0.001, %SignCenterPoint% + 1, 2, 2, 4 - 0.5, 4 - 0.5, 0, 0

	#Doors
	WallOrientation = right
	TextureOverride ServiceDoor2B, ServiceDoor2, ServiceDoor2Side, ServiceDoor2Side, ServiceDoor2Side, ServiceDoor2Side
	if[%floor% = 0] AddStairsDoor %25%, , , false, ServiceDoor2, 0.2, 6, 75, %23% - 2, %24% + 0.5, 3, 7, 0, 0, 0

	WallOrientation = left
	TextureOverride ServiceDoor2, ServiceDoor2B, ServiceDoor2Side, ServiceDoor2Side, ServiceDoor2Side, ServiceDoor2Side
	if[%floor% ! 0] AddStairsDoor %25%, , , false, ServiceDoor2, 0.2, 5, 75, %23% - 2, %24%, 3, 7, 0, 0, 0

		#Manual fillers
		WallOrientation = right
		AddFillerWalls ServiceDoor2Side, 0.5, %21% + %23% - 2, %22% + %24% + 0.5, 3, 7 - 0.001, 0, true, 0, 0, false

	#Exit Signs
	Set SignTex = ExitSign
	#if[%floor% < 0] Set SignTex = ExitSignUp

	if[%floor% ! 0] AddBoxSign(Stair%25%_SignMain, StainlessSteel, %SignTex%, StainlessSteel, 0.1, true, true, true, %21% + %23% - 2, %22% + %24% + 0.55, 1.8, 0.9, 7.2, false)
	if[%floor% ! 0] AddBoxSign(Stair%25%_SignHall, ExitSignRight, ExitSignLeft, StainlessSteel, 0.1, false, true, true, %21% + %23% - 2, -55, 1.8, 0.9, %height% - 0.9, false)
	if[%floor% = 0] AddBoxSign(Stair%25%_SignGroundLevel, ExitSign, StainlessSteel, StainlessSteel, 0.1, true, true, true, %21% + %23% - 2, %22% + %24% - 0.05, 1.8, 0.9, %interfloorheight% + 7.2, true)

	if[%floor% ! 0 & %floor% ! 1] AddBoxSign(Stair%25%_SignHall_W, ExitSignRight, ExitSignLeft, StainlessSteel, 0.1, true, true, true, -25, -55, 1.8, 0.9, %height% - 0.9, false)
	if[%floor% ! 0] AddBoxSign(Stair%25%_SignHall_E, ExitSignLeft, ExitSignRight, StainlessSteel, 0.1, true, true, true, 25, -55, 1.8, 0.9, %height% - 0.9, false)
<EndFloors>

##--------------------------------------------------------------------------------##

#Automatic doors
	#Include script
	<Include AutomaticDoor2013/Scripts/r3_script.txt>

	#West Entrances
	WallOrientation = right
	AddAutomaticDoor2(9, 1, 0, -59.5, 75, AutoDoorsExt, AutoDoorsInt, AutoDoorsExt, AutoDoorsInt, AutoDoors_Side, 2, 0.15, false, left, 10, 9, 0, 1, 15000, elevopenquick.wav, elevclosequick.wav, , true, true, 5, W1Ent_SensorUnlit, W1Ent_SensorLit)
	AddAutomaticDoor2(10, 1, 0, -59.5, 45, AutoDoorsExt, AutoDoorsInt, AutoDoorsExt, AutoDoorsInt, AutoDoors_Side, 2, 0.15, false, left, 10, 9, 0, 1, 15000, elevopenquick.wav, elevclosequick.wav, , true, true, 5, W2Ent_SensorUnlit, W2Ent_SensorLit)

	#East Entrances
