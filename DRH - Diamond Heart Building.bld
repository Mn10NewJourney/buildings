	AddAutomaticDoor2(11, 1, 0, 59.5, -15, AutoDoorsInt_Plaza, AutoDoorsExt_Plaza, AutoDoorsInt_Plaza, AutoDoorsExt_Plaza, AutoDoors_Side, 2, 0.15, false, left, 10, 9, 0, 1, 15000, elevopenquick.wav, elevclosequick.wav, , true, true, 5, E1Ent_SensorUnlit, E1Ent_SensorLit)
	AddAutomaticDoor2(12, 1, 0, 59.5, 15, AutoDoorsInt_Plaza, AutoDoorsExt_Plaza, AutoDoorsInt_Plaza, AutoDoorsExt_Plaza, AutoDoors_Side, 2, 0.15, false, left, 10, 9, 0, 1, 15000, elevopenquick.wav, elevclosequick.wav, , true, true, 5, E2Ent_SensorUnlit, E2Ent_SensorLit)

	<Floor 0>
		TexPrefix() #Set wall texture

		#Create filler walls and windows
			#Filler walls
			WallOrientation = left
			AddFillerWalls %5%Wall, 0.5, -60, 75, (10 * 2) + 0.3, 9 + 1.25, %interfloorheight%, false, 0, 0, true #West doors
			AddFillerWalls %5%Wall, 0.5, -60, 45, (10 * 2) + 0.3, 9 + 1.25, %interfloorheight%, false, 0, 0, true

			WallOrientation = right
			AddFillerWalls %5%Wall, 0.5, 60, -15, (10 * 2) + 0.3, 9 + 1.25, %interfloorheight%, false, 0, 0, true #East doors
			AddFillerWalls %5%Wall, 0.5, 60, 15, (10 * 2) + 0.3, 9 + 1.25, %interfloorheight%, false, 0, 0, true

			#Decos
			AddDecoObject(W1Ent_Deco, AD_Deco, AD_Deco, right, true, false, 0.5, 0.15, -60, 75, 10*2, 9, 9 + 1.25, 1.25, 0, false, Blank, 0, external)
			AddDecoObject(W2Ent_Deco, AD_Deco, AD_Deco, right, true, false, 0.5, 0.15, -60, 45, 10*2, 9, 9 + 1.25, 1.25, 0, false, Blank, 0, external)

			AddDecoObject(E1Ent_Deco, AD_Deco, AD_Deco, left, true, false, 0.5, 0.15, 60, -15, 10*2, 9, 9 + 1.25, 1.25, 0, false, Blank, 0, external)
			AddDecoObject(E2Ent_Deco, AD_Deco, AD_Deco, left, true, false, 0.5, 0.15, 60, 15, 10*2, 9, 9 + 1.25, 1.25, 0, false, Blank, 0, external)

			#Windows around west doors
			WallOrientation = right
			SetAutoSize = false, false
			DrawWalls = true, true, true, true, false, false
			TextureOverride ADWindows, ADWindows, ADWindows_Side, ADWindows_Side, ADWindows_Side, ADWindows_Side
			AddWall W1Ent_Windows1, ADWindows, 0.15, -59.65, 75 - 10, -59.65, 75 - 5, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true
			TextureOverride ADWindows, ADWindows, ADWindows_Side, ADWindows_Side, ADWindows_Side, ADWindows_Side
			AddWall W1Ent_Windows2, ADWindows, 0.15, -59.65, 75 + 5, -59.65, 75 + 10, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true

			TextureOverride ADWindows, ADWindows, ADWindows_Side, ADWindows_Side, ADWindows_Side, ADWindows_Side
			AddWall W2Ent_Windows1, ADWindows, 0.15, -59.65, 45 - 10, -59.65, 45 - 5, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true
			TextureOverride ADWindows, ADWindows, ADWindows_Side, ADWindows_Side, ADWindows_Side, ADWindows_Side
			AddWall W2Ent_Windows2, ADWindows, 0.15, -59.65, 45 + 5, -59.65, 45 + 10, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true
			SetAutoSize = true, true

			#Windows around east doors
			WallOrientation = left
			SetAutoSize = false, false
			DrawWalls = true, true, true, true, false, false
			TextureOverride ADWindows, ADWindows, ADWindows_Side, ADWindows_Side, ADWindows_Side, ADWindows_Side
			AddWall E1Ent_Windows1, ADWindows, 0.15, 59.65, -15 - 10, 59.65, -15 - 5, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true
			TextureOverride ADWindows, ADWindows, ADWindows_Side, ADWindows_Side, ADWindows_Side, ADWindows_Side
			AddWall E1Ent_Windows2, ADWindows, 0.15, 59.65, -15 + 5, 59.65, -15 + 10, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true

			TextureOverride ADWindows, ADWindows, ADWindows_Side, ADWindows_Side, ADWindows_Side, ADWindows_Side
			AddWall E2Ent_Windows1, ADWindows, 0.15, 59.65, 15 - 10, 59.65, 15 - 5, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true
			TextureOverride ADWindows, ADWindows, ADWindows_Side, ADWindows_Side, ADWindows_Side, ADWindows_Side
			AddWall E2Ent_Windows2, ADWindows, 0.15, 59.65, 15 + 5, 59.65, 15 + 10, 9, 9, %interfloorheight%, %interfloorheight%, 0, 0, true
			SetAutoSize = true, true

			#Sensors
			FloorOrientation = top
			DrawWalls = true, true, true, true, false, false		
