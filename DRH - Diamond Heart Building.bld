#Service elevator lobby
<Floors 0 to 6>
	TexPrefix() #Set texture prefix/suffix

	#Floor/ceiling cuts
	CutAll -20, %interfloorheight% - 0.1, 50 - 0.66, 20, %interfloorheight% + 1, 70, false, true
	CutAll -20, %fullheight% - 0.1, 50, 20, %fullheight% + 1, 70, false, true

	#Floors
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor SAFloor, SAFloor, 0.5, -20, 50 - 0.66, 20, 70, 0, 0, 0, 0, false

	#Ceilings
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	AddFloor SACeiling, SACeiling, 0.5, -20, 50, 20, 70, %height%, %height%, 0, 0, false

	#Walls
	#Set heights
	Set WH = %height%
	Set WO = 0
	if[%floor% = 1] Set WH = %fullheight%
	if[%floor% = 1] Set WO = -%interfloorheight%
	
	#Set sides to be displayed
	Set ShowOutside = false

	Set ShowOutside2 = true
	if[%floor% ! 1] Set ShowOutside2 = false

	Set ShowOutside3 = true
	if[%floor% > 1 & %floor% < 7] Set ShowOutside3 = false

		WallOrientation = left
		DrawWalls = %ShowOutside2%, true, false, false, false, false
		TextureOverride %5%Wall, SAWall, Blank, Blank, Blank, Blank
		AddWall SALeft, SAWall, 0.5, -20, 50, -20, 60, %WH%, %WH%, %WO%, %WO%, 0, 0, false

			#Exterior walls on the 1st-3rd floors
			DrawWalls = true, false, false, false, false, false
			if[%floor% ! 1] AddWall_CustomTex(SALeft_EX, 2, %5%Wall2, %5%Wall, Blank, 0.5, -20, 50, -20, 60, 4, %height% - 4, 0, 0, false)

		WallOrientation = right
		DrawWalls = true, %ShowOutside3%, false, false, false, false
		TextureOverride SAWall, %5B%Wall, Blank, Blank, Blank, Blank
		AddWall SARight, SAWall, 0.5, 20, 50, 20, 70, %WH%, %WH%, %WO%, %WO%, 0, 0, false

		DrawWalls = true, %ShowOutside2%, false, false, false, false
		TextureOverride SAWall, %5%Wall, Blank, Blank, Blank, Blank
		AddWall SABack, SAWall, 0.5, 5, 70, 20, 70, %WH%, %WH%, %WO%, %WO%, 0, 0, false

			#Exterior walls on the 1st-3rd floors
			DrawWalls = false, true, false, false, false, false
			if[%floor% > 1 & %floor% < 7] AddWall_CustomTex(SARight_EX, 2, %5%Wall2, %5%Wall, Blank, 0.5, 20, 50, 20, 70, 4, %height% - 4, 0, 0, false)
			if[%floor% ! 1] AddWall_CustomTex(SABack_EX, 2, %5%Wall2, %5%Wall, Blank, 0.5, 5, 70, 20, 70, 4, %height% - 4, 0, 0, false)

	#Doors
	Set DTex = ServiceDoor2
	if[%floor% < 4] Set DTex = ServiceDoor3
	Set DSTex = %DTex%Side

		#All other floors
		Set Door_MainX = -19.5 #West
		Set Door_MainZ = 55
	
		WallOrientation = right
		if[%floor% ! 0 & %floor% ! 1] AddStdDoor Floor %floor%, SEL_%floorid%_D1, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, 0, 0, 0, 0, 0
		if[%floor% ! 0 & %floor% ! 1] AddStdDoor Floor %floor%, SEL_%floorid%_D2, , , false, %DTex%, %DSTex%, 0.2, left, right, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, 0, 0, 0, 0, 0
		if[%floor% ! 0 & %floor% ! 1] AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, 0, false, 0, 0, false

		Set Door_MainX = 19.5 #East
		Set Door_MainZ = 55
	
		WallOrientation = left
		if[%floor% ! 0] AddStdDoor Floor %floor%, SEL_%floorid%_D1, , , false, %DTex%, %DSTex%, 0.2, right, left, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, 0, 0, 0, 0, 0
		if[%floor% ! 0] AddStdDoor Floor %floor%, SEL_%floorid%_D2, , , false, %DTex%, %DSTex%, 0.2, left, left, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, 0, 0, 0, 0, 0
		if[%floor% ! 0] AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, 0, false, 0, 0, false
		
		#--------------------#
		
		#1st floor only
		Set Door_MainX = -20 #West
		Set Door_MainZ = 55
	
		WallOrientation = left
		if[%floor% = 0] AddStdDoor Floor %floor%, SEL_%floorid%_D1, , , false, %DTex%, %DSTex%, 0.2, right, left, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, 0, 0, 0, 0, 0
		if[%floor% = 0] AddStdDoor Floor %floor%, SEL_%floorid%_D2, , , false, %DTex%, %DSTex%, 0.2, left, left, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, 0, 0, 0, 0, 0
		if[%floor% = 0] AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, 0, false, 0, 0, false

		Set Door_MainX = 20 #East
		Set Door_MainZ = 55

		WallOrientation = right
		if[%floor% = 0] AddStdDoor Floor %floor%, SEL_%floorid%_D1, , , false, %DTex%, %DSTex%, 0.2, right, right, 75, 75, %Door_MainX%, %Door_MainZ% + 1.5, 3, 7, 0, 0, 0, 0, 0
		if[%floor% = 0] AddStdDoor Floor %floor%, SEL_%floorid%_D2, , , false, %DTex%, %DSTex%, 0.2, left, right, 75, 75, %Door_MainX%, %Door_MainZ% - 1.5, 3, 7, 0, 0, 0, 0, 0
		if[%floor% = 0] AddFillerWalls ConnectionWall, 0.5, %Door_MainX%, %Door_MainZ%, 6, 7, 0, false, 0, 0, false

	#----------------------------------------#

	#Utility room inside core area
	WallOrientation = left
	DrawWalls = true, true, false, false, false, false
	AddWall NEUtilityRM, SAWall, 0.5, 5, 60, 20, 60, %height%, %height%, 0, 0, 0, 0, false
		
		#UTILITY ROOM DOORS
		Set Texture = ServiceDoor1
	
		WallOrientation = right
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddDoor , , false, %Texture%, 0.2, 7, 75, 5 + 2.5, 60.5, 3, 7, 0, 0, 0
		AddFillerWalls ConnectionWall, 0.5, 5 + 2.5, 60.5, 3, 7, 0, true, 0, 0, false
<EndFloors>

#========================================#

#Mechanical penthouse
<Floors 7 to 8>
	TexPrefix() #Set texture prefix/suffix

	#Mechanical mezzanine
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	if[%floor% = 8] AddFloor MMFloor1, %5%Floor2, 0.5, -28, 50, 5, 70, 0, 0, 0, 0, false
	if[%floor% = 8] AddFloor MMFloor2, %5%Floor2, 0.5, -28, -6, 20, 50, 0, 0, 0, 0, false

	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	if[%floor% = 7] AddFloor MMUnderside1, %5%Ceiling, 0.5, -28, 50, 5, 70, %height%, %height%, 0, 0, false
	if[%floor% = 7] AddFloor MMUnderside2, %5%Ceiling, 0.5, -28, -6, 20, 50, %height%, %height%, 0, 0, false

	#Mechanical perimeter walls
	Set WallHeight = %fullheight% + Floor(8).FullHeight
	Set WallOffset = 0

		#Set DrawWalls for all sides
		DrawWalls = true, true, false, false, false, false

		WallOrientation = left
		TextureOverride ExtFacade, %5%Wall, ExtFacade, ExtFacade, ExtFacade, ExtFacade
		if[%floor% = 7] AddWall FrontWall, %5%Wall, 0.5, -%1%, %SE_MechPH%, %1%, %SE_MechPH%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride ExtFacade, %5%Wall, ExtFacade, ExtFacade, ExtFacade, ExtFacade
		if[%floor% = 7] AddWall LeftWall, %5%Wall, 0.5, -%1%, %SE_MechPH%, -%1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		WallOrientation = right
		TextureOverride %5%Wall, ExtFacade, ExtFacade, ExtFacade, ExtFacade, ExtFacade
		if[%floor% = 7] AddWall RightWall, %5%Wall, 0.5, %1%, %SE_MechPH%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		TextureOverride %5%Wall, ExtFacade, ExtFacade, ExtFacade, ExtFacade, ExtFacade
		if[%floor% = 7] AddWall BackWall, %5%Wall, 0.5, -%1%, %2%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
<EndFloors>

<Floor 8>
	#Mechanical mezzanine railings
	Set WallHeight = %interfloorheight% + 3.5
	Set WallOffset = -%interfloorheight%
	
	WallOrientation = left
	DrawWalls = true, true, true, true, true, false
	AddWall MechMezRailLeft, ServiceWall3, 0.5, -28, -6, -28, 70, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	AddWall MechMezRailFront, ServiceWall3, 0.5, -27.5, -6, -20, -6, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

	WallOrientation = right
	AddWall MechMezRailRight1, ServiceWall3, 0.5, 20, 6, 20, 38, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	AddWall MechMezRailRight2, ServiceWall3, 0.5, 5, 50, 5, 60, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	AddWall MechMezRailBack, ServiceWall3, 0.5, -27.5, 70, -20, 70, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
<EndFloor>

#7th floor main roof
<Floor 7>
	#Roof floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor Roof, RoofFloor, 0.5, -%1%, -%2%, %1%, %SE_MechPH%, %interfloorheight%, %interfloorheight%, 0, 0, true

	#Roof railings
	Set WallHeight = %interfloorheight% + 5.5
	Set WallOffset = 0

	WallOrientation = Left
	DrawWalls = true, true, true, true, true, false
	AddWall FrontRail, ExtFacade, 0.5, -%1% + 0.5, -%2%, %1% - 0.5, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	AddWall LeftRail, ExtFacade, 0.5, -%1%, -%2%, -%1%, %SE_MechPH%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

	WallOrientation = Right
	AddWall RightRail, ExtFacade, 0.5, %1%, -%2%, %1%, %SE_MechPH%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

	#========================================#

	#Roof access doors
	Set Texture = ServiceDoor1

		WallOrientation = left #West doors
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%, 0.2, 8, 75, -25 - 1.5, %SE_MechPH%, 3, 7, %interfloorheight%, 0, 0
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%, 0.2, 5, 75, -25 + 1.5, %SE_MechPH%, 3, 7, %interfloorheight%, 0, 0
		AddFillerWalls ConnectionWall, 0.5, -25, %SE_MechPH%, 6, 7, %interfloorheight%, true, 0, 0, true

		WallOrientation = left #East doors
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%, 0.2, 8, 75, 25 - 1.5, %SE_MechPH%, 3, 7, %interfloorheight%, 0, 0
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%, 0.2, 5, 75, 25 + 1.5, %SE_MechPH%, 3, 7, %interfloorheight%, 0, 0
		AddFillerWalls ConnectionWall, 0.5, 25, %SE_MechPH%, 6, 7, %interfloorheight%, true, 0, 0, true

	#Mechanical vents
	Set MainHeight = %height% + Floor(8).FullHeight
	Set winheight = %MainHeight% - 2 #Named "win (Short for windows)" for compatibility reasons
	Set winoffset = 1

		#Front
		Add3DWindows(FrontVents1, 0, %SE_MechPH%, front, 30, %winheight%, %winoffset%, VentsExt, VentsInt, %5%Wall, 0.5, 1, 1)

		#Left
		Add3DWindows(LeftVents1, -%1%, 15, left, 20, %winheight%, %winoffset%, VentsExt, VentsInt, %5%Wall, 0.5, 1, 1)
		Add3DWindows(LeftVents2, -%1%, 45, left, 20, %winheight%, %winoffset%, VentsExt, VentsInt, %5%Wall, 0.5, 1, 1)
		Add3DWindows(LeftVents3, -%1%, 75, left, 20, %winheight%, %winoffset%, VentsExt, VentsInt, %5%Wall, 0.5, 1, 1)

		#Right
		Add3DWindows(RightVents1, %1%, 15, right, 20, %winheight%, %winoffset%, VentsInt, VentsExt, %5%Wall, 0.5, 1, 1)
		Add3DWindows(RightVents2, %1%, 45, right, 20, %winheight%, %winoffset%, VentsInt, VentsExt, %5%Wall, 0.5, 1, 1)
		Add3DWindows(RightVents3, %1%, 75, right, 20, %winheight%, %winoffset%, VentsInt, VentsExt, %5%Wall, 0.5, 1, 1)

		#Back
		Add3DWindows(BackVents1, 0, %2%, back, 30, %winheight%, %winoffset%, VentsInt, VentsExt, %5%Wall, 0.5, 1, 1)
<EndFloor>

#========================================#

#Support columns
<Floors 0 to 8>
	#Set Values
	TexPrefix() #Set wall texture
	Set DistanceX = 40 #Distance between supports X
	Set DistanceZ = 30 #Distance between supports Z
	Set SupportHeight = %fullheight%
	Set SupportOffset = -%interfloorheight%

	#Corner Supports
	CreateWallBox2 External, SupportNW, %5%%SupportSuffix%, -%1% + 1.25, %2% - 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportNE, %5B%%SupportSuffix%, %1% - 1.25, %2% - 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% < 7] CreateWallBox2 External, SupportSW, %5%%SupportSuffix%, -%1% + 1.25, -%2% + 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% < 7] CreateWallBox2 External, SupportSE, %5B%%SupportSuffix%, %1% - 1.25, -%2% + 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% > 6] CreateWallBox2 External, SupportSW_Top, %5%%SupportSuffix%, -%1% + 1.25, -30, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% > 6] CreateWallBox2 External, SupportSE_Top, %5%%SupportSuffix%, %1% - 1.25, -30, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false

	#North Supports
	CreateWallBox2 External, SupportN1, %5%%SupportSuffix%, -%1% + (%DistanceX% * 1), %2% - 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportN2, %5%%SupportSuffix%, -%1% + (%DistanceX% * 2), %2% - 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false

	#South Supports
	if[%floor% < 7] CreateWallBox2 External, SupportS1, %5%%SupportSuffix%, -%1% + (%DistanceX% * 1), -%2% + 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% < 7] CreateWallBox2 External, SupportS2, %5%%SupportSuffix%, -%1% + (%DistanceX% * 2), -%2% + 1.25, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% > 6] CreateWallBox2 External, SupportS1_Top, %5%%SupportSuffix%, -%1% + (%DistanceX% * 1), -30, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% > 6] CreateWallBox2 External, SupportS2_Top, %5%%SupportSuffix%, -%1% + (%DistanceX% * 2), -30, 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false

	#West Supports
	if[%floor% < 7] CreateWallBox2 External, SupportW1, %5%%SupportSuffix%, -%1% + 1.25, -%2% + (%DistanceZ% * 1), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% < 7] CreateWallBox2 External, SupportW2, %5%%SupportSuffix%, -%1% + 1.25, -%2% + (%DistanceZ% * 2), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportW3, %5%%SupportSuffix%, -%1% + 1.25, -%2% + (%DistanceZ% * 3), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportW4, %5%%SupportSuffix%, -%1% + 1.25, -%2% + (%DistanceZ% * 4), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportW5, %5%%SupportSuffix%, -%1% + 1.25, -%2% + (%DistanceZ% * 5), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportW6, %5%%SupportSuffix%, -%1% + 1.25, -%2% + (%DistanceZ% * 6), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportW7, %5%%SupportSuffix%, -%1% + 1.25, -%2% + (%DistanceZ% * 7), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false

	#East Supports
	if[%floor% < 7] CreateWallBox2 External, SupportE1, %5B%%SupportSuffix%, %1% - 1.25, -%2% + (%DistanceZ% * 1), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	if[%floor% < 7] CreateWallBox2 External, SupportE2, %5B%%SupportSuffix%, %1% - 1.25, -%2% + (%DistanceZ% * 2), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportE3, %5B%%SupportSuffix%, %1% - 1.25, -%2% + (%DistanceZ% * 3), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportE4, %5B%%SupportSuffix%, %1% - 1.25, -%2% + (%DistanceZ% * 4), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportE5, %5B%%SupportSuffix%, %1% - 1.25, -%2% + (%DistanceZ% * 5), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportE6, %5B%%SupportSuffix%, %1% - 1.25, -%2% + (%DistanceZ% * 6), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
	CreateWallBox2 External, SupportE7, %5B%%SupportSuffix%, %1% - 1.25, -%2% + (%DistanceZ% * 7), 2, 2, %SupportHeight%, %SupportOffset%, 0, 0, false, true, false, false
<EndFloors>

#========================================#

#8th floor rooftop
<Floor 9>
	#Roof floor
	FloorOrientation = top
	DrawWalls = false, true, false, false, false, false
	AddFloor Roof, RoofFloor, 0.5, -%1%, %SE_MechPH%, %1%, %2%, %interfloorheight%, %interfloorheight%, 0, 0, true
	
	#========================================#

	#Elevator machine room enclosures
		#Floor
		CutAll -20, %interfloorheight% - 0.5, 38, 20, %interfloorheight% + 0.5, 70, false, true #Floor cuts

		FloorOrientation = top
		DrawWalls = false, true, false, false, false, false
		AddFloor EMRFloor, ElevMRIntFloor, 0.5, -20, 38, 20, 70, %interfloorheight%, %interfloorheight%, 0, 0, true

		#Ceiling
		FloorOrientation = bottom
		DrawWalls = true, true, true, true, true, true
		TextureOverride ElevMRIntCeiling, ExtFacade, ExtFacade, ExtFacade, ExtFacade, ExtFacade
		AddFloor EMRCeiling, ElevMRIntCeiling, 1, -20, 38, 20, 70, %fullheight%, %fullheight%, 0, 0, true

		#Walls
		WallOrientation = left
		DrawWalls = true, true, false, false, false, false
		TextureOverride ExtFacade, ElevMRIntWall, Blank, Blank, Blank, Blank
		AddWall EMRWallFront, ExtFacade, 0.5, -20, 38, 0, 38, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true
		TextureOverride ExtFacade, ElevMRIntWall, Blank, Blank, Blank, Blank
		AddWall EMRWallLeft, ExtFacade, 0.5, -20, 38, -20, 60, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true

		WallOrientation = right
		TextureOverride ElevMRIntWall, ExtFacade, Blank, Blank, Blank, Blank
		AddWall EMRWallRight, ExtFacade, 0.5, 20, 50, 20, 70, %fullheight%, %fullheight%, 0, 0, 0, 0, true
		TextureOverride ElevMRIntWall, ExtFacade, Blank, Blank, Blank, Blank
		AddWall EMRWallBack, ExtFacade, 0.5, 5, 70, 20, 70, %fullheight%, %fullheight%, 0, 0, 0, 0, true
		
		#Utility rooms inside this area
		WallOrientation = left
		DrawWalls = true, true, false, false, false, false
		AddWall NEUtilityRM, ElevMRIntWall, 0.5, 5, 60, 20, 60, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true

		WallOrientation = right
		AddWall SWUtilityRM, ElevMRIntWall, 0.5, -20, 50, 0, 50, %height%, %height%, %interfloorheight%, %interfloorheight%, 0, 0, true
		
			#UTILITY ROOM DOORS
			Set Texture = Door1
		
			#Northeast room
			WallOrientation = right
			TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
			AddExternalDoor , , false, %Texture%, 0.2, 7, 75, 5 + 2.5, 60.5, 3, 7, %interfloorheight%, 0, 0
			AddFillerWalls ConnectionWall, 0.5, 5 + 2.5, 60.5, 3, 7, %interfloorheight%, true, 0, 0, true

			#Southwest room
			WallOrientation = left
			TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
			AddExternalDoor , , false, %Texture%, 0.2, 5, 75, 0 - 2.5, 49.5, 3, 7, %interfloorheight%, 0, 0
			AddFillerWalls ConnectionWall, 0.5, 0 - 2.5, 49.5, 3, 7, %interfloorheight%, true, 0, 0, true

		#Roof access doors
		Set Texture = ServiceDoor1
	
		WallOrientation = left
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%, 0.2, 1, 75, -20, 55 - 1.5, 3, 7, %interfloorheight%, 0, 0
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%, 0.2, 4, 75, -20, 55 + 1.5, 3, 7, %interfloorheight%, 0, 0
		AddFillerWalls ConnectionWall, 0.5, -20, 55, 6, 7, %interfloorheight%, false, 0, 0, true

		WallOrientation = right
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%, 0.2, 2, 75, 20, 55 - 1.5, 3, 7, %interfloorheight%, 0, 0
		TextureOverride %Texture%, %Texture%, %Texture%Side, %Texture%Side, %Texture%Side, %Texture%Side
		AddExternalDoor , , false, %Texture%, 0.2, 3, 75, 20, 55 + 1.5, 3, 7, %interfloorheight%, 0, 0
		AddFillerWalls ConnectionWall, 0.5, 20, 55, 6, 7, %interfloorheight%, false, 0, 0, true
	
	#========================================#

	#Roof railings
	Set WallHeight = %interfloorheight% + 5.5
	Set WallOffset = 0

	WallOrientation = Left
	DrawWalls = true, true, true, true, true, false
	AddWall FrontRail, ExtFacade, 0.5, -%1% + 0.5, %SE_MechPH%, %1% - 0.5, %SE_MechPH%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	AddWall LeftRail, ExtFacade, 0.5, -%1%, %SE_MechPH%, -%1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

	WallOrientation = Right
	AddWall RightRail, ExtFacade, 0.5, %1%, %SE_MechPH%, %1%, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
	AddWall BackRail, ExtFacade, 0.5, -%1% + 0.5, %2%, %1% - 0.5, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
<EndFloor>

##--------------------------------------------------------------------------------##

#EXTERNAL SHAFT AND STAIRWELL WALLS
#Sets for all walls
<Function ExtSHSets>
	#Set textures
	TexPrefix()

	#Set heights
	Set WH = %height%
	Set WO = 0
	if[%floor% = 1 | %floor% = 8] Set WH = %fullheight%
	if[%floor% = 1 | %floor% = 8] Set WO = -%interfloorheight%
<EndFunction>

<Floors 0 to 8>
	ExtSHSets()
	
	Set ShowOutside = true
	if[%floor% > -1 & %floor% < 7] Set ShowOutside = false
	Set ShowOutside2 = true
	if[(%floor% > -1 & %floor% < 7) & %floor% ! 1] Set ShowOutside2 = false

	#Main Core Elevators
	CreateShaftWall(%5%%ELSuffix%, %5%Wall, %5%Wall, %5A%Wall, %5%Wall, %5%Wall, 0.33, -10, 44, 10, 6, Shaft1, %WH%, %WO%, true, %ShowOutside2%, false, true, false, false, false)
	CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, %5%%ELSuffix%, %5%Wall, %5%Wall, 0.33, 0, 0, 20, 6, Shaft3, %WH%, %WO%, %ShowOutside2%, %ShowOutside2%, %ShowOutside%, true, false, false, false)
	CreateShaftWall(%5%%ELSuffix%, %5%Wall, %5%Wall, %5A%Wall, %5%Wall, %5%Wall, 0.33, 10, 44, 10, 6, Shaft4, %WH%, %WO%, true, false, %ShowOutside%, true, false, false, false)

	#========================================#

	#North Stairwell
	CreateShaftWall(%5A%Wall, %5%Wall, %5A%Wall, %5%Wall, %5%Wall, %5%Wall, 0.5, -7.5, 65, 12.5, 5, NorthST, %WH%, %WO%, true, %ShowOutside2%, true, %ShowOutside2%, false, false, false)

	#South Stairwell
	if[%floor% < 7] CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, 0.5, -7.5, -65, 12.5, 5, SouthST, %WH%, %WO%, %ShowOutside%, %ShowOutside2%, %ShowOutside%, %ShowOutside%, false, false, false)
<EndFloors>

<Floors 0 to 6>
	ExtSHSets()

	#Main Core Elevators
		#Patient Transport Elevators
		if[%floor% ! 1] CreateShaftWall(%5%Wall, %5%Wall2, %5%Wall, %5%Wall, %5%Wall, %5%Wall, 0.33, -10, 44, 10, 6, Shaft1A, 4, 0, false, true, false, false, false, false, false)
		if[%floor% ! 1] CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, 0.33, -10, 44, 10, 6, Shaft1B, %height% - 4, 4, false, true, false, false, false, false, false)
	
		#High Zone Elevators
		Set ShowLobbySide = true
		if[%floor% = 1] Set ShowLobbySide = false
	
		Set ShowPlazaSide = true
		if[%floor% < 2] Set ShowPlazaSide = false

		if[%floor% < 2] CreateShaftWall(%5%Wall2, %5%Wall2, PlazaWall, %5%Wall, %5%Wall, %5%Wall, 0.33, 0, 0, 20, 6, Shaft3_Plaza, %height%, 0, false, false, true, false, false, false, false)
		CreateShaftWall(%5%Wall2, %5%Wall2, %5%Wall2, %5%Wall, %5%Wall, %5%Wall, 0.33, 0, 0, 20, 6, Shaft3A, 4, 0, %ShowLobbySide%, %ShowLobbySide%, %ShowPlazaSide%, false, false, false, false)
		CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, 0.33, 0, 0, 20, 6, Shaft3B, %height% - 4, 4, %ShowLobbySide%, %ShowLobbySide%, %ShowPlazaSide%, false, false, false, false)

		#Service Elevators
		if[%floor% < 2] CreateShaftWall(%5%Wall, %5%Wall, PlazaWall, %5%Wall, %5%Wall, %5%Wall, 0.33, 10, 44, 10, 6, Shaft4_Plaza, %height%, 0, false, false, true, false, false, false, false)
		if[%floor% > 1] CreateShaftWall(%5%Wall, %5%Wall, %5%Wall2, %5%Wall, %5%Wall, %5%Wall, 0.33, 10, 44, 10, 6, Shaft4A, 4, 0, false, false, true, false, false, false, false)
		if[%floor% > 1] CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, 0.33, 10, 44, 10, 6, Shaft4B, %height% - 4, 4, false, false, true, false, false, false, false)

	#========================================#

	#North Stairwell
	if[%floor% ! 1] CreateShaftWall(%5%Wall, %5%Wall2, %5%Wall, %5%Wall2, %5%Wall, %5%Wall, 0.5, -7.5, 65, 12.5, 5, ST1L, 4, 0, false, true, false, true, false, false, false)
	if[%floor% ! 1] CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, 0.5, -7.5, 65, 12.5, 5, ST1U, %height% - 4, 4, false, true, false, true, false, false, false)

	#South Stairwell
	Set ShowLeft = true
	if[%floor% = 1] Set ShowLeft = false
	Set ShowPlazaSide = true
	if[%floor% = 1] Set ShowPlazaSide = false

	CreateShaftWall(%5%Wall2, %5%Wall2, %5%Wall2, %5%Wall2, %5%Wall, %5%Wall, 0.5, -7.5, -65, 12.5, 5, ST2L, 4, 0, false, %ShowLeft%, false, %ShowPlazaSide%, false, false, false)
	CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, 0.5, -7.5, -65, 12.5, 5, ST2U, %height% - 4, 4, false, %ShowLeft%, false, %ShowPlazaSide%, false, false, false)

	if[%floor% = 1] CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, PlazaWall, %5%Wall, %5%Wall, 0.5, -7.5, -65, 12.5, 5, ST2_Plaza, %height%, 0, false, false, false, true, false, false, false)
	if[%floor% = 1] CreateShaftWall(%5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall, 0.5, -7.5, -65, 12.5, 5, ST2-EX, %WH%, %WO%, false, true, false, false, false, false, false)
<EndFloors>

<Function ExtSHSets_RF> #Roof only
	#Set heights
	Set WH = %fullheight%
	Set WO = 0
<EndFunction>

<Floor 9>
	ExtSHSets_RF()

	#Service Elevators
	CreateShaftWall(ExtFacade, ElevMRIntWall, ExtFacade, ElevMRIntWall, ExtFacade, ExtFacade, 0.33, 10, 44, 10, 6, Shaft4-RF, %WH%, %WO%, true, true, true, true, false, false, true)

	#North Stairwell
	CreateShaftWall(ElevMRIntWall, ExtFacade, ElevMRIntWall, ExtFacade, ExtFacade, ExtFacade, 0.5, -7.5, 65, 12.5, 5, NorthST-RF, %WH%, %WO%, true, true, true, true, false, false, true)
<EndFloor>

##--------------------------------------------------------------------------------##

<Break>
#ESCALATORS
#Set escalator properties
	OP_EscBalustrades(GlassBalustrade, 0, 3.25, 0, 0)
	OP_EscLanding(EscalatorLandingZ, 5, 0, 0, EscalatorLandingZ, 5, 0, 0)
