		WallOrientation = left
		TextureOverride %5%Wall, %5%LobbyWall, Blank, Blank, Blank, Blank
		AddWall MezDivWall_Elev1-2_Left, %5%Wall, 0.5, -20, 27.5, -20, 38, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		AddWall MezDivWall_Elev1-2_Front, %5%LobbyWall, 0.5, -20, 27.5, 20, 27.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	
		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		AddWall MezDivWall_Elev3-6, %5%LobbyWall, 0.5, 20, 6, 20, 28, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		DrawWalls = false, true, false, false, false, false
		AddWall MezDivWall_Elev3-6, PlazaWall, 0.5, 20, 6, 20, 28, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

		#North zone
		DrawWalls = false, true, false, false, false, false
		#AddWall_CustomTex(MezDivWall_North_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, 20, 70, 20, %2%, 4, %height% - 4, 0, 0, false)
		AddWall MezDivWall_North, PlazaWall, 0.5, 20, 70, 20, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		DrawWalls = true, false, false, false, false, false
		AddWall MezDivWall_North, %5%Wall, 0.5, 20, 70, 20, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

		#South zone
		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		#AddWall_CustomTex(MezDivWall_S1_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, -20, -%2%, -20, -90, 4, %height% - 4, 0, 0, false)
		AddWall MezDivWall_S1, PlazaWall, 0.5, -20, -%2%, -20, -90, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		DrawWalls = true, false, false, false, false, false
		AddWall MezDivWall_S1, %5%Wall, 0.5, -20, -%2%, -20, -70, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

		WallOrientation = left
		DrawWalls = false, true, false, false, false, false
		#AddWall_CustomTex(MezDivWall_S2_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, -20, -60, -20, -50, 4, %height% - 4, 0, 0, false)
		AddWall MezDivWall_S2, PlazaWall, 0.5, -20, -60, -20, -50, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		DrawWalls = true, false, false, false, false, false
		AddWall MezDivWall_S2, %5%Wall, 0.5, -20, -60, -20, -50, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

		WallOrientation = right
		DrawWalls = true, false, false, false, false, false
		#AddWall_CustomTex(MezDivWall_S3_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, -20, -50, 20, -50, 4, %height% - 4, 0, 0, false)
		AddWall MezDivWall_S3, PlazaWall, 0.5,  -20, -50, 20, -50, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		DrawWalls = false, true, false, false, false, false
		AddWall MezDivWall_S3, %5%Wall, 0.5,  -20, -50, 20, -50, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

		WallOrientation = right
		DrawWalls = false, true, false, false, false, false
		#AddWall_CustomTex(MezDivWall_S4_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, 20, -50 - 0.5, 20, -6, 4, %height% - 4, 0, 0, false)
		AddWall MezDivWall_S4, PlazaWall, 0.5, 20, -50 - 0.5, 20, -6, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
		DrawWalls = true, false, false, false, false, false
		AddWall MezDivWall_S4, %5%Wall, 0.5, 20, -50 - 0.5, 20, -6, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

	#Mezzanine windows
	Add3DWindows(MezWindows_N1, 20 - 0.5, 112.5 - 6 + 4.5, left, 9, 6, 3.5, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 3/4, 1)
	Add3DWindows(MezWindows_N2, 20 - 0.5, 97.5, left, 12, 6, 3.5, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 4/4, 1)
	Add3DWindows(MezWindows_N3, 20 - 0.5, 82.5, left, 12, 6, 3.5, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 4/4, 1)

	Add3DWindows(MezWindows_EL1, -20, 33, left, 8, %height% - 2, 1, MezWindowsIntB, MezWindowsIntB, %5%LobbyWall, 0.5, 2/4, 2)
	#Add3DWindows(MezWindows_EL2, 20 - 0.5, 11, left, 8, %height% - 2, 1, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 2/4, 2)
	Add3DWindows(MezWindows_EL2, 20 - 0.5, 17, left, 8 * 2, %height% - 2, 1, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 4/4, 2)

	Add3DWindows(MezWindows_S1, 20 - 0.5, -22.5, left, 12, 6, 3.5, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 4/4, 1)
	Add3DWindows(MezWindows_S2, 20 - 0.5, -37.5, left, 12, 6, 3.5, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 4/4, 1)

	Add3DWindows(MezWindows_S3, -7.5, -50, back, 12, 6, 3.5, MezWindowsIntB, MezWindowsB, %5B%Wall, 0.5, 4/4, 1)
	Add3DWindows(MezWindows_S4, 7.5, -50, back, 12, 6, 3.5, MezWindowsIntB, MezWindowsB, %5B%Wall, 0.5, 4/4, 1)
	Add3DWindows(MezWindows_S5, -20, -55, left, 8, 6, 3.5, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 2/4, 1)

	Add3DWindows(MezWindows_S6, -20, -97.5, left, 12, 6, 3.5, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 4/4, 1)
	Add3DWindows(MezWindows_S7, -20, -112.5 + 6 - 4.5, left, 9, 6, 3.5, MezWindowsB, MezWindowsIntB, %5B%Wall, 0.5, 3/4, 1)
<EndFloor>

#========================================#

#Windows on above ground levels
<Floors 0 to 6>
	TexPrefix() #Set texture prefix/suffix

	#Windows creation
	Set MyIFloorType = 2
	if[%floor% = 0] Set MyIFloorType = 3

	Set WinPrefix = Main #Windows' prefixes
	if[%floor% = 0] Set WinPrefix = Lobby
	Set WinPrefix2 = Main

	Set WinHeight = %height%

	if[%floor% = 0] Set LobbyWH = %height% + Floor(1).FullHeight
	if[%floor% ! 0] Set LobbyWH = %WinHeight%

	SetAutoSize = true, false
	
		#Front windows
		if[%floor% ! 1] AddCustomWindows(FrontWin1, %WinPrefix2%Windows, %WinPrefix2%WindowsInt, -%1%, -%2%, -25, -%2%, %LobbyWH%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		AddCustomWindows(FrontWin2, %WinPrefix2%Windows, %WinPrefix2%WindowsInt, -15, -%2%, 15, -%2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		AddCustomWindows(FrontWin3, %WinPrefix2%Windows, %WinPrefix2%WindowsInt, 25, -%2%, %1%, -%2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)

		#Left windows
		if[%floor% ! 1 & %floor% ! 0] AddCustomWindows(LeftWin, %WinPrefix2%Windows, %WinPrefix2%WindowsInt, -%1%, -%2%, -%1%, %2%, %LobbyWH%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		if[%floor% = 0] AddCustomWindows(LeftWin1, %WinPrefix2%Windows, %WinPrefix2%WindowsInt, -%1%, -%2%, -%1%, 30, %LobbyWH%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		if[%floor% = 0] AddCustomWindows(LeftWin2, %WinPrefix2%Windows, %WinPrefix2%WindowsInt, -%1%, 90, -%1%, %2%, %LobbyWH%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)

		#Right windows
		if[%floor% ! 0 & %floor% ! 1] AddCustomWindows(RightWin, %WinPrefix2%WindowsInt, %WinPrefix2%Windows, %1%, -%2%, %1%, %2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		if[%floor% = 0 | %floor% = 1] AddCustomWindows(RightWin1, %WinPrefix2%WindowsInt, %WinPrefix2%Windows, %1%, -%2%, %1%, -30, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		if[%floor% = 0 | %floor% = 1] AddCustomWindows(RightWin2, %WinPrefix2%WindowsInt, %WinPrefix2%Windows, %1%, 30, %1%, %2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)

		#Back windows
		if[%floor% ! 1] AddCustomWindows(BackWin1, %WinPrefix2%WindowsInt, %WinPrefix2%Windows, -%1%, %2%, -25, %2%, %LobbyWH%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		if[%floor% ! 1] AddCustomWindows(BackWin2, %WinPrefix2%WindowsInt, %WinPrefix2%Windows, -15, %2%, 15, %2%, %LobbyWH%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)
		AddCustomWindows(BackWin3, %WinPrefix2%WindowsInt, %WinPrefix2%Windows, 25, %2%, %1%, %2%, %WinHeight%, 0, 0, %MyIFloorType%, ExtFacade, %5%Wall)

	SetAutoSize = true, true
<EndFloors>

#Perimeter walls
<Floors 0 to 6>
	TexPrefix() #Set texture prefix/suffix
	Set WallHeight = %fullheight%
	Set WallOffset = 0

	Set WallHeight2 = %WallHeight%
	Set WallOffset2 = %WallOffset%
	if[%floor% = 0] Set WallHeight2 = %fullheight% + Floor(1).FullHeight
	if[%floor% = 0] Set WallOffset2 = 0

	Set WallHeight3 = %WallHeight%
	if[%floor% ! 1] Set WallHeight3 = %height%

	Set ShowInside1 = true
	if[%floor% < 7 & %floor% ! 1] Set ShowInside1 = false

	Set ShowInside2 = true
	if[%floor% < 7] Set ShowInside2 = false

		#Front walls
		WallOrientation = left
		DrawWalls = true, %ShowInside1%, %ShowInside1%, %ShowInside1%, false, false
		TextureOverride ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		AddWall FrontWall_A1, ExtFacade, 0.5, -25, -%2%, -20, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = true, %ShowInside2%, %ShowInside2%, %ShowInside2%, false, false
		TextureOverride ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		AddWall FrontWall_A2, ExtFacade, 0.5, -20, -%2%, -15, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		TextureOverride ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		AddWall FrontWall_B, ExtFacade, 0.5, 15, -%2%, 25, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = false, true, true, true, false, false
		if[%floor% = 0] AddWall_CustomTex(FrontWallA1_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, -25, -%2%, -15, -%2%, 4 + %interfloorheight%, %WallHeight3% - 4, 0, %WallOffset%, true)

			#Special values for office areas on the 2nd-6th floors
			DrawWalls = false, true, true, false, false, false
			if[%floor% > 1] AddWall_CustomTex(FrontWallA1_Int1, 2, %5%Wall2, %5%Wall, Blank, 0.5, -25, -%2%, -20, -%2%, 4 + %interfloorheight%, %WallHeight3% - 4, 0, %WallOffset%, true)
			DrawWalls = false, true, false, true, false, false
			if[%floor% > 1] AddWall_CustomTex(FrontWallA1_Int2, 2, %5%%Infix%Wall2, %5%%Infix%Wall, Blank, 0.5, -20, -%2%, -15, -%2%, 4 + %interfloorheight%, %WallHeight3% - 4, 0, %WallOffset%, true)

		DrawWalls = false, true, true, true, false, false
		if[%floor% = 1] AddWall FrontWallA1_Int, PlazaWall, 0.5, -20, -%2%, -15, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		if[%floor% > 1] AddWall_CustomTex(FrontWallB_Int, 2, %5%%Infix%Wall2, %5%%Infix%Wall, Blank, 0.5, 15, -%2%, 25, -%2%, 4 + %interfloorheight%, %height% - 4, 0, %WallOffset%, true)

		if[%floor% = 0] AddWall_CustomTex(FrontWallB_Int1, 2, %5%%Infix%Wall2, %5%%Infix%Wall, Blank, 0.5, 15, -%2%, 20, -%2%, 4 + %interfloorheight%, %height% - 4, 0, %WallOffset%, true)
		if[%floor% = 0] AddWall FrontWallB_Int2, PlazaWall, 0.5, 20, -%2%, 25, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
		if[%floor% = 1] AddWall FrontWallB_Int2, PlazaWall, 0.5, 15, -%2%, 25, -%2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		#Left walls
		WallOrientation = left
		DrawWalls = true, false, false, false, false, false
		TextureOverride ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		if[%floor% = 0] AddWall LeftWall, ExtFacade, 0.5, -%1%, 30, -%1%, 90, %WallHeight2%, %WallHeight2%, %WallOffset2%, %WallOffset2%, 0, 0, true

		DrawWalls = false, true, true, true, false, false
		if[%floor% = 0] AddWall_CustomTex(LeftWallInt, 2, %5%Wall2, %5%Wall, Blank, 0.5, -%1%, 30, -%1%, 90, 4 + %interfloorheight%, %WallHeight2% - 4, 0, %WallOffset2%, true)

		#Right walls
		WallOrientation = right
		DrawWalls = true, true, true, true, false, false
		TextureOverride %5B%Wall, ExtFacade, %5B%Wall, %5B%Wall, %5B%Wall, %5B%Wall
		if[%floor% = 0] AddWall RightWall, ExtFacade, 0.5, %1%, -30, %1%, 30, %WallHeight2%, %WallHeight2%, %WallOffset2%, %WallOffset2%, 0, 0, true

	Set ShowInside3 = true
	if[%floor% = 0 | %floor% > 1] Set ShowInside3 = false

	Set ShowInside4 = true
	if[%floor% > -1 & %floor% < 7] Set ShowInside4 = false

		#Back walls
		WallOrientation = right

		DrawWalls = %ShowInside3%, true, %ShowInside3%, %ShowInside3%, false, false
		TextureOverride %5%Wall, ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		AddWall BackWall_A, ExtFacade, 0.5, -25, %2%, -15, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = %ShowInside3%, true, %ShowInside3%, %ShowInside3%, false, false
		TextureOverride %5%Wall, ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		AddWall BackWall_B1, ExtFacade, 0.5, 15, %2%, 20, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = %ShowInside4%, true, %ShowInside4%, %ShowInside4%, false, false
		TextureOverride %5%Wall, ExtFacade, %5%Wall, %5%Wall, %5%Wall, %5%Wall
		AddWall BackWall_B2, ExtFacade, 0.5, 20, %2%, 25, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true

		DrawWalls = true, false, true, true, false, false
		if[%floor% < 7 & %floor% ! 1] AddWall_CustomTex(BackWallA_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, -25, %2%, -15, %2%, 4 + %interfloorheight%, %WallHeight3% - 4, 0, %WallOffset%, true)
		if[%floor% = 0] AddWall_CustomTex(BackWallB1_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, 15, %2%, 20, %2%, 4 + %interfloorheight%, %WallHeight3% - 4, 0, %WallOffset%, true)
		if[%floor% > 1] AddWall_CustomTex(BackWallB1_Int, 2, %5%Wall2, %5%Wall, Blank, 0.5, 15, %2%, 25, %2%, 4 + %interfloorheight%, %WallHeight3% - 4, 0, %WallOffset%, true)

		if[%floor% = 0 | %floor% = 1] AddWall BackWall_B2_Plaza, PlazaWall, 0.5, 20, %2%, 25, %2%, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, true
<EndFloors>

#West/east entrance windows
<Floor 0>
	TexPrefix() #Set texture prefix/suffix
	Set WallHeight = %height% + Floor(1).FullHeight
	Set WallOffset = %interfloorheight%

		#Windows creation
		Set EWHalfHeight = (%WallHeight% - 2) / 2
		Set EWHalfHeight2 = %WallHeight% / 2
		
		Add3DWindows(WAWindows1, -%1%, 45, left, 20, %EWHalfHeight%, %EWHalfHeight2%, MainWindowsB, MainWindowsIntB, %5%Wall, 0.5, 4/4, 1)
		Add3DWindows(WAWindows2, -%1%, 75, left, 20, %EWHalfHeight%, %EWHalfHeight2%, MainWindowsB, MainWindowsIntB, %5%Wall, 0.5, 4/4, 1)
		
		Add3DWindows(EAWindows1, %1%, -15, right, 20, %EWHalfHeight%, %EWHalfHeight2%, MainWindowsIntB, MainWindowsB, %5B%Wall, 0.5, 4/4, 1)
		Add3DWindows(EAWindows2, %1%, 15, right, 20, %EWHalfHeight%, %EWHalfHeight2%, MainWindowsIntB, MainWindowsB, %5B%Wall, 0.5, 4/4, 1)
<EndFloor>

#========================================#

#Cuts for escalators between 1 and 2
<Floors 1 to 2>
	if[%floor% > 1] CutAll -%1%, %interfloorheight% - 0.1, -10, -34 - 0.5, %interfloorheight% + 0.1, -10 + 20, false, true
	if[%floor% < 2] CutAll -%1%, %fullheight% - 0.1, -10, -34 - 0.5, %fullheight% + 0.1, -10 + 20, false, true
<EndFloors>

#Cuts for escalators between 2 to 6
<Floors 2 to 6>
	if[%floor% > 2] CutAll -%1%, %interfloorheight% - 0.1, -10, -34 - 0.5, %interfloorheight% + 0.1, -10 + 20, false, true
	if[%floor% < 6] CutAll -%1%, %fullheight% - 0.1, -10, -34 - 0.5, %fullheight% + 0.1, -10 + 20, false, true
<EndFloors>

<Floors 2 to 6>
	#Escalator atrium railings
	TexPrefix() #Set texture prefixes
	Set WallHeight = %interfloorheight% + 3.5
	Set WallOffset = -%interfloorheight%
	
		#Extra positioning (6th floor only)
		Set EP = 0
		if[%floor% = 6] Set EP = 4

	WallOrientation = right
	DrawWalls = true, true, false, true, true, false
	if[%floor% = 3 | %floor% = 5] AddWall EscRail_FrontA, %5%Wall2, 0.5, -%1%, -10, -34 - 0.5, -10, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	if[%floor% = 2 | %floor% = 4 | %floor% = 6] AddWall EscRail_FrontB, %5%Wall2, 0.5, -%1%, -10, -54 + %EP%, -10, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

	DrawWalls = true, true, true, true, true, false
	if[%floor% = 2 | %floor% = 4 | %floor% = 6] AddWall EscRail_FrontC, %5%Wall2, 0.5, -38 - %EP%, -10, -34 - 0.5, -10, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

	WallOrientation = left
	AddWall EscRail_Right, %5%Wall2, 0.5, -34 - 0.5, -10.5, -34 - 0.5, -10 + 20 + 0.5, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	DrawWalls = true, true, false, true, true, false
	if[%floor% = 2 | %floor% = 4 | %floor% = 6] AddWall EscRail_BackA, %5%Wall2, 0.5, -%1%, -10 + 20, -34 - 0.5, -10 + 20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false

	DrawWalls = true, true, false, true, true, false
	if[%floor% = 3 | %floor% = 5] AddWall EscRail_BackB, %5%Wall2, 0.5, -%1%, -10 + 20, -54, -10 + 20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
	DrawWalls = true, true, true, true, true, false
	if[%floor% = 3 | %floor% = 5] AddWall EscRail_BackC, %5%Wall2, 0.5, -38, -10 + 20, -34 - 0.5, -10 + 20, %WallHeight%, %WallHeight%, %WallOffset%, %WallOffset%, 0, 0, false
<EndFloors>

#========================================#

#Set door textures for restrooms
<Function RR_DTex>
	Set DTex = Door9b
	#if[%floor% = -1] Set DTex = Door8
	if[%floor% = 1] Set DTex = Door8
	Set DSTex = %DTex%Side #Doors' sides

	Set DTTex = %DTex%Side #Door trims
	if[%floor% ! -1] Set DTTex = Door9bTrim2 #Door trims
<EndFunction>

#Restrooms
<Floors 0 to 6>
	TexPrefix() #Set texture prefix/suffix
	RR_DTex() #Set door textures
	Set RRHeight = 8.5 #Interior wall heights

	#Restroom's floors
		#Floor cuts
		CutAll -20, %interfloorheight% - 0.1, -90 + 0.5, 5, %interfloorheight% + 0.1, -70, false, true
		CutAll 5, %interfloorheight% - 0.1, -90 + 0.5, 20, %interfloorheight% + 0.1, -60, false, true

		#Floor creation
		FloorOrientation = top
		DrawWalls = false, true, false, false, false, false
		AddFloor RRFloor1, RRFloor, 0.5, -20, -90 + 0.5, 5, -70, 0, 0, 0, 0, false
		AddFloor RRFloor2, RRFloor, 0.5, 5, -90 + 0.5, 20, -60, 0, 0, 0, 0, false

	#Restroom's dropped ceiling
	FloorOrientation = bottom
	DrawWalls = true, false, false, false, false, false
	AddFloor RRCeiling1, DropCeiling, 0.5, -20, -90, 5, -70, %RRHeight%, %RRHeight%, 0, 0, false
	AddFloor RRCeiling2, DropCeiling, 0.5, 5, -90, 20, -60, %RRHeight%, %RRHeight%, 0, 0, false
	
	#========================================#

	#Restroom's exterior walls
		#Left and front walls
		WallOrientation = left
		DrawWalls = true, false, false, false, false, false
		#if[%floor% > 3] AddWall RRLeft_Ext, %5%Wall, 0.5, -20, -90, -20, -70, %height%, %height%, 0, 0, 0, 0, false
		if[%floor% = 1] AddWall RRFront_Ext, %5B%Wall, 0.5, -20, -90, 20, -90, %height%, %height%, 0, 0, 0, 0, false
	
		if[%floor% ! 1 & %floor% < 7] AddWall_CustomTex(RRLeft_Ext, 2, %5%Wall2, %5%Wall, Blank, 0.5, -20, -90, -20, -70, 4, %height% - 4, 0, 0, false)
		if[%floor% ! 1 & %floor% < 7] AddWall_CustomTex(RRFront_Ext, 2, %5%Wall2, %5%Wall, Blank, 0.5, -20, -90, 20, -90, 4, %height% - 4, 0, 0, false)
	
		#Right and back walls
		WallOrientation = right
		DrawWalls = false, true, false, false, false, false
		if[%floor% < 2] AddWall RRRight_Ext, %5B%Wall, 0.5, 20, -90, 20, -60, %height%, %height%, 0, 0, 0, 0, false
		if[%floor% = 1] AddWall RRBack_Ext, %5B%Wall, 0.5, 5, -60, 20, -60, %height%, %height%, 0, 0, 0, 0, false
	
		if[%floor% > 1] AddWall_CustomTex(RRRight_Ext, 2, %5%%Infix%Wall2, %5%%Infix%Wall, Blank, 0.5, 20, -90, 20, -60, 4, %height% - 4, 0, 0, false)
