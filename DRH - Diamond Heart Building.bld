#OPD area on the 2nd-6th floors (Including the offices within the area)
<Floors 2 to 6>
	TexPrefix() #Set texture prefix/suffix
	
	#Office area floors/ceilings
	CutAll 20, %interfloorheight% - 0.1, -%2%, %1%, %interfloorheight% + 0.1, -60.5, false, true #Floor cuts
	CutAll -20, %interfloorheight% - 0.1, -%2%, 20, %interfloorheight% + 0.1, -98, false, true

	CutAll 20, %fullheight% - 0.1, -%2%, %1%, %fullheight% + 0.1, -60, false, true #Ceiling cuts
	CutAll -20, %fullheight% - 0.1, -%2%, 20, %fullheight% + 0.1, -98, false, true

