			AddFloor W2Ent_Sensor, W2Ent_SensorUnlit, 0, -59.75 - 0.05, 45 - 0.05, -59.75 + 0.05, 45 + 0.05, 9 - 0.001, 9 - 0.001, 0, 0, false

			AddFloor E1Ent_Sensor, E1Ent_SensorUnlit, 0, 59.75 - 0.05, -15 - 0.05, 59.75 + 0.05, -15 + 0.05, 9 - 0.001, 9 - 0.001, 0, 0, false
			AddFloor E2Ent_Sensor, E2Ent_SensorUnlit, 0, 59.75 - 0.05, 15 - 0.05, 59.75 + 0.05, 15 + 0.05, 9 - 0.001, 9 - 0.001, 0, 0, false
